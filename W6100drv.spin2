rx WRFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVH  ##CSn
  waitx #100
' Load high byte
  DRVH  ##A0 'ADDR bit 0
  DRVH  ##A1 'ADDR bit 1

'  DIRNOT #DATA
