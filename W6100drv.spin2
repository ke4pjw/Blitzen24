CON
  MOD   = 16
  ADDR  = 18 ADDPINS 1
  RSET  = 23
  CSn   = 17
  RDn   = 21
  WRn   = 22
  INTn  = 5
  DATA  = 24 ADDPINS 7
  CLK   = 20
  DPINS = 24 / 8
  A0    = 18
  A1    = 19

' Parallel Bus Symbols
  IDM_ARH = %00
  IDM_ARL = %01
  IDM_BSR = %10
  IDM_DR  = %11

' Block Selection (BS)
  IDM_BSR_Common_Register       = %000_00_000
  IDM_BSR_Socket0_Register      = %000_01_000
  IDM_BSR_Socket0_TX_Buffer     = %000_10_000
  IDM_BSR_Socket0_RX_Buffer     = %000_11_000
  IDM_BSR_Socket1_Register      = %001_01_000
  IDM_BSR_Socket1_TX_Buffer     = %001_10_000
  IDM_BSR_Socket1_RX_Buffer     = %001_11_000
  IDM_BSR_Socket2_Register      = %010_01_000
  IDM_BSR_Socket2_TX_Buffer     = %010_10_000
  IDM_BSR_Socket2_RX_Buffer     = %010_11_000
  IDM_BSR_Socket3_Register      = %011_01_000
  IDM_BSR_Socket3_TX_Buffer     = %011_10_000
  IDM_BSR_Socket3_RX_Buffer     = %011_11_000
  IDM_BSR_Socket4_Register      = %100_01_000
  IDM_BSR_Socket4_TX_Buffer     = %100_10_000
  IDM_BSR_Socket4_RX_Buffer     = %100_11_000
  IDM_BSR_Socket5_Register      = %101_01_000
  IDM_BSR_Socket5_TX_Buffer     = %101_10_000
  IDM_BSR_Socket5_RX_Buffer     = %101_11_000
  IDM_BSR_Socket6_Register      = %110_01_000
  IDM_BSR_Socket6_TX_Buffer     = %110_10_000
  IDM_BSR_Socket6_RX_Buffer     = %110_11_000
  IDM_BSR_Socket7_Register      = %111_01_000
  IDM_BSR_Socket7_TX_Buffer     = %111_10_000
  IDM_BSR_Socket7_RX_Buffer     = %111_11_000

' W6100 Registers
  REG_CIDR0     = $0000
  REG_CIDR1     = $0001
  REG_VER0      = $0002
  REG_VER1      = $0003
  REG_CHPLCKR   = $41F4
  REG_NETLCKR   = $41F5
  REG_PHYLCKR   = $41F6
  REG_SYSR      = $2000
  REG_SHAR0     = $4120
  REG_SHAR1     = $4121
  REG_SHAR2     = $4122
  REG_SHAR3     = $4123
  REG_SHAR4     = $4124
  REG_SHAR5     = $4125
  REG_GAR0      = $4130
  REG_GAR1      = $4131
  REG_GAR2      = $4132
  REG_GAR3      = $4133
  REG_SUBR0     = $4134
  REG_SUBR1     = $4135
  REG_SUBR2     = $4136
  REG_SUBR3     = $4137
  REG_SIPR0     = $4138
  REG_SIPR1     = $4139
  REG_SIPR2     = $413A
  REG_SIPR3     = $413B
  REG_Sn_TX_BSR = $0200
  REG_Sn_RX_BSR = $0220
  REG_Sn_MR     = $0000
  REG_Sn_MR2    = $0144
  REG_Sn_DHAR   = $0118
  REG_Sn_DIPR   = $0120
  REG_Sn_DPORTR = $0140
  REG_Sn_PORTR  = $0114
  REG_Sn_TX_WR   = $020C
  REG_Sn_CR     = $0010
  REG_Sn_SR     = $0030
  REG_Sn_IR     = $0020
  REG_Sn_IRCLR  = $0028
  REG_Sn_RX_RSR = $0224
  REG_Sn_RX_RD  = $0228
  REG_Sn_IMR    = $0024

' Protocol Mode
  PM_SOCKET_Closed   = %0000
  PM_TCP4            = %0001
  PM_UDP4            = %0010
  PM_IPRAW4          = %0011
  PM_MACRAW          = %0111
  PM_TCP6            = %1001
  PM_UDP6            = %1010
  PM_IPRAW6          = %1011
  PM_TCP_Dual        = %1101
  PM_UDP_Dual        = %1110
  PM_M_UDP4          = %1000_0010 'UDP Multicast

' MR2 Options

  MR2_DHAM      = 2 ' Overide Destination MAC Address
  MR2_FARP      = 1 ' Use ARP for destination.

' Interrupt Registers
  Sn_IR_SENDOK  = %0001_0000
  Sn_IR_TIMEOUT = %0000_1000
  Sn_IR_RECV    = %0000_0100
  Sn_IR_DISCON  = %0000_0010
  Sn_IR_CON     = %0000_0001

' Command Registers
  CR_Complete   = $00
  CR_Open       = $01
  CR_LISTEN     = $02
  CR_CONNECT    = $04
  CR_CONNECT6   = $84
  CR_DISCON     = $08
  CR_CLOSE      = $10
  CR_SEND       = $20
  CR_SEND6      = $A0
  CR_SEND_KEEP  = $22
  CR_RECV       = $40

 ' Status Registers
  SOCK_CLOSED       = $00 'SOCKET n closed.
  SOCK_INIT         = $13 'SOCKET n opened in TCP Mode.
  SOCK_LISTEN       = $14 'SOCKET n is in TCP Mode and waits for Connection request.
  SOCK_ESTABLISHED  = $17 'SOCKET n is in TCP Mode and TCP Connection is completed.
  SOCK_CLOSE_WAIT   = $1C 'SOCKET n is in TCP Mode and received FIN Packet.
  SOCK_UDP          = $22 'SOCKET n opened in UDP Mode.
  SOCK_IPRAW        = $32 'SOCKET n opened in IPRAW Mode.
  SOCK_IPRAW6       = $33 'SOCKET n opened in IPRAW6 Mode.
  SOCK_MACRAW       = $42 'SOCKET n opened in MACRAW Mode.
  SOCK_SYNSENT      = $15 'The status of sending Connect-Request.
  SOCK_SYNRECV      = $16 'The status of receiving Connect-Request.
  SOCK_FIN_WAIT     = $18 'The status of closing SOCKET n.
  SOCK_TIME_WAIT    = $1B 'The status of closing SOCKET n.
  SOCK_LAST_ACK     = $1D 'The status of closing SOCKET n.

  '
   SYSR_CHPL    = $CE ' Unlock Chip
   SYSR_NETL    = $C5 ' Lock Net
   SYSR_NETU    = $3A ' Lock Net
   SYSR_PHYL    = $53 ' Unlock PHY Lock Register
VAR
  long  ADDRH
  long  ADDRL
  byte  REGBUFFER[2]
  word  TX_WR
  word  RX_RD
  word  RX_RSR
OBJ
       vid: "p2textdrv"


PUB reset()
  PINL (RSET)
  PINH (WRn)
  PINH (RDn)
  PINH (CSn)
  PINL (CLK)
  PINH (RSET)
  waitms (3000)

PUB setmod010()
  PINH (MOD)

PUB initparallel()
  reset()
  setmod010()
PUB readreg(REGISTER,BS,BLEN,RB) : r | i , LADDRL, LADDRH, tmpdata, tmpptr, datapin

org
' Set the HUB FIFO

 WRFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVL  ##CSn

' Load high byte
  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
    DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVL  ##WRn
  waitx #20
  DRVH  ##WRn

'load low byte

  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVL  ##WRn
  waitx #20
  DRVH  ##WRn

'Set BS
  DRVl  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVL  ##WRn
  waitx #20
  DRVH  ##WRn

  DRVh  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1
  FLTL #DATA

' Read i number of bytes.

label DRVL ##RDn ' Enable Chip Read
      waitx #17 ' Wait cuz this is slow
      altgb datapin,#ina ' Where you gonna get that data?
      getbyte tmpdata ' Get that data and put it in tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      WFBYTE tmpdata
      add RB, #1 ' Increment the read buffer by 1 byte
      DRVH ##RDn ' Disable Chip read
      waitx #2  ' Wait cuz this is slow

      add r,tmpdata  ' Populate return value
      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #label
      shr r,#8
' Disable Chip Select
      DRVH  ##CSn

end
  return r

PUB writereg(REGISTER,BS,BLEN,RB) : r | i , LADDRL ,  LADDRH , datapin , tmpdata

org
' Parse register address
  RDFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVL  ##CSn

' Load high byte
  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
  DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVL  ##WRn
  waitx #10
  DRVH  ##WRn

'load low byte

  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVL  ##WRn
  waitx #10
  DRVH  ##WRn

'Set BS
  DRVl  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVL  ##WRn
  waitx #10
  DRVH  ##WRn

  DRVh  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE tmpdata, RB
label RFBYTE tmpdata
      altsb datapin,#outa ' Where you gonna send that data?
      setbyte tmpdata ' Set that data from tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      DRVL ##WRn ' Disable Chip read
      waitx #5  ' Wait cuz this is slow
      DRVH ##WRn ' Enable Chip Write
      add RB, #1 ' Increment the read buffer by 1 byte
'      add r,tmpdata  ' Populate return value
'      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #label
'      shr r,#8
' Disable Chip Select
      DRVH  ##CSn

end
 {

  LADDRL :=  REGISTER
  LADDRH :=  LADDRL
  LADDRL &= $FF
  LADDRH >>= 8

' Set ADDRH
  PINL(CSn)
  PINWRITE (ADDR , IDM_ARH)
  PINWRITE (DATA , LADDRH)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)

'Set ADDRL
  PINWRITE (ADDR , IDM_ARL)
  PINWRITE (DATA , LADDRL)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)

'Set BS (This is a common register, therefore set byte data to $00)
  PINWRITE (ADDR , IDM_BSR)
  PINWRITE (DATA , BS)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)


'Write Register
  i := 0
  PINWRITE (ADDR , IDM_DR)
  REPEAT BLEN

    PINWRITE (DATA , byte[RB][i])
    i++
    'pintoggle(WRn)
    PINL(WRn)
    PINH(WRn)

  PINH(CSn)
 }
  return

Pub Disconnect(socket)
    'send("Disconnect attempt")


 '   readreg(REG_Sn_IR,IDM_BSR_Socket1_Register,1,@REGBUFFER)
  '  If REGBUFFER[0] <> $1C
    REGBUFFER[0] := CR_DISCON
    writereg(REG_Sn_CR,socket,1,@REGBUFFER)
    repeat until REGBUFFER[0] == 0
        readreg(REG_Sn_CR,socket,1,@REGBUFFER)

    repeat while (REGBUFFER[0] & (Sn_IR_TIMEOUT + Sn_IR_DISCON)) == $00
        readreg(REG_Sn_IR,socket,1,@REGBUFFER)
        'vid.hex(REGBUFFER[0],2)
        'vid.nl()
      if (REGBUFFER[0] & (Sn_IR_TIMEOUT + Sn_IR_DISCON)) == Sn_IR_DISCON
       REGBUFFER[0] := Sn_IR_DISCON
      else
       REGBUFFER[0] := Sn_IR_TIMEOUT
      writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)

    'send("Disconnected")
    'vid.nl()
    ' Gonna try this bullshit right here because I am sure I didn't clear all of the interrupts
    REGBUFFER[0] := $1F
    writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)


pub Open(port,PM,socket)

  readreg(REG_Sn_SR,socket,1,@REGBUFFER)
  'vid.hex(REGBUFFER[0],2)
  'vid.nl()
  repeat until REGBUFFER[0] == SOCK_INIT or REGBUFFER[0] == SOCK_UDP
    REGBUFFER[0] := PM
    writereg(REG_Sn_MR,socket,1,@REGBUFFER)

   ' Set Listening port
    REGBUFFER[0] := port.BYTE[1]
    REGBUFFER[1] := port.BYTE[0]
    writereg(REG_Sn_PORTR,socket,2,@REGBUFFER)

  ' Choose the form of the destructor. (Open the socket)
    REGBUFFER[0] := CR_Open
    writereg(REG_Sn_CR,socket,1,@REGBUFFER)
      repeat until REGBUFFER[0] == 0
         readreg(REG_Sn_CR,socket,1,@REGBUFFER)

    readreg(REG_Sn_SR,socket,1,@REGBUFFER)
    'vid.hex(REGBUFFER[0],2)
    'vid.nl()

pub ListenTCP(socket) : rtv
  REGBUFFER[0] := CR_LISTEN
  writereg(REG_Sn_CR,socket,1,@REGBUFFER)
  readreg(REG_Sn_SR,socket,1,@REGBUFFER)
    repeat until REGBUFFER[0] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER)
  readreg(REG_Sn_SR,socket,1,@REGBUFFER)
  rtv := REGBUFFER[0]

pub EstablishTCP(socket) : rtv
  readreg(REG_Sn_IR,socket,1,@REGBUFFER)
   repeat until (REGBUFFER[0] & Sn_IR_CON) == Sn_IR_CON || (REGBUFFER[0] & Sn_IR_TIMEOUT) == Sn_IR_TIMEOUT
    readreg(REG_Sn_IR,socket,1,@REGBUFFER)
    if (REGBUFFER[0] & Sn_IR_TIMEOUT) == Sn_IR_TIMEOUT
      'Timeout(socket)
      rtv := Sn_IR_TIMEOUT
  REGBUFFER[0] := Sn_IR_CON
  writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)

pub ReceiveData(socket,tmov) : rtv | tmo
    tmo := 0
    RX_RSR := 0
    repeat until RX_RSR > 0 or tmo > tmov
      readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER)
      RX_RSR := REGBUFFER[0]
      RX_RSR <<= 8
      RX_RSR := RX_RSR + REGBUFFER[1]
      tmo++
    if tmo > tmov
       rtv := Sn_IR_TIMEOUT
    'send("TMO: ")
    'vid.dec(tmo)
    'vid.nl()
pub FastReceiveData(socket,tmov) : rtv | tmo , rsr
    rsr := readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER)
    repeat until rsr > 0
        rsr := readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER)

    RX_RSR := rsr

pub FastReceiveProcess(socket,rxptr) : rtv

    RX_RD := readreg(REG_Sn_RX_RD,socket,2,@REGBUFFER)

{
    RX_RD := REGBUFFER[0]
    RX_RD <<= 8
    RX_RD := RX_RD + REGBUFFER[1]
 }

'    send("Read buffer starting at: ")
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    readreg(RX_RD,socket + $10,RX_RSR,rxptr)


'    send("Update RX Buffer Start Address: ")
    RX_RD := RX_RD + RX_RSR
    REGBUFFER[0] := RX_RD.BYTE[1]
    REGBUFFER[1] := RX_RD.BYTE[0]
    writereg(REG_Sn_RX_RD,socket,2,@REGBUFFER)
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    REGBUFFER[1] := CR_RECV
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+1)
    repeat until readreg(REG_Sn_CR,socket,1,@REGBUFFER) == 0

    rtv := RX_RSR

pub ReceiveProcess(socket,rxptr) : rtv

    readreg(REG_Sn_RX_RD,socket,2,@REGBUFFER)
'    send("RX Buffer Start Address: ")
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    RX_RD := REGBUFFER[0]
    RX_RD <<= 8
    RX_RD := RX_RD + REGBUFFER[1]


'    send("Read buffer starting at: ")
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    readreg(RX_RD,socket + $10,RX_RSR,rxptr)


'    send("Update RX Buffer Start Address: ")
    RX_RD := RX_RD + RX_RSR
    REGBUFFER[0] := RX_RD.BYTE[1]
    REGBUFFER[1] := RX_RD.BYTE[0]
    writereg(REG_Sn_RX_RD,socket,2,@REGBUFFER)
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    REGBUFFER[1] := CR_RECV
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+1)
    repeat until REGBUFFER[0] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER)
    rtv := RX_RSR

pub SendData(socket,sendptr,ptrlen) : rtv | i
    readreg(REG_Sn_TX_WR,socket,2,@REGBUFFER)
    'send("TX Buffer Start Address: ")
    'vid.hex(REGBUFFER[0],2)
    'vid.hex(REGBUFFER[1],2)
    'vid.nl()
    TX_WR := REGBUFFER[0]
    TX_WR <<= 8
    TX_WR := TX_WR + REGBUFFER[1]

   ' bytemove(@WRITEBUFFER,sendptr,strsize(sendptr))

    'send("Write Webpage request to TX Buffer")
    'vid.nl()
   { i:=0
    repeat strsize(@WRITEBUFFER)
      'send(WRITEBUFFER[i])
      i++
    }
    writereg(TX_WR,socket + $08,ptrlen,sendptr)
    'vid.nl()


    'send("Update TX Buffer Start Address: ")
'    TX_WR := TX_WR + strsize(@WRITEBUFFER)
    TX_WR := TX_WR + ptrlen
    REGBUFFER[0] := TX_WR.BYTE[1]
    REGBUFFER[1] := TX_WR.BYTE[0]
    'vid.hex(REGBUFFER[0],2)
    'vid.hex(REGBUFFER[1],2)
    'vid.hex(TX_WR,4)
    'vid.nl()
    writereg(REG_Sn_TX_WR,socket,2,@REGBUFFER)
 {
    readreg(REG_Sn_IR,socket,1,@READBUFFER)
    'send("Checking Sn_IR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()

    readreg(REG_Sn_CR,socket,1,@READBUFFER)
    'send("Checking Sn_CR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()

    readreg(REG_Sn_MR,socket,1,@READBUFFER)
    'send("Checking Sn_MR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()
  }
    'send("Sending Webpage")
    'vid.nl()
    REGBUFFER[0] := CR_SEND
    writereg(REG_Sn_CR,socket,1,@REGBUFFER)
    repeat until REGBUFFER[0] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER)
    repeat while (REGBUFFER[0] & $18) == $00
       readreg(REG_Sn_IMR,socket,1,@REGBUFFER)

    if (REGBUFFER[0] & $18) == $10
         REGBUFFER[0] := $10
         writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)
    'send("Webpage Sent")
    'vid.nl()



pub Timeout()

PUB hex(value, digits)
' Print a hexadecimal number
  value <<= (8 - digits) << 2
  repeat digits
    value ROL= 4
    send(lookupz(value & $F : "0".."9", "A".."F"))
PUB nl()
 send( $0D, $0A)