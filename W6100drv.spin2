  altsb datapin, #outa
  setbyte BS

  DRVH  ##WRn
  waitx #50
  DRVL  ##WRn

  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE tmpdata, RB
txloop RFBYTE tmpdata
       waitx #50
       altsb datapin,#outa ' Where you gonna send that data?
       setbyte tmpdata ' Set that data from tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
       DRVH ##WRn ' Disable Chip read
       waitx #50  ' Wait cuz this is slow
       DRVL ##WRn ' Enable Chip Write
       add RB, #1 ' Increment the read buffer by 1 byte
'      add r,tmpdata  ' Populate return value
'      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
       CMP i,RB wz
if_nz  jmp #txloop
'      shr r,#8
' Disable Chip Select
       DRVL  ##CSn

'      FLTL ##A0
'      FLTL ##A1
'      FLTL ##WRn
'      FLTL ##RDn
    '  FLTL ##CSn
