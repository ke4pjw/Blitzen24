CON

  DOWNLOAD_BAUD = 2_000_000
  DEBUG_BAUD = DOWNLOAD_BAUD

  MOD   = 16
  ADDR  = 18 ADDPINS 1
  RSET  = 23
  CSn   = 17
  RDn   = 21
  WRn   = 22
  INTn  = 5
  DATA  = 24 ADDPINS 7
  CLK   = 20
  DPINS = 24 / 8
  A0    = 18
  A1    = 19

  LED1  = 56
  LED2  = 57

' Parallel Bus Symbols
  IDM_ARH = %00
  IDM_ARL = %01
  IDM_BSR = %10
  IDM_DR  = %11

' Block Selection (BS)
  IDM_BSR_Common_Register       = %000_00_000
  IDM_BSR_Socket0_Register      = %000_01_000
  IDM_BSR_Socket0_TX_Buffer     = %000_10_000
  IDM_BSR_Socket0_RX_Buffer     = %000_11_000
  IDM_BSR_Socket1_Register      = %001_01_000
  IDM_BSR_Socket1_TX_Buffer     = %001_10_000
  IDM_BSR_Socket1_RX_Buffer     = %001_11_000
  IDM_BSR_Socket2_Register      = %010_01_000
  IDM_BSR_Socket2_TX_Buffer     = %010_10_000
  IDM_BSR_Socket2_RX_Buffer     = %010_11_000
  IDM_BSR_Socket3_Register      = %011_01_000
  IDM_BSR_Socket3_TX_Buffer     = %011_10_000
  IDM_BSR_Socket3_RX_Buffer     = %011_11_000
  IDM_BSR_Socket4_Register      = %100_01_000
  IDM_BSR_Socket4_TX_Buffer     = %100_10_000
  IDM_BSR_Socket4_RX_Buffer     = %100_11_000
  IDM_BSR_Socket5_Register      = %101_01_000
  IDM_BSR_Socket5_TX_Buffer     = %101_10_000
  IDM_BSR_Socket5_RX_Buffer     = %101_11_000
  IDM_BSR_Socket6_Register      = %110_01_000
  IDM_BSR_Socket6_TX_Buffer     = %110_10_000
  IDM_BSR_Socket6_RX_Buffer     = %110_11_000
  IDM_BSR_Socket7_Register      = %111_01_000
  IDM_BSR_Socket7_TX_Buffer     = %111_10_000
  IDM_BSR_Socket7_RX_Buffer     = %111_11_000

' W6100 Registers
  REG_CIDR0     = $0000
  REG_CIDR1     = $0001
  REG_VER0      = $0002
  REG_VER1      = $0003
  REG_CHPLCKR   = $41F4
  REG_NETLCKR   = $41F5
  REG_PHYLCKR   = $41F6
  REG_SYSR      = $2000
  REG_SHAR0     = $4120
  REG_SHAR1     = $4121
  REG_SHAR2     = $4122
  REG_SHAR3     = $4123
  REG_SHAR4     = $4124
  REG_SHAR5     = $4125
  REG_GAR0      = $4130
  REG_GAR1      = $4131
  REG_GAR2      = $4132
  REG_GAR3      = $4133
  REG_SUBR0     = $4134
  REG_SUBR1     = $4135
  REG_SUBR2     = $4136
  REG_SUBR3     = $4137
  REG_SIPR0     = $4138
  REG_SIPR1     = $4139
  REG_SIPR2     = $413A
  REG_SIPR3     = $413B
  REG_Sn_TX_BSR = $0200
  REG_Sn_RX_BSR = $0220
  REG_Sn_MR     = $0000
  REG_Sn_MR2    = $0144
  REG_Sn_DHAR   = $0118
  REG_Sn_DIPR   = $0120
  REG_Sn_DPORTR = $0140
  REG_Sn_PORTR  = $0114
  REG_Sn_TX_WR   = $020C
  REG_Sn_CR     = $0010
  REG_Sn_SR     = $0030
  REG_Sn_IR     = $0020
  REG_Sn_IRCLR  = $0028
  REG_Sn_RX_RSR = $0224
  REG_Sn_RX_RD  = $0228
  REG_Sn_IMR    = $0024
  REG_SIMR      = $2114

' Protocol Mode
  PM_SOCKET_Closed   = %0000
  PM_TCP4            = %0001
  PM_UDP4            = %0010
  PM_IPRAW4          = %0011
  PM_MACRAW          = %0111
  PM_TCP6            = %1001
  PM_UDP6            = %1010
  PM_IPRAW6          = %1011
  PM_TCP_Dual        = %1101
  PM_UDP_Dual        = %1110
  PM_M_UDP4          = %1000_0010 'UDP Multicast

' MR2 Options

  MR2_DHAM      = 2 ' Overide Destination MAC Address
  MR2_FARP      = 1 ' Use ARP for destination.

' Interrupt Registers
  Sn_IR_SENDOK  = %0001_0000
  Sn_IR_TIMEOUT = %0000_1000
  Sn_IR_RECV    = %0000_0100
  Sn_IR_DISCON  = %0000_0010
  Sn_IR_CON     = %0000_0001

' Command Registers
  CR_Complete   = $00
  CR_Open       = $01
  CR_LISTEN     = $02
  CR_CONNECT    = $04
  CR_CONNECT6   = $84
  CR_DISCON     = $08
  CR_CLOSE      = $10
  CR_SEND       = $20
  CR_SEND6      = $A0
  CR_SEND_KEEP  = $22
  CR_RECV       = $40

 ' Status Registers
  SOCK_CLOSED       = $00 'SOCKET n closed.
  SOCK_INIT         = $13 'SOCKET n opened in TCP Mode.
  SOCK_LISTEN       = $14 'SOCKET n is in TCP Mode and waits for Connection request.
  SOCK_ESTABLISHED  = $17 'SOCKET n is in TCP Mode and TCP Connection is completed.
  SOCK_CLOSE_WAIT   = $1C 'SOCKET n is in TCP Mode and received FIN Packet.
  SOCK_UDP          = $22 'SOCKET n opened in UDP Mode.
  SOCK_IPRAW        = $32 'SOCKET n opened in IPRAW Mode.
  SOCK_IPRAW6       = $33 'SOCKET n opened in IPRAW6 Mode.
  SOCK_MACRAW       = $42 'SOCKET n opened in MACRAW Mode.
  SOCK_SYNSENT      = $15 'The status of sending Connect-Request.
  SOCK_SYNRECV      = $16 'The status of receiving Connect-Request.
  SOCK_FIN_WAIT     = $18 'The status of closing SOCKET n.
  SOCK_TIME_WAIT    = $1B 'The status of closing SOCKET n.
  SOCK_LAST_ACK     = $1D 'The status of closing SOCKET n.

  '
   SYSR_CHPL    = $CE ' Unlock Chip
   SYSR_NETL    = $C5 ' Lock Net
   SYSR_NETU    = $3A ' Lock Net
   SYSR_PHYL    = $53 ' Unlock PHY Lock Register
VAR
  long E131Socket
  long E131PACKETBUFFER
  long E131TXBUFFER
  long  ADDRH
  long  ADDRL
  byte  REGBUFFER[2]
  word  TX_WR
  word  RX_RD
  word  RX_RSR




OBJ
       vid: "p2textdrv"


PUB reset()
  PINL (RSET)
  PINH (WRn)
  PINH (RDn)
  PINH (CSn)
  PINL (CLK)
  PINH (RSET)
  waitms (3000)

PUB setmod010()
  PINH (MOD)

PUB initparallel()
  reset()
  setmod010()
PUB readreg(REGISTER,BS,BLEN,RB) : r | i , LADDRL, LADDRH, tmpdata, tmpptr, datapin

org
' Set the HUB FIFO

 WRFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVL  ##CSn

' Load high byte
  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
    DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVL  ##WRn
  waitx #20
  DRVH  ##WRn

'load low byte

  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVL  ##WRn
  waitx #20
  DRVH  ##WRn

'Set BS
  DRVl  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVL  ##WRn
  waitx #20
  DRVH  ##WRn

  DRVh  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1
  FLTL #DATA

' Read i number of bytes.

label DRVL ##RDn ' Enable Chip Read
      waitx #17 ' Wait cuz this is slow
      altgb datapin,#ina ' Where you gonna get that data?
      getbyte tmpdata ' Get that data and put it in tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      WFBYTE tmpdata
      add RB, #1 ' Increment the read buffer by 1 byte
      DRVH ##RDn ' Disable Chip read
      waitx #2  ' Wait cuz this is slow

      add r,tmpdata  ' Populate return value
      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #label
      shr r,#8
' Disable Chip Select
      DRVH  ##CSn

end
  return r

PUB writereg(REGISTER,BS,BLEN,RB) : r | i , LADDRL ,  LADDRH , datapin , tmpdata

org
' Parse register address
  RDFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVL  ##CSn

' Load high byte
  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
  DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVL  ##WRn
  waitx #10
  DRVH  ##WRn

'load low byte

  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVL  ##WRn
  waitx #10
  DRVH  ##WRn

'Set BS
  DRVl  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVL  ##WRn
  waitx #10
  DRVH  ##WRn

  DRVh  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE tmpdata, RB
label RFBYTE tmpdata
      altsb datapin,#outa ' Where you gonna send that data?
      setbyte tmpdata ' Set that data from tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      DRVL ##WRn ' Disable Chip read
      waitx #5  ' Wait cuz this is slow
      DRVH ##WRn ' Enable Chip Write
      add RB, #1 ' Increment the read buffer by 1 byte
'      add r,tmpdata  ' Populate return value
'      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #label
'      shr r,#8
' Disable Chip Select
      DRVH  ##CSn

end
 {

  LADDRL :=  REGISTER
  LADDRH :=  LADDRL
  LADDRL &= $FF
  LADDRH >>= 8

' Set ADDRH
  PINL(CSn)
  PINWRITE (ADDR , IDM_ARH)
  PINWRITE (DATA , LADDRH)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)

'Set ADDRL
  PINWRITE (ADDR , IDM_ARL)
  PINWRITE (DATA , LADDRL)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)

'Set BS (This is a common register, therefore set byte data to $00)
  PINWRITE (ADDR , IDM_BSR)
  PINWRITE (DATA , BS)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)


'Write Register
  i := 0
  PINWRITE (ADDR , IDM_DR)
  REPEAT BLEN

    PINWRITE (DATA , byte[RB][i])
    i++
    'pintoggle(WRn)
    PINL(WRn)
    PINH(WRn)

  PINH(CSn)
 }
  return

Pub Disconnect(socket)
    'send("Disconnect attempt")


 '   readreg(REG_Sn_IR,IDM_BSR_Socket1_Register,1,@REGBUFFER)
  '  If REGBUFFER[0] <> $1C
    REGBUFFER[0] := CR_DISCON
    writereg(REG_Sn_CR,socket,1,@REGBUFFER)
    repeat until REGBUFFER[0] == 0
        readreg(REG_Sn_CR,socket,1,@REGBUFFER)

    repeat while (REGBUFFER[0] & (Sn_IR_TIMEOUT + Sn_IR_DISCON)) == $00
        readreg(REG_Sn_IR,socket,1,@REGBUFFER)
        'vid.hex(REGBUFFER[0],2)
        'vid.nl()
      if (REGBUFFER[0] & (Sn_IR_TIMEOUT + Sn_IR_DISCON)) == Sn_IR_DISCON
       REGBUFFER[0] := Sn_IR_DISCON
      else
       REGBUFFER[0] := Sn_IR_TIMEOUT
      writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)

    'send("Disconnected")
    'vid.nl()
    ' Gonna try this bullshit right here because I am sure I didn't clear all of the interrupts
    REGBUFFER[0] := $1F
    writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)


pub Open(port,PM,socket)

  readreg(REG_Sn_SR,socket,1,@REGBUFFER)
  'vid.hex(REGBUFFER[0],2)
  'vid.nl()
  repeat until REGBUFFER[0] == SOCK_INIT or REGBUFFER[0] == SOCK_UDP
    REGBUFFER[0] := PM
    writereg(REG_Sn_MR,socket,1,@REGBUFFER)

   ' Set Listening port
    REGBUFFER[0] := port.BYTE[1]
    REGBUFFER[1] := port.BYTE[0]
    writereg(REG_Sn_PORTR,socket,2,@REGBUFFER)

  ' Choose the form of the destructor. (Open the socket)
    REGBUFFER[0] := CR_Open
    writereg(REG_Sn_CR,socket,1,@REGBUFFER)
      repeat until REGBUFFER[0] == 0
         readreg(REG_Sn_CR,socket,1,@REGBUFFER)

    readreg(REG_Sn_SR,socket,1,@REGBUFFER)
    'vid.hex(REGBUFFER[0],2)
    'vid.nl()

pub ListenTCP(socket) : rtv
  REGBUFFER[0] := CR_LISTEN
  writereg(REG_Sn_CR,socket,1,@REGBUFFER)
  readreg(REG_Sn_SR,socket,1,@REGBUFFER)
    repeat until REGBUFFER[0] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER)
  readreg(REG_Sn_SR,socket,1,@REGBUFFER)
  rtv := REGBUFFER[0]

pub EstablishTCP(socket) : rtv
  readreg(REG_Sn_IR,socket,1,@REGBUFFER)
   repeat until (REGBUFFER[0] & Sn_IR_CON) == Sn_IR_CON || (REGBUFFER[0] & Sn_IR_TIMEOUT) == Sn_IR_TIMEOUT
    readreg(REG_Sn_IR,socket,1,@REGBUFFER)
    if (REGBUFFER[0] & Sn_IR_TIMEOUT) == Sn_IR_TIMEOUT
      'Timeout(socket)
      rtv := Sn_IR_TIMEOUT
  REGBUFFER[0] := Sn_IR_CON
  writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)

pub ReceiveData(socket,tmov) : rtv | tmo
    tmo := 0
    RX_RSR := 0
    repeat until RX_RSR > 0 or tmo > tmov
      readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER)
      RX_RSR := REGBUFFER[0]
      RX_RSR <<= 8
      RX_RSR := RX_RSR + REGBUFFER[1]
      tmo++
    if tmo > tmov
       rtv := Sn_IR_TIMEOUT
    'send("TMO: ")
    'vid.dec(tmo)
    'vid.nl()
pub FastReceiveData(socket,tmov) : rtv | tmo , rsr
    rsr := readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER)
    repeat until rsr > 0
        rsr := readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER)

    RX_RSR := rsr

pub FastReceiveProcess(socket,rxptr,REGBUFFERTMP) |  i , LADDRL, LADDRH, tmpdata, RB, datapin, REGISTER, BLEN, BS, socket_rd, l_RX_RSR, l_RX_RD, r

{    RX_RD := readreg(REG_Sn_RX_RD,socket,2,@REGBUFFER)

{
    RX_RD := REGBUFFER[0]
    RX_RD <<= 8
    RX_RD := RX_RD + REGBUFFER[1]
 }

'    send("Read buffer starting at: ")
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    readreg(RX_RD,socket + $10,RX_RSR,rxptr)


'    send("Update RX Buffer Start Address: ")
    RX_RD := RX_RD + RX_RSR
    REGBUFFER[0] := RX_RD.BYTE[1]
    REGBUFFER[1] := RX_RD.BYTE[0]
    writereg(REG_Sn_RX_RD,socket,2,@REGBUFFER)
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    REGBUFFER[1] := CR_RECV
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+1)
    repeat until readreg(REG_Sn_CR,socket,1,@REGBUFFER) == 0

'    rtv := RX_RSR   }
org
      mov BS, socket
      mov socket_rd, socket 'Setup the socket rd register
      add socket_rd, #$10   ' It is the value of the socket register + $10
'      mov REGBUFFERTMP, #0
'      SETINT1 #start






' Find if there are any bytes in the rx buffer (RX_RSR)
start mov REGISTER, ##REG_Sn_RX_RSR
      debug(uhex(REGISTER))
      mov BLEN, #2 ' get two bytes
      debug(uhex(BLEN))
      mov RB, REGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      debug(uhex(RB))
      call #rx
      debug(uhex(r))
hstop jmp #hstop

      cmp r, #0 wz  ' r is what is returned from rx. rx returns the last two bytes as a word.
if_z  jmp #start ' If r is empty, go fish.
      mov l_RX_RSR, r

' Check it again to be sure
      mov REGISTER, ##REG_Sn_RX_RSR
      mov BLEN, #2 ' get two bytes
      mov RB, REGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #rx
      cmp r, l_RX_RSR wz  ' r is what is returned from rx. rx returns the last two bytes as a word.
if_nz  jmp #start ' If r is not the same as l_RX_RSR, go fish.




' Find the rx buffer address to start reading bytes (RX_RD)
      mov REGISTER, ##REG_Sn_RX_RD
      mov BLEN, #2 ' get two bytes
      mov RB, REGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #rx
      mov l_RX_RD, r ' r is what is returned from rx. rx returns the last two bytes as a word.
{
' Not 638 bytes
      CMP l_RX_RSR, ##$0286 wz
      if_nz WRWORD l_RX_RSR,REGBUFFERTMP
      if_nz jmp #skipit
}
' Read the buffer into hub ram
      mov REGISTER, l_RX_RD
      mov BS, socket_rd
      mov BLEN, l_RX_RSR
      mov RB, rxptr ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #rx


' Write the new RX address
 '     and l_RX_RSR, ##$FFFF
 skipit

      mov BS, socket
      add l_RX_RSR,l_RX_RD 'Determine new RX address

      movbyts   l_RX_RSR, #%%2301
      WRWORD l_RX_RSR,REGBUFFERTMP
'      add REGBUFFERTMP, #1
'      movbyts   l_RX_RSR, #%%3210
'      WRBYTE l_RX_RSR, REGBUFFERTMP
      mov REGISTER, ##REG_Sn_RX_RD
      mov BLEN, #2 ' get two bytes
'      sub REGBUFFERTMP, #1
      mov RB, REGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #tx



      WRBYTE ##CR_RECV, REGBUFFERTMP
      mov REGISTER, ##REG_Sn_CR
      mov BLEN, #1
      mov RB, REGBUFFERTMP
      call #tx

      WRBYTE $FF, REGBUFFERTMP
      mov REGISTER, ##REG_Sn_IRCLR
      mov BLEN, #1
      mov RB, REGBUFFERTMP
      call #tx




      jmp #start


' readreg(REGISTER,BS,BLEN,RB) : r | i , LADDRL, LADDRH, tmpdata, tmpptr, datapin,

rx WRFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVL  ##CSn

' Load high byte
  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
  DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH
  debug(uhex(LADDRH))

  DRVL  ##WRn
  waitx #50
  DRVH  ##WRn

'load low byte

  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL
  debug(uhex(LADDRL))

  DRVL  ##WRn
  waitx #50
  DRVH  ##WRn

'Set BS
  DRVl  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS
  debug(uhex(BS))

  DRVL  ##WRn
  waitx #50
  DRVH  ##WRn

  DRVh  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1
  FLTL #DATA
  debug(uhex(#DATA))
' Read i number of bytes.

rxloop DRVL ##RDn ' Enable Chip Read
      debug(uhex(DIRA))
      waitx #50 ' Wait cuz this is slow
      altgb datapin,#ina ' Where you gonna get that data?
      getbyte tmpdata ' Get that data and put it in tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      debug(uhex(tmpdata))
      WFBYTE tmpdata
      add RB, #1 ' Increment the read buffer by 1 byte
      DRVH ##RDn ' Disable Chip read
      waitx #50  ' Wait cuz this is slow

      add r,tmpdata  ' Populate return value
      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #rxloop
      shr r,#8
' Disable Chip Select
      DRVH  ##CSn
      ret

 ' Parse register address
tx  RDFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVL  ##CSn

' Load high byte
  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
  DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVL  ##WRn
  waitx #50
  DRVH  ##WRn

'load low byte

  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVL  ##WRn
  waitx #50
  DRVH  ##WRn

'Set BS
  DRVl  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVL  ##WRn
  waitx #50
  DRVH  ##WRn

  DRVh  ##A0 'ADDR bit 0
  DRVh  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE tmpdata, RB
txloop RFBYTE tmpdata
       waitx #50
       altsb datapin,#outa ' Where you gonna send that data?
       setbyte tmpdata ' Set that data from tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
       DRVL ##WRn ' Disable Chip read
       waitx #50  ' Wait cuz this is slow
       DRVH ##WRn ' Enable Chip Write
       add RB, #1 ' Increment the read buffer by 1 byte
'      add r,tmpdata  ' Populate return value
'      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
       CMP i,RB wz
if_nz  jmp #txloop
'      shr r,#8
' Disable Chip Select
       DRVH  ##CSn
       ret
exit  nop
end

pub ReceiveProcess(socket,rxptr) : rtv

    readreg(REG_Sn_RX_RD,socket,2,@REGBUFFER)
'    send("RX Buffer Start Address: ")
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    RX_RD := REGBUFFER[0]
    RX_RD <<= 8
    RX_RD := RX_RD + REGBUFFER[1]


'    send("Read buffer starting at: ")
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    readreg(RX_RD,socket + $10,RX_RSR,rxptr)


'    send("Update RX Buffer Start Address: ")
    RX_RD := RX_RD + RX_RSR
    REGBUFFER[0] := RX_RD.BYTE[1]
    REGBUFFER[1] := RX_RD.BYTE[0]
    writereg(REG_Sn_RX_RD,socket,2,@REGBUFFER)
'    hex(REGBUFFER[0],2)
'    hex(REGBUFFER[1],2)
'    nl()
    REGBUFFER[1] := CR_RECV
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+1)
    repeat until REGBUFFER[0] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER)
    rtv := RX_RSR

pub SendData(socket,sendptr,ptrlen) : rtv | i
    readreg(REG_Sn_TX_WR,socket,2,@REGBUFFER)
    'send("TX Buffer Start Address: ")
    'vid.hex(REGBUFFER[0],2)
    'vid.hex(REGBUFFER[1],2)
    'vid.nl()
    TX_WR := REGBUFFER[0]
    TX_WR <<= 8
    TX_WR := TX_WR + REGBUFFER[1]

   ' bytemove(@WRITEBUFFER,sendptr,strsize(sendptr))

    'send("Write Webpage request to TX Buffer")
    'vid.nl()
   { i:=0
    repeat strsize(@WRITEBUFFER)
      'send(WRITEBUFFER[i])
      i++
    }
    writereg(TX_WR,socket + $08,ptrlen,sendptr)
    'vid.nl()


    'send("Update TX Buffer Start Address: ")
'    TX_WR := TX_WR + strsize(@WRITEBUFFER)
    TX_WR := TX_WR + ptrlen
    REGBUFFER[0] := TX_WR.BYTE[1]
    REGBUFFER[1] := TX_WR.BYTE[0]
    'vid.hex(REGBUFFER[0],2)
    'vid.hex(REGBUFFER[1],2)
    'vid.hex(TX_WR,4)
    'vid.nl()
    writereg(REG_Sn_TX_WR,socket,2,@REGBUFFER)
 {
    readreg(REG_Sn_IR,socket,1,@READBUFFER)
    'send("Checking Sn_IR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()

    readreg(REG_Sn_CR,socket,1,@READBUFFER)
    'send("Checking Sn_CR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()

    readreg(REG_Sn_MR,socket,1,@READBUFFER)
    'send("Checking Sn_MR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()
  }
    'send("Sending Webpage")
    'vid.nl()
    REGBUFFER[0] := CR_SEND
    writereg(REG_Sn_CR,socket,1,@REGBUFFER)
    repeat until REGBUFFER[0] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER)
    repeat while (REGBUFFER[0] & $18) == $00
       readreg(REG_Sn_IMR,socket,1,@REGBUFFER)

    if (REGBUFFER[0] & $18) == $10
         REGBUFFER[0] := $10
         writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER)
    'send("Webpage Sent")
    'vid.nl()



pub Timeout()

PUB hex(value, digits)
' Print a hexadecimal number
  value <<= (8 - digits) << 2
  repeat digits
    value ROL= 4
    send(lookupz(value & $F : "0".."9", "A".."F"))
PUB nl()
 send( $0D, $0A)
PUB startfastrx(skt,pbf,txb,e131ptr) : e131cog
    longmove(@E131Socket, @skt, 4)
'    hex(E131PACKETBUFFER,8)
org
debug(uhex(DIRA))
FLTL ##CSn
FLTL ##A0
FLTL ##A1
FLTL ##WRn
FLTL ##RDn
debug(uhex(DIRA))

end
    e131cog := coginit(COGEXEC_NEW, @cogx, @E131Socket)  + 1

    return

DAT
        org   0

cogx
      DRVH ##WRn
      DRVH ##RDn
      DRVH ##CSn
      DRVL ##CLK
      DRVH ##RSET
      DRVH ##MOD
' Populate config
      setq      #4-1
      rdlong    lsocket, ptra
' Populate E131 config in LUT
      setq2     #432-1
      rdlong   ($200-$200), E131CONFIGPTR


'      mov l_BS, l_socket
'      mov l_socket_rd, l_socket 'Setup the l_socket rd register
'      add l_socket_rd, #$10   ' It is the value of the l_socket register + $10
'pub FastReceiveProcess(socket,lrxptr,lREGBUFFERTMP) |  i , lLADDRL, lLADDRH, ltmpdata, lRB, ldatapin, lREGISTER, lBLEN, lBS, socket_rd, ll_RX_RSR, ll_RX_RD, lr


      mov lBS, lsocket
      mov lsocket_rd, lsocket 'Setup the lsocket rd register
      add lsocket_rd, #$10   ' It is the value of the lsocket register + $10
'      mov lREGBUFFERTMP, #0
'      SETINT1 #lstart






' Find if there are any bytes in the rx buffer (RX_RSR)
lstart mov lREGISTER, ##REG_Sn_RX_RSR

      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
'      debug(uhex(lREGISTER))
'      debug(uhex(lBLEN))
'      debug(uhex(lRB))
      call #lrx
'      debug(uhex(lr))
'stop  nop
'      jmp #stop
      cmp lr, #0 wz  ' lr is what is returned from rx. rx returns the last two bytes as a word.
if_z  jmp #lstart ' If r is empty, go fish.
      mov ll_RX_RSR, lr

' Check it again to be sure
      mov lREGISTER, ##REG_Sn_RX_RSR
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #lrx
      cmp lr, ll_RX_RSR wz  ' lr is what is returned from rx. rx returns the last two bytes as a word.
if_nz  jmp #lstart ' If lr is not the same as ll_RX_RSR, go fish.




' Find the rx buffer address to start reading bytes (RX_RD)
      mov lREGISTER, ##REG_Sn_RX_RD
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #lrx
      mov ll_RX_RD, lr ' lr is what is returned from rx. rx returns the last two bytes as a word.

' Get the E1.31 Universe from the packet
      mov E131ADDR, #121 ' Univrse is patcket is two bytes at addr 121
      add E131ADDR, ll_RX_RD
      mov lREGISTER, E131ADDR
      mov lBS, lsocket_rd
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #lrx
'      debug(uhex(E131ADDR))
'      debug(uhex(lr))
      mov tE131ADDR, lr '

' Enumerate the lookup table for this universe, if not found, skip pulling this data and clear the W6100 buffer.
      mov   E131ENUM, #1
      mov   pixlen, #0
e131lutenum
      RDLUT tE131ENUM, E131ENUM  wz
if_z  jmp #lskipit
      CMP tE131ENUM, tE131ADDR wz
if_nz ADD E131ENUM, #4
if_nz jmp #e131lutenum
      ADD E131ENUM, #1
      RDLUT tpixlen,E131ENUM
      ADD E131ENUM, #1
      RDLUT lrxptr, E131ENUM
'      REP     1, 3
      ADD  pixlen, tpixlen
      ADD  pixlen, tpixlen
      ADD  pixlen, tpixlen
'      debug(uhex(tE131ENUM))
'      debug(uhex(pixlen))

'      CMP tE131ADDR, #6 wz
'if_nz jmp #lskipit

' Read the buffer buffer into hub ram
      mov lREGISTER, ll_RX_RD
      add lREGISTER, #134 'Constant where E131 data starts + RX_RD value
      mov lBS, lsocket_rd
'      mov lBLEN, ll_RX_RSR
      mov lBLEN, pixlen  ' Number of bytes
      mov lRB, lrxptr ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #lrx


' Write the new RX address
 '     and ll_RX_RSR, ##$FFFF
 lskipit

      mov lBS, lsocket
      add ll_RX_RSR,ll_RX_RD 'Determine new RX address

      movbyts   ll_RX_RSR, #%%2301
      WRWORD ll_RX_RSR,lREGBUFFERTMP
'      add lREGBUFFERTMP, #1
'      movbyts   ll_RX_RSR, #%%3210
'      WRBYTE ll_RX_RSR, lREGBUFFERTMP
      mov lREGISTER, ##REG_Sn_RX_RD
      mov lBLEN, #2 ' get two bytes
'      sub lREGBUFFERTMP, #1
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER is $00 later on.
      call #ltx


' Clear RX status and Interrupt

      WRBYTE ##CR_RECV, lREGBUFFERTMP
      mov lREGISTER, ##REG_Sn_CR
      mov lBLEN, #1
      mov lRB, lREGBUFFERTMP
      call #ltx

      WRBYTE $FF, lREGBUFFERTMP
      mov lREGISTER, ##REG_Sn_IRCLR
      mov lBLEN, #1
      mov lRB, lREGBUFFERTMP
      call #ltx




      jmp #lstart


' readreg(lREGISTER,lBS,lBLEN,lRB) : lr | i , lLADDRL, lLADDRH, ltmpdata, tmpptr, ldatapin,

lrx   WRFAST #0,lRB

' Clear the return value
      mov lr,#0

' Parse register address
      mov lLADDRL, lREGISTER
      mov lLADDRH, lREGISTER
      and lLADDRL, #$FF
      shr lLADDRH, #8

' Set the data pins
      mov ldatapin, #dpins

' Setup the byte ingest counter
      mov li,#0
      add li,lBLEN
      add li,lRB

' Enable Chip Select on the W6100
      DRVL  ##CSn

' Load high byte
      DRVL  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
      DRVL #DATA
      altsb ldatapin, #outa
      setbyte lLADDRH
'      debug(uhex(lLADDRH))

      DRVL  ##WRn
      waitx #50
      DRVH  ##WRn

'load low byte

      DRVH  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lLADDRL
'      debug(uhex(lLADDRL))
      DRVL  ##WRn
      waitx #50
      DRVH  ##WRn

'Set lBS
      DRVL  ##A0 'ADDR bit 0
      DRVH  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lBS
'      debug(uhex(lBS))

      DRVL  ##WRn
      waitx #50
      DRVH  ##WRn

      DRVh  ##A0 'ADDR bit 0
      DRVh  ##A1 'ADDR bit 1
      FLTL  #DATA
'      debug(uhex(#DATA ))
' Read i number of bytes.
      waitx #50
lrxloop DRVL ##RDn ' Enable Chip Read
'      debug(uhex(DIRA))
      waitx #50 ' Wait cuz this is slow
'      debug(uhex(ldatapin))
      altgb ldatapin, #ina ' Where you gonna get that data?
      getbyte ltmpdata ' Get that data and put it in ltmpdata
'      debug(uhex(ltmpdata))
'      WRBYTE ltmpdata, RB ' Write that data to the read buffer in HUBRAM.
      WFBYTE ltmpdata
      add lRB, #1 ' Increment the read buffer by 1 byte
      DRVH ##RDn ' Disable Chip read
      waitx #50  ' Wait cuz this is slow

      add lr,ltmpdata  ' Populate return value
      shl lr,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP li,lRB wz
if_nz jmp #lrxloop
      shr lr,#8
' Disable Chip Select
      DRVH  ##CSn
      ret

 ' Parse register address
ltx  RDFAST #0,lRB

' Clear the return value
      mov lr,#0

' Parse register address
      mov lLADDRL, lREGISTER
      mov lLADDRH, lREGISTER
      and lLADDRL, #$FF
      shr lLADDRH, #8

' Set the data pins
      mov ldatapin, #dpins

' Setup the byte ingest counter
      mov li,#0
      add li,lBLEN
      add li,lRB

' Enable Chip Select on the W6100
      DRVL  ##CSn

' Load high byte
      DRVL  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1

'  DIRNOT #DATA
      DRVL #DATA

      altsb ldatapin, #outa
      setbyte lLADDRH

      DRVL  ##WRn
      waitx #50
      DRVH  ##WRn

'load low byte

      DRVH  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lLADDRL

      DRVL  ##WRn
      waitx #50
      DRVH  ##WRn

'Set lBS
      DRVl  ##A0 'ADDR bit 0
      DRVh  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lBS

      DRVL  ##WRn
      waitx #50
      DRVH  ##WRn

      DRVh  ##A0 'ADDR bit 0
      DRVh  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE ltmpdata, lRB
ltxloop RFBYTE ltmpdata
       waitx #50
       altsb ldatapin,#outa ' Where you gonna send that data?
       setbyte ltmpdata ' Set that data from ltmpdata
'      WRBYTE ltmpdata, lRB ' Write that data to the read buffer in HUBRAM.
       DRVL ##WRn ' Disable Chip read
       waitx #50  ' Wait cuz this is slow
       DRVH ##WRn ' Enable Chip Write
       add lRB, #1 ' Increment the read buffer by 1 byte
'      add lr,ltmpdata  ' Populate return value
'      shl lr,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
       CMP li,lRB wz
if_nz  jmp #ltxloop
'      shr lr,#8
' Disable Chip Select
       DRVH  ##CSn
       ret

lsocket             RES  1
lrxptr              RES  1
lREGBUFFERTMP       RES  1
E131CONFIGPTR       RES  1
li                  RES  1
lLADDRL             RES  1
lLADDRH             RES  1
ltmpdata            RES  1
lRB                 RES  1
ldatapin            RES  1
lREGISTER           RES  1
lBLEN               RES  1
lBS                 RES  1
lsocket_rd          RES  1
ll_RX_RSR           RES  1
ll_RX_RD            RES  1
lr                  RES  1
E131ADDR            RES  1
tE131ADDR           RES  1
E131ENUM            RES  1
tE131ENUM           RES  1
tpixlen             RES  1
pixlen              RES  1
