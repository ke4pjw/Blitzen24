'FLTL ##A0
'FLTL ##A1
'FLTL ##WRn
'FLTL ##RDn
'debug(uhex(DIRA))
end

debug(uhex(ethernetlock))
    e131cog := coginit(COGEXEC_NEW, @cogx, @ethernetlock)  + 1

    return
pub stopfastrx()
'' Stops E1.31 cog, if running
''
''
  if (e131cog)
    cogstop(e131cog - 1)
    e131cog := 0
pub e131cognum() : rt
  return e131cog
DAT
        org   0

cogx

inlk  LOCKTRY lelock wc
if_nc  jmp #inlk
'      DRVH ##WRn
'      DRVH ##RDn
'      DRVH ##CSn

      DRVH ##RSET
      DRVH ##MOD
      LOCKREL lelock

      mov lE131Discards, #$00
      mov lE131counter, #$00
' Populate config
      setq      #8-1
      rdlong    lelock, ptra
' Populate E131 config in LUT
      setq2     #432-1
      rdlong   ($200-$200), E131CONFIGPTR


'      mov l_BS, l_socket
'      mov l_socket_rd, l_socket 'Setup the l_socket rd register
'      add l_socket_rd, #$10   ' It is the value of the l_socket register + $10
'pub FastReceiveProcess(socket,lrxptr,lREGBUFFERTMP) |  i , lLADDRL, lLADDRH, ltmpdata, lRB, ldatapin, lREGISTER, lBLEN, lBS, socket_rd, ll_RX_RSR, ll_RX_RD, lr


      mov lBS, lsocket
      mov lsocket_rd, lsocket 'Setup the lsocket rd register
      add lsocket_rd, #$10   ' It is the value of the lsocket register + $10
'      mov lREGBUFFERTMP, #0
'      SETINT1 #lstart






' Find if there are any bytes in the rx buffer (RX_RSR)
lstart mov lREGISTER, ##REG_Sn_RX_RSR

      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
'      debug(uhex(lREGISTER))
'      debug(uhex(lBLEN))
'      debug(uhex(lRB))
      call #lrx
'      debug(uhex(lr))
'stop  nop
'      jmp #stop
      cmp lr, #0 wz  ' lr is what is returned from rx. rx returns the last two bytes as a word.
if_z  waitx ##2700 ' ~10us delay to allow Spin2 cogs to acquire the ethernet lock
if_z  jmp #lstart ' If r is empty, go fish.
      mov ll_RX_RSR, lr

' Check it again to be sure
      mov lREGISTER, ##REG_Sn_RX_RSR
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
      call #lrx
      cmp lr, ll_RX_RSR wz  ' lr is what is returned from rx. rx returns the last two bytes as a word.
if_nz  jmp #lstart ' If lr is not the same as ll_RX_RSR, go fish.

' Find the rx buffer address to start reading bytes (RX_RD)
      mov lREGISTER, ##REG_Sn_RX_RD
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
      call #lrx
      mov ll_RX_RD, lr ' lr is what is returned from rx. rx returns the last two bytes as a word.

' Get this datagram's size from the W6100 UDP4 PACKET INFO header (DS 6.2.3):
' bytes 0-1 = 5 flag bits + 11-bit data length, 2-5 = IP, 6-7 = port.
' Only this datagram is consumed below; any datagrams queued behind it stay in the
' buffer (RSR still counts them) and are handled on the next pass through lstart.
      mov lREGISTER, ll_RX_RD
      mov lBS, lsocket_rd
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP
      call #lrx
      mov lpktlen, lr
      and lpktlen, ##$07FF       ' data length (strip the PACKET INFO flag bits)
      add lpktlen, #8            ' 8-byte header + payload
      cmp ll_RX_RSR, lpktlen wc  ' C = RSR smaller than this datagram (inconsistent header)
if_c  mov lpktlen, ll_RX_RSR     ' then drop everything received, as before

      tjnz lmode, #ddp           ' DDP mode: decode below, rejoin at lskipit

' Determine if this is a VECTOR_E131_DATA_PACKET
      mov E131ADDR, #50 ' Vector of patcket is two bytes at addr 41
      add E131ADDR, ll_RX_RD
      mov lREGISTER, E131ADDR
      mov lBS, lsocket_rd
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
      call #lrx
      mov tE131ADDR, lr
'      debug(uhex(lr))
      CMP tE131ADDR, #$02 wz  '  VECTOR_E131_DATA_PACKET is $02
if_nz  jmp #lskipit

' Get the E1.31 Universe from the packet
      mov E131ADDR, #121 ' Univrse is patcket is two bytes at addr 121
      add E131ADDR, ll_RX_RD
      mov lREGISTER, E131ADDR
      mov lBS, lsocket_rd
      mov lBLEN, #2 ' get two bytes
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
      call #lrx
'      debug(uhex(E131ADDR))
'      debug(uhex(lr))
      mov tE131ADDR, lr '

' Enumerate the lookup table for this universe, if not found, skip pulling this data and clear the W6100 buffer.
      mov   E131ENUM, #1
      mov   pixlen, #0
e131lutenum
      RDLUT tE131ENUM, E131ENUM  wz  ' If LUT value is 0, we have reached the end of lookup table.
if_z  ADD lE131Discards, #1    ' Increment E131 discard counter
'debug(uhex(lE131Discards))
if_z  jmp #lskipit
      CMP tE131ENUM, tE131ADDR wz
if_nz ADD E131ENUM, #4
if_nz jmp #e131lutenum
      ADD E131ENUM, #1
      RDLUT tpixlen,E131ENUM
      ADD E131ENUM, #1
      RDLUT lrxptr, E131ENUM
      REP     #1, #3  ' Pixel byte legnth is 3x number of pixels.
      ADD  pixlen, tpixlen
'      ADD  pixlen, tpixlen
'      ADD  pixlen, tpixlen
'      debug(uhex(tE131ENUM))
'      debug(uhex(pixlen))

'      CMP tE131ADDR, #6 wz
'if_nz jmp #lskipit

' Read the buffer buffer into hub ram
      mov lREGISTER, ll_RX_RD
      add lREGISTER, #134 'Constant where E131 data starts + RX_RD value
      mov lBS, lsocket_rd
'      mov lBLEN, ll_RX_RSR
      mov lBLEN, pixlen  ' Number of bytes
'      debug(uhex(pixlen))
      mov lRB, lrxptr ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
      call #lrx

      ADD lE131Counter, #1  ' Increment E131 packet counter
'debug(uhex(lE131Counter))
' Write the new RX address
 '     and ll_RX_RSR, ##$FFFF
 lskipit

      mov lBS, lsocket
      mov ll_RX_RSR, lpktlen   ' advance past this datagram only (was: past all RSR bytes)
      add ll_RX_RSR,ll_RX_RD 'Determine new RX address

      movbyts   ll_RX_RSR, #%%2301
      WRWORD ll_RX_RSR,lREGBUFFERTMP
'      add lREGBUFFERTMP, #1
'      movbyts   ll_RX_RSR, #%%3210
'      WRBYTE ll_RX_RSR, lREGBUFFERTMP
      mov lREGISTER, ##REG_Sn_RX_RD
      mov lBLEN, #2 ' get two bytes
'      sub lREGBUFFERTMP, #1
      mov lRB, lREGBUFFERTMP ' Put em in the tmp buffer. This is not needed. Might want to skip doing this if @REGBUFFER+((socket >> 5)*2) is $00 later on.
      call #ltx


' Clear RX status and Interrupt

      WRBYTE ##CR_RECV, lREGBUFFERTMP
      mov lREGISTER, ##REG_Sn_CR
      mov lBLEN, #1
      mov lRB, lREGBUFFERTMP
      call #ltx

      WRBYTE #$FF, lREGBUFFERTMP
      mov lREGISTER, ##REG_Sn_IRCLR
      mov lBLEN, #1
      mov lRB, lREGBUFFERTMP
      call #ltx

      WRLONG lE131Counter, lE131Ptr2Counter   'Update the counters
      WRLONG lE131Discards, lE131Ptr2Discards


      jmp #lstart

' ---------------------------------------------------------------------------
' DDP (Distributed Display Protocol) datagram. Entered from above with ll_RX_RD
' and lpktlen (8-byte PACKET INFO + payload) set; always leaves via lskipit.
' DDP header, relative to ll_RX_RD + 8:
'   0 flags (V1 V0 x T S R Q P), 1 sequence, 2 data type, 3 destination ID,
'   4-7 data offset (bytes, big-endian), 8-9 data length (big-endian),
'   10-13 timecode (only when T is set). Data follows at 10, or 14 with T.
' The LUT holds [byte length, byte offset, hub address] per mapped output,
' ended by a 0 length. Every output whose channel range overlaps this packet
' gets the overlapping bytes, so gaps and overlaps both work.
' ---------------------------------------------------------------------------
ddp   mov dbase, ll_RX_RD
      add dbase, #8              ' start of the DDP header in the socket RX buffer

      mov lREGISTER, dbase       ' flags + sequence
      call #ddprd2
      mov dflags, lr
      shr dflags, #8
      mov dtmp, dflags
      and dtmp, #$C0
      cmp dtmp, #$40 wz          ' version must be 1
if_nz jmp #ddpdrop
      test dflags, #$0E wz       ' storage, reply or query: not pixel data
if_nz jmp #ddpdrop

      mov lREGISTER, dbase       ' data type + destination ID
      add lREGISTER, #2
      call #ddprd2
      and lr, #$FF
      cmp lr, #1 wz              ' ID 1 = default output device
if_nz cmp lr, #255 wz            ' ID 255 = all devices
if_nz jmp #ddpdrop

      mov lREGISTER, dbase       ' data offset, high word
      add lREGISTER, #4
      call #ddprd2
      mov doff, lr
      shl doff, #16
      mov lREGISTER, dbase       ' data offset, low word
      add lREGISTER, #6
      call #ddprd2
      or doff, lr

      mov lREGISTER, dbase       ' data length
      add lREGISTER, #8
      call #ddprd2
      mov dlen, lr

      mov dhdr, #10              ' header size
      test dflags, #$10 wz       ' timecode present
if_nz mov dhdr, #14

' Never read past this datagram, whatever its header claims.
      mov dtmp, lpktlen
      sub dtmp, #8
      cmps dtmp, dhdr wc         ' C = datagram shorter than its header
if_c  jmp #ddpdrop
      sub dtmp, dhdr             ' bytes of data actually in the datagram
      fle dlen, dtmp
      tjz dlen, #ddpdrop

      mov dend, doff
      add dend, dlen             ' one past the last byte offset in this packet
      mov dent, #0
      mov dcopied, #0

ddploop
      rdlut dl, dent wz          ' entry byte length; 0 ends the table
if_z  jmp #ddpdone
      add dent, #1
      rdlut ds, dent             ' entry byte offset
      add dent, #1
      rdlut da, dent             ' entry hub address
      add dent, #1

      mov dlo, doff
      fge dlo, ds                ' lo = max(packet start, entry start)
      mov dhi, ds
      add dhi, dl
      fle dhi, dend              ' hi = min(packet end, entry end)
      cmp dlo, dhi wc            ' C = lo < hi: they overlap
if_nc jmp #ddploop

      mov lREGISTER, dlo         ' source: header + data + (lo - packet offset)
      sub lREGISTER, doff
      add lREGISTER, dbase
      add lREGISTER, dhdr
      and lREGISTER, ##$FFFF     ' RX buffer pointers are 16 bits
      mov lBLEN, dhi
      sub lBLEN, dlo
      mov lRB, dlo               ' destination: entry address + (lo - entry start)
      sub lRB, ds
      add lRB, da
      mov lBS, lsocket_rd
      call #lrx
      mov dcopied, #1
      jmp #ddploop

ddpdone
      tjz dcopied, #ddpdrop      ' no mapped output wanted any of it
      add lE131Counter, #1
      jmp #lskipit
ddpdrop
      add lE131Discards, #1
      jmp #lskipit

' Read the 2-byte big-endian word at lREGISTER in the socket RX buffer into lr.
ddprd2
      and lREGISTER, ##$FFFF
      mov lBS, lsocket_rd
      mov lBLEN, #2
      mov lRB, lREGBUFFERTMP
      call #lrx
      ret


' readreg(lREGISTER,lBS,lBLEN,lRB) : lr | i , lLADDRL, lLADDRH, ltmpdata, tmpptr, ldatapin,

lrx   WRFAST #0,lRB

rxlk  LOCKTRY lelock wc
if_nc  jmp #rxlk
'      debug(uhex(lelock))
      DRVL ##WRn
      DRVL ##RDn
      DRVL ##CSn

' Clear the return value
      mov lr,#0

' Parse register address
      mov lLADDRL, lREGISTER
      mov lLADDRH, lREGISTER
      and lLADDRL, #$FF
      shr lLADDRH, #8

' Set the data pins
      mov ldatapin, #dpins

' Setup the byte ingest counter
      mov li,#0
      add li,lBLEN
      add li,lRB

' Enable Chip Select on the W6100
      DRVH  ##CSn
      waitx #BUS_CS_SETUP
' Load high byte
      DRVH  ##A0 'ADDR bit 0
      DRVH  ##A1 'ADDR bit 1

'  DIRNOT #DATA
      DRVL #DATA
      altsb ldatapin, #outa
      setbyte lLADDRH
'      debug(uhex(lLADDRH))

      DRVH  ##WRn
      waitx #BUS_WR_PULSE
      DRVL  ##WRn

'load low byte

      DRVL  ##A0 'ADDR bit 0
      DRVH  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lLADDRL
'      debug(uhex(lLADDRL))
      DRVH  ##WRn
      waitx #BUS_WR_PULSE
      DRVL  ##WRn

'Set lBS
      DRVH  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lBS
'      debug(uhex(lBS))

      DRVH  ##WRn
      waitx #BUS_WR_PULSE
      DRVL  ##WRn

      DRVL  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1
      FLTL  #DATA
'      debug(uhex(#DATA ))
' Read i number of bytes.
      waitx #BUS_TURNAROUND
      tjz lBLEN, #lrxdone        ' nothing to read
' Data reads (more than 2 bytes) use a zero-overhead REP loop. Only the 2-byte
' register reads need lr (the returned word), so they keep the loop below.
      cmp lBLEN, #2 wcz          ' C or Z: lBLEN <= 2
if_be jmp #lrxloop
      rep @lrxfend, lBLEN
      drvh #RDn                  ' assert RDn
      waitx #BUS_RD_DSAMPLE      ' wait for data valid
      altgb ldatapin, #ina
      getbyte ltmpdata           ' sample
      drvl #RDn                  ' release RDn right after sampling
      wfbyte ltmpdata            ' to hub through the write FIFO
      waitx #BUS_RD_HIGH         ' RDn high time before the next byte
lrxfend
      jmp #lrxdone

lrxloop DRVH ##RDn ' Enable Chip Read
'      debug(uhex(DIRA))
      waitx #BUS_RD_SAMPLE ' Wait for data valid (spec <= 35 ns after RDn low)
'      debug(uhex(ldatapin))
      altgb ldatapin, #ina ' Where you gonna get that data?
      getbyte ltmpdata ' Get that data and put it in ltmpdata
      DRVL ##RDn ' Disable Chip read right after sampling
'      debug(uhex(ltmpdata))
'      WRBYTE ltmpdata, RB ' Write that data to the read buffer in HUBRAM.
'      debug(uhex(ltmpdata))
      WFBYTE ltmpdata
      add lRB, #1 ' Increment the read buffer by 1 byte

      add lr,ltmpdata  ' Populate return value
      shl lr,#8
      waitx #BUS_RD_RECOVER ' RDn high margin (spec >= 30 ns between reads)

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP li,lRB wz
if_nz jmp #lrxloop
lrxdone
      shr lr,#8
' Disable Chip Select
      DRVL  ##CSn

'      FLTL ##CSn
'      FLTL ##A0
'      FLTL ##A1
'      FLTL ##WRn
'      FLTL ##RDn
      FLTL #DATA
      waitx #BUS_CS_RECOVER
      lockrel lelock
      ret

 ' Parse register address
ltx  RDFAST #0,lRB
txlk  LOCKTRY lelock wc
if_nc  jmp #txlk

      DRVL ##WRn
      DRVL ##RDn
      DRVL ##CSn

' Clear the return value
      mov lr,#0

' Parse register address
      mov lLADDRL, lREGISTER
      mov lLADDRH, lREGISTER
      and lLADDRL, #$FF
      shr lLADDRH, #8

' Set the data pins
      mov ldatapin, #dpins

' Setup the byte ingest counter
      mov li,#0
      add li,lBLEN
      add li,lRB

' Enable Chip Select on the W6100
      DRVH  ##CSn
      waitx #BUS_CS_SETUP
' Load high byte
      DRVH  ##A0 'ADDR bit 0
      DRVH  ##A1 'ADDR bit 1

'  DIRNOT #DATA
      DRVL #DATA

      altsb ldatapin, #outa
      setbyte lLADDRH

      DRVH  ##WRn
      waitx #BUS_WR_PULSE
      DRVL  ##WRn

'load low byte

      DRVL  ##A0 'ADDR bit 0
      DRVH  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lLADDRL

      DRVH  ##WRn
      waitx #BUS_WR_PULSE
      DRVL  ##WRn

'Set lBS
      DRVH  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1

      altsb ldatapin, #outa
      setbyte lBS

      DRVH  ##WRn
      waitx #BUS_WR_PULSE
      DRVL  ##WRn

      DRVL  ##A0 'ADDR bit 0
      DRVL  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE ltmpdata, lRB
ltxloop RFBYTE ltmpdata
       altsb ldatapin,#outa ' Where you gonna send that data?
       setbyte ltmpdata ' Set that data from ltmpdata
'      WRBYTE ltmpdata, lRB ' Write that data to the read buffer in HUBRAM.
       DRVH ##WRn ' Disable Chip read
       waitx #BUS_WR_PULSE ' WRn low time
       DRVL ##WRn ' Enable Chip Write
       add lRB, #1 ' Increment the read buffer by 1 byte
'      add lr,ltmpdata  ' Populate return value
'      shl lr,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
       CMP li,lRB wz
if_nz  jmp #ltxloop
'      shr lr,#8
' Disable Chip Select
       DRVL  ##CSn


'      FLTL ##A0
'      FLTL ##A1
'      FLTL ##WRn
'      FLTL ##RDn
'      FLTL ##CSn
      FLTL #DATA
      waitx #BUS_CS_RECOVER
       lockrel lelock
       ret

lelock              RES  1
lsocket             RES  1
lrxptr              RES  1
lREGBUFFERTMP       RES  1
E131CONFIGPTR       RES  1
lE131Ptr2Counter    RES  1
lE131Ptr2Discards   RES  1
lmode               RES  1    ' must follow lE131Ptr2Discards (loaded by setq #8-1)
li                  RES  1
lLADDRL             RES  1
lLADDRH             RES  1
ltmpdata            RES  1
lRB                 RES  1
ldatapin            RES  1
lREGISTER           RES  1
lBLEN               RES  1
lBS                 RES  1
lsocket_rd          RES  1
ll_RX_RSR           RES  1
ll_RX_RD            RES  1
lpktlen             RES  1
lr                  RES  1
E131ADDR            RES  1
tE131ADDR           RES  1
E131ENUM            RES  1
tE131ENUM           RES  1
tpixlen             RES  1
pixlen              RES  1
lE131Counter        RES  1
lE131Discards       RES  1
dbase               RES  1    ' DDP: RX buffer address of the DDP header
dflags              RES  1    ' DDP: header flags byte
dtmp                RES  1
doff                RES  1    ' DDP: packet data offset (bytes)
dlen                RES  1    ' DDP: packet data length (bytes)
dhdr                RES  1    ' DDP: header size (10 or 14)
dend                RES  1    ' DDP: doff + dlen
dent                RES  1    ' DDP: LUT index
dl                  RES  1    ' DDP: entry byte length
ds                  RES  1    ' DDP: entry byte offset
da                  RES  1    ' DDP: entry hub address
dlo                 RES  1
dhi                 RES  1
dcopied             RES  1
con { license }