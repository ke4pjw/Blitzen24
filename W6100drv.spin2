lockrel(ethernetlock)

pub ReceiveProcess(socket,rxptr) : rtv
'' Reads data from socket and writes it to the pointer at rxptr
'' Expects-
''  socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
''  rxptr: Pointer to location in memory to write data to
'' Returns number of bytes in packet.
    readreg(REG_Sn_RX_RD,socket,2,@REGBUFFER+((socket >> 5)*2))
'    send("RX Buffer Start Address: ")
'    hex(REGBUFFER[(socket >> 5)*2],2)
'    hex(REGBUFFER[1+((socket >> 5)*2)],2)
'    nl()
    RX_RD[(socket >> 5)] := REGBUFFER[(socket >> 5)*2]
    RX_RD[(socket >> 5)] <<= 8
    RX_RD[(socket >> 5)] := RX_RD[(socket >> 5)] + REGBUFFER[((socket >> 5)*2)+1]


'    send("Read buffer starting at: ")
'    hex(REGBUFFER[(socket >> 5)*2],2)
'    hex(REGBUFFER[1+((socket >> 5)*2)],2)
'    nl()
    readreg(RX_RD[(socket >> 5)],socket + $10,RX_RSR[(socket >> 5)],rxptr)


'    send("Update RX Buffer Start Address: ")
    RX_RD[(socket >> 5)] := RX_RD[(socket >> 5)] + RX_RSR[(socket >> 5)]
    REGBUFFER[(socket >> 5)*2] := RX_RD.BYTE[((socket >> 5)*2) + 1]
    REGBUFFER[((socket >> 5)*2)+1] := RX_RD.BYTE[(socket >> 5)*2]
    writereg(REG_Sn_RX_RD,socket,2,@REGBUFFER+((socket >> 5)*2))
'    hex(REGBUFFER[(socket >> 5)*2],2)
'    hex(REGBUFFER[1+((socket >> 5)*2)],2)
'    nl()
    REGBUFFER[((socket >> 5)*2)+1] := CR_RECV
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2)+1)
    repeat until REGBUFFER[(socket >> 5)*2] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    rtv := RX_RSR[(socket >> 5)]

pub SendData(socket,sendptr,ptrlen) : rtv | i
'' Sends ptrlen bytes of data located that sendptr memory location to socket
'' Returns nothing
''
    readreg(REG_Sn_TX_WR,socket,2,@REGBUFFER+((socket >> 5)*2))
    'send("TX Buffer Start Address: ")
    'vid.hex(REGBUFFER[(socket >> 5)*2],2)
    'vid.hex(REGBUFFER[1+((socket >> 5)*2)],2)
    'vid.nl()
    TX_WR[(socket >> 5)] := REGBUFFER[(socket >> 5)*2]
    TX_WR[(socket >> 5)] <<= 8
    TX_WR[(socket >> 5)] := TX_WR[(socket >> 5)] + REGBUFFER[((socket >> 5)*2)+1]

   ' bytemove(@WRITEBUFFER,sendptr,strsize(sendptr))

    'send("Write Webpage request to TX Buffer")
    'vid.nl()
   { i:=0
    repeat strsize(@WRITEBUFFER)
      'send(WRITEBUFFER[i])
      i++
    }
    writereg(TX_WR[(socket >> 5)],socket + $08,ptrlen,sendptr)
    'vid.nl()


    'send("Update TX Buffer Start Address: ")
'    TX_WR[(socket >> 5)] := TX_WR[(socket >> 5)] + strsize(@WRITEBUFFER)
    TX_WR[(socket >> 5)] := TX_WR[(socket >> 5)] + ptrlen
    REGBUFFER[(socket >> 5)*2] := TX_WR.BYTE[((socket >> 5)*2)+1]
    REGBUFFER[((socket >> 5)*2)+1] := TX_WR.BYTE[(socket >> 5)*2]
    'vid.hex(REGBUFFER[(socket >> 5)*2],2)
    'vid.hex(REGBUFFER[1+((socket >> 5)*2)],2)
    'vid.hex(TX_WR,4)
    'vid.nl()
    writereg(REG_Sn_TX_WR,socket,2,@REGBUFFER+((socket >> 5)*2))
 {
    readreg(REG_Sn_IR,socket,1,@READBUFFER)
    'send("Checking Sn_IR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()

    readreg(REG_Sn_CR,socket,1,@READBUFFER)
    'send("Checking Sn_CR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()

    readreg(REG_Sn_MR,socket,1,@READBUFFER)
    'send("Checking Sn_MR Socket Status: ")
    'vid.hex(READBUFFER[0],2)
    'vid.nl()
  }
    'send("Sending Webpage")
    'vid.nl()
    REGBUFFER[(socket >> 5)*2] := CR_SEND
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == 0

       readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
'
'       debug(udec(REGBUFFER[(socket >> 5)*2]))
'       debug(udec(REGBUFFER[1+((socket >> 5)*2)]))

    repeat while (REGBUFFER[(socket >> 5)*2] & $18) == $00
       readreg(REG_Sn_IR,socket,1,@REGBUFFER+((socket >> 5)*2))

'Not sure we need this

    if (REGBUFFER[(socket >> 5)*2] & $18) == $10
         REGBUFFER[(socket >> 5)*2] := $10
         writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER+((socket >> 5)*2))

    waitus(850)
    'send("Webpage Sent")
    'vid.nl()
pub isdisconnected(socket) : rtv
'' Returns True if socket is disconnected
'' Expects socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
''
    waitms(1)
    return readreg(REG_Sn_IR,socket,1,@REGBUFFER+((socket >> 5)*2)) & Sn_IR_DISCON == Sn_IR_DISCON

pub SendDataTCP(socket,sendptr,ptrlen) : rtv | i
'' Unsure if this is needed
'' May be a duplicate of SendData
''
    readreg(REG_Sn_TX_WR,socket,2,@REGBUFFER+((socket >> 5)*2))
    TX_WR[(socket >> 5)] := REGBUFFER[(socket >> 5)*2]
    TX_WR[(socket >> 5)] <<= 8
    TX_WR[(socket >> 5)] := TX_WR[(socket >> 5)] + REGBUFFER[((socket >> 5)*2)+1]
    writereg(TX_WR[(socket >> 5)],socket + $08,ptrlen,sendptr)

    'send("Update TX Buffer Start Address: ")

    TX_WR[(socket >> 5)] := TX_WR[(socket >> 5)] + ptrlen
    REGBUFFER[(socket >> 5)*2] := TX_WR.BYTE[((socket >> 5)*2)+1]
    REGBUFFER[((socket >> 5)*2)+1] := TX_WR.BYTE[((socket >> 5)*2)]

    writereg(REG_Sn_TX_WR,socket,2,@REGBUFFER+((socket >> 5)*2))

pub EndDataTCP(socket) : rtv | i
'' Unsure if this is needed
'' May be a duplicate of Disconnect()
''
    'send("Sending Webpage")
    'vid.nl()
    REGBUFFER[(socket >> 5)*2] := CR_SEND
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat while (REGBUFFER[(socket >> 5)*2] & $18) == $00
       readreg(REG_Sn_IR,socket,1,@REGBUFFER+((socket >> 5)*2))

    if (REGBUFFER[(socket >> 5)*2] & $18) == $10
         REGBUFFER[(socket >> 5)*2] := $10
         writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER+((socket >> 5)*2))
    'send("Webpage Sent")
    'vid.nl()



pub Timeout()

PUB hex(value, digits)
' Print a hexadecimal number
  value <<= (8 - digits) << 2
  repeat digits
    value ROL= 4
    send(lookupz(value & $F : "0".."9", "A".."F"))
PUB nl()
'' Send newline to SEND()
''
''
 send( $0D, $0A)
PUB startfastrx(skt,pbf,txb,e131ptr,mode)
'' Start the fast-RX (E1.31 / DDP) cog.
'' skt is the Socket to listen on
'' pbf is the pointer to the pixelbuffer
'' txb is the pointer to buffer to use for the REGBUFFER
'' e131prt is a pointer to the lookup table loaded into the cog's LUT (432 longs are read):
''   mode 0 (E1.31): the E1.31 configuration memory structure
''   mode 1 (DDP):   DDP map, 3 longs per entry [byte length, byte offset (0-based), hub address],
''                   terminated by an entry whose byte length is 0
'' mode is 0 for E1.31, 1 for DDP

    longmove(@E131Socket, @skt, 4)
    E131Mode := mode
    E131Ptr2Counter  := @E131Counter
    E131Ptr2Discards := @E131Discards
'    hex(E131PACKETBUFFER,8)
org
