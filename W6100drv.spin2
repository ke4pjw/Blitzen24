CON

  DOWNLOAD_BAUD = 2_000_000
  DEBUG_BAUD = DOWNLOAD_BAUD

  MOD   = 16
  ADDR  = 18 ADDPINS 1
  RSET  = 23
  CSn   = 17
  RDn   = 21
  WRn   = 22
'  INTn  = 20  'Not used
  DATA  = 24 ADDPINS 7
  DPINS = 24 / 8
  A0    = 18
  A1    = 19

  ' W6100 parallel-bus delays for the E1.31 cog (waitx operands, P2 clocks at 270 MHz).
  ' W6100 DS 8.4.2 minimums at SYS_CLK = 100 MHz: RD/WR low 40 ns, RD/WR high 30 ns,
  ' data valid <= 35 ns after RD low. Values below leave about 2x margin.
  BUS_CS_SETUP   = 4    ' after CSn asserted, before first address strobe (spec 0 ns)
  BUS_WR_PULSE   = 20   ' WRn low time (spec >= 40 ns); 22 clocks + DRVL = ~90 ns
  BUS_RD_SAMPLE  = 20   ' RDn low to data sample (spec <= 35 ns); ~96 ns
  BUS_RD_RECOVER = 2    ' extra RDn high time between reads (spec >= 30 ns); ~80 ns total
  BUS_RD_DSAMPLE = 20   ' RDn low to data sample in the REP data loop (spec <= 35 ns); 26 clocks = ~96 ns
                        ' Measured 2026-11-08: values 12-14 (sample ~66-74 ns) read corrupt bytes on hardware,
                        ' 0-11 and 15-20 read clean. Do not lower this below 16.
  BUS_RD_HIGH    = 12   ' RDn high time in the REP data loop (spec >= 30 ns); 16 clocks = ~59 ns
  BUS_TURNAROUND = 4    ' after FLTL DATA, before first RDn (bus turnaround + address setup)
  BUS_CS_RECOVER = 4    ' after CSn released, before LOCKREL (spec Tcsn >= 30 ns)

  LED1  = 56
  LED2  = 57

' Parallel Bus Symbols
  IDM_ARH = %00
  IDM_ARL = %01
  IDM_BSR = %10
  IDM_DR  = %11

' Block Selection (BS)
  IDM_BSR_Common_Register       = %000_00_000
  IDM_BSR_Socket0_Register      = %000_01_000
  IDM_BSR_Socket0_TX_Buffer     = %000_10_000
  IDM_BSR_Socket0_RX_Buffer     = %000_11_000
  IDM_BSR_Socket1_Register      = %001_01_000
  IDM_BSR_Socket1_TX_Buffer     = %001_10_000
  IDM_BSR_Socket1_RX_Buffer     = %001_11_000
  IDM_BSR_Socket2_Register      = %010_01_000
  IDM_BSR_Socket2_TX_Buffer     = %010_10_000
  IDM_BSR_Socket2_RX_Buffer     = %010_11_000
  IDM_BSR_Socket3_Register      = %011_01_000
  IDM_BSR_Socket3_TX_Buffer     = %011_10_000
  IDM_BSR_Socket3_RX_Buffer     = %011_11_000
  IDM_BSR_Socket4_Register      = %100_01_000
  IDM_BSR_Socket4_TX_Buffer     = %100_10_000
  IDM_BSR_Socket4_RX_Buffer     = %100_11_000
  IDM_BSR_Socket5_Register      = %101_01_000
  IDM_BSR_Socket5_TX_Buffer     = %101_10_000
  IDM_BSR_Socket5_RX_Buffer     = %101_11_000
  IDM_BSR_Socket6_Register      = %110_01_000
  IDM_BSR_Socket6_TX_Buffer     = %110_10_000
  IDM_BSR_Socket6_RX_Buffer     = %110_11_000
  IDM_BSR_Socket7_Register      = %111_01_000
  IDM_BSR_Socket7_TX_Buffer     = %111_10_000
  IDM_BSR_Socket7_RX_Buffer     = %111_11_000

' W6100 Registers
  REG_CIDR0     = $0000
  REG_CIDR1     = $0001
  REG_VER0      = $0002
  REG_VER1      = $0003
  REG_CHPLCKR   = $41F4
  REG_NETLCKR   = $41F5
  REG_PHYLCKR   = $41F6
  REG_PHYSR     = $3000
  REG_PHYCR0    = $301C
  REG_PHYCR1    = $301D
  REG_SYSR      = $2000
  REG_SYCR1     = $2005
  REG_SHAR0     = $4120
  REG_SHAR1     = $4121
  REG_SHAR2     = $4122
  REG_SHAR3     = $4123
  REG_SHAR4     = $4124
  REG_SHAR5     = $4125
  REG_GAR0      = $4130
  REG_GAR1      = $4131
  REG_GAR2      = $4132
  REG_GAR3      = $4133
  REG_SUBR0     = $4134
  REG_SUBR1     = $4135
  REG_SUBR2     = $4136
  REG_SUBR3     = $4137
  REG_SIPR0     = $4138
  REG_SIPR1     = $4139
  REG_SIPR2     = $413A
  REG_SIPR3     = $413B
  REG_Sn_TX_BSR = $0200
  REG_Sn_RX_BSR = $0220
  REG_Sn_MR     = $0000
  REG_Sn_MSSR   = $0110
  REG_Sn_MR2    = $0144
  REG_Sn_DHAR   = $0118
  REG_Sn_DIPR   = $0120
  REG_Sn_DPORTR = $0140
  REG_Sn_PORTR  = $0114
  REG_Sn_TX_WR   = $020C
  REG_Sn_CR     = $0010
  REG_Sn_SR     = $0030
  REG_Sn_IR     = $0020
  REG_Sn_IRCLR  = $0028
  REG_Sn_RX_RSR = $0224
  REG_Sn_RX_RD  = $0228
  REG_Sn_IMR    = $0024
  REG_IR        = $2100
  REG_SIR       = $2101
  REG_SIMR      = $2114


' Protocol Mode
  PM_SOCKET_Closed   = %0000
  PM_TCP4            = %0001
  PM_UDP4            = %0010
  PM_IPRAW4          = %0011
  PM_MACRAW          = %0111
  PM_TCP6            = %1001
  PM_UDP6            = %1010
  PM_IPRAW6          = %1011
  PM_TCP_Dual        = %1101
  PM_UDP_Dual        = %1110
  PM_M_UDP4          = %1000_0010 'UDP Multicast

' MR2 Options

  MR2_DHAM      = 2 ' Overide Destination MAC Address
  MR2_FARP      = 1 ' Use ARP for destination.

' Interrupt Registers
  Sn_IR_SENDOK  = %0001_0000
  Sn_IR_TIMEOUT = %0000_1000
  Sn_IR_RECV    = %0000_0100
  Sn_IR_DISCON  = %0000_0010
  Sn_IR_CON     = %0000_0001

' Command Registers
  CR_Complete   = $00
  CR_Open       = $01
  CR_LISTEN     = $02
  CR_CONNECT    = $04
  CR_CONNECT6   = $84
  CR_DISCON     = $08
  CR_CLOSE      = $10
  CR_SEND       = $20
  CR_SEND6      = $A0
  CR_SEND_KEEP  = $22
  CR_RECV       = $40

 ' Status Registers
  SOCK_CLOSED       = $00 'SOCKET n closed.
  SOCK_INIT         = $13 'SOCKET n opened in TCP Mode.
  SOCK_LISTEN       = $14 'SOCKET n is in TCP Mode and waits for Connection request.
  SOCK_ESTABLISHED  = $17 'SOCKET n is in TCP Mode and TCP Connection is completed.
  SOCK_CLOSE_WAIT   = $1C 'SOCKET n is in TCP Mode and received FIN Packet.
  SOCK_UDP          = $22 'SOCKET n opened in UDP Mode.
  SOCK_IPRAW        = $32 'SOCKET n opened in IPRAW Mode.
  SOCK_IPRAW6       = $33 'SOCKET n opened in IPRAW6 Mode.
  SOCK_MACRAW       = $42 'SOCKET n opened in MACRAW Mode.
  SOCK_SYNSENT      = $15 'The status of sending Connect-Request.
  SOCK_SYNRECV      = $16 'The status of receiving Connect-Request.
  SOCK_FIN_WAIT     = $18 'The status of closing SOCKET n.
  SOCK_TIME_WAIT    = $1B 'The status of closing SOCKET n.
  SOCK_LAST_ACK     = $1D 'The status of closing SOCKET n.

  '
   SYSR_CHPL    = $CE ' Unlock Chip
   SYSR_NETL    = $C5 ' Lock Net
   SYSR_NETU    = $3A ' Lock Net
   SYSR_PHYL    = $53 ' Unlock PHY Lock Register

   TENBASETXHDX  = %00000_111       '7
   TENBASETXFDX  = %00000_110       '6
   HUNDREDBASETXHDX  = %00000_101   '5
   HUNDREDBASETXFDX  = %00000_100   '4
   AUTONEGOTIATION  = %00000_000    '0
VAR
  long EthernetLock
  long E131Socket
  long E131PACKETBUFFER
  long E131TXBUFFER
  long E131Ptr2Config
  long E131Ptr2Counter
  long E131Ptr2Discards
  long E131Mode          ' 0 = E1.31, 1 = DDP (read by the fast-RX cog with the 7 longs above)
  long  ADDRH
  long  ADDRL
  byte  REGBUFFER[16]
  word  TX_WR[8]
  word  RX_RD[8]
  word  RX_RSR[8]
  long  e131cog
  long  E131Counter
  long  E131Discards


OBJ

PUB setuppins() : i
org
  WRPIN ##$00004000,#CSn
  WRPIN ##$00004000,#RDn
  WRPIN ##$00004000,#WRn
  WRPIN ##$00004000,#A1
  WRPIN ##$00004000,#A0
{
  WRPIN ##$00000800, #24
  WRPIN ##$00000800, #25
  WRPIN ##$00000800, #26
  WRPIN ##$00000800, #27
  WRPIN ##$00000800, #28
  WRPIN ##$00000800, #29
  WRPIN ##$00000800, #30
  WRPIN ##$00000800, #31
}

end
PUB reset()
'' Resets the W6100
''
''
  PINL (RSET)
  PINL (WRn)
  PINL (RDn)
  PINL (CSn)
  PINH (RSET)
  waitms (3000)
PUB setmod010()
'' Sets W6100 to Mode 010 (Parallel Data Mode)
''
''
  PINH (MOD)

PUB initparallel() : r
'' Sets up pins for parallel mode
'' Set SPIMODE to false
'' Returns the lock used for EthernetLock
'  SPIMODE := false
  setuppins()
  EthernetLock := locknew()
   if EthernetLock >= 0  and  EthernetLock <= 15
    reset()
    setmod010()

  return EthernetLock
PUB Counter() : r
'' The packet counter for E1.31
''
''
    return E131Counter
PUB Discards() : r
'' The number of E1.31 packets that are destened for a Universe not configured.
''
''
    return E131Discards

PUB readreg(REGISTER,BS,BLEN,RB) : r | i , LADDRL, LADDRH, tmpdata, tmpptr, datapin
'' Reads from a register. Returns last byte
'' REGISTER : Regsiter to Read (See CON Section)
'' BS : Block Selection Register (See CON Section)
'' BLEN : Number of bytes to read from the Buffer
'' RB : String address to write buffer to
repeat until locktry(EthernetLock) < 0
'  waitus(0)
org
' Set the HUB FIFO

 WRFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVH  ##CSn
  waitx #100
' Load high byte
  DRVH  ##A0 'ADDR bit 0
  DRVH  ##A1 'ADDR bit 1

'  DIRNOT #DATA
    DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVH  ##WRn
  waitx #50
  DRVL  ##WRn

'load low byte

  DRVL  ##A0 'ADDR bit 0
  DRVH  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVH  ##WRn
  waitx #50
  DRVL  ##WRn

'Set BS
  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVH  ##WRn
  waitx #50
  DRVL  ##WRn

  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1
  FLTL #DATA

' Read i number of bytes.

label DRVH ##RDn ' Enable Chip Read
      waitx #50 ' Wait cuz this is slow
      altgb datapin,#ina ' Where you gonna get that data?
      getbyte tmpdata ' Get that data and put it in tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      WFBYTE tmpdata
      add RB, #1 ' Increment the read buffer by 1 byte
      DRVL ##RDn ' Disable Chip read
      waitx #50  ' Wait cuz this is slow

      add r,tmpdata  ' Populate return value
      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #label
      shr r,#8
' Disable Chip Select
      DRVL  ##CSn

'      FLTL ##A0
'      FLTL ##A1
'      FLTL ##WRn
'      FLTL ##RDn
'      FLTL ##CSn
      FLTL #DATA
end

lockrel(ethernetlock)
return r

PUB writereg(REGISTER,BS,BLEN,RB) : r | i , LADDRL ,  LADDRH , datapin , tmpdata
'' Writes to a register.
'' REGISTER : Regsiter to Write (See CON Section)
'' BS : Block Selection Register (See CON Section)
'' BLEN : Number of bytes to write to the Buffer
'' RB : String address to write buffer from

repeat until locktry(EthernetLock) < 0
'  waitus(0)
org
' Parse register address
  RDFAST #0,RB

' Clear the return value
  mov r,#0

' Parse register address
  mov LADDRL, REGISTER
  mov LADDRH, REGISTER
  and LADDRL, #$FF
  shr LADDRH, #8

' Set the data pins
  mov datapin, #dpins

' Setup the byte ingest counter
  mov i,#0
  add i,BLEN
  add i,RB

' Enable Chip Select on the W6100
  DRVH  ##CSn
  waitx #100
' Load high byte
  DRVH  ##A0 'ADDR bit 0
  DRVH  ##A1 'ADDR bit 1

'  DIRNOT #DATA
  DRVL #DATA

  altsb datapin, #outa
  setbyte LADDRH

  DRVH  ##WRn
  waitx #50
  DRVL  ##WRn

'load low byte

  DRVL  ##A0 'ADDR bit 0
  DRVH  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte LADDRL

  DRVH  ##WRn
  waitx #100
  DRVL  ##WRn

'Set BS
  DRVH  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1

  altsb datapin, #outa
  setbyte BS

  DRVH  ##WRn
  waitx #100
  DRVL  ##WRn

  DRVL  ##A0 'ADDR bit 0
  DRVL  ##A1 'ADDR bit 1
'  FLTL #DATA
'end

' Read i number of bytes.

 'RDBYTE tmpdata, RB
label RFBYTE tmpdata
      altsb datapin,#outa ' Where you gonna send that data?
      setbyte tmpdata ' Set that data from tmpdata
'      WRBYTE tmpdata, RB ' Write that data to the read buffer in HUBRAM.
      DRVH ##WRn ' Disable Chip read
      waitx #100  ' Wait cuz this is slow
      DRVL ##WRn ' Enable Chip Write
      add RB, #1 ' Increment the read buffer by 1 byte
'      add r,tmpdata  ' Populate return value
'      shl r,#8

' R U Dun? (Compare i, which is where we stop where it is equal to the current read buffer value)
      CMP i,RB wz
if_nz jmp #label
'      shr r,#8
' Disable Chip Select
      DRVL  ##CSn

'      FLTL ##A0
'      FLTL ##A1
'      FLTL ##WRn
'      FLTL ##RDn
 '     FLTL ##CSn
      FLTL #DATA
      waitx #100
end
 {

  LADDRL :=  REGISTER
  LADDRH :=  LADDRL
  LADDRL &= $FF
  LADDRH >>= 8

' Set ADDRH
  PINL(CSn)
  PINWRITE (ADDR , IDM_ARH)
  PINWRITE (DATA , LADDRH)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)

'Set ADDRL
  PINWRITE (ADDR , IDM_ARL)
  PINWRITE (DATA , LADDRL)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)

'Set BS (This is a common register, therefore set byte data to $00)
  PINWRITE (ADDR , IDM_BSR)
  PINWRITE (DATA , BS)
  'pintoggle(WRn)
  PINL(WRn)
  PINH(WRn)


'Write Register
  i := 0
  PINWRITE (ADDR , IDM_DR)
  REPEAT BLEN

    PINWRITE (DATA , byte[RB][i])
    i++
    'pintoggle(WRn)
    PINL(WRn)
    PINH(WRn)

  PINH(CSn)
 }
lockrel(ethernetlock)
return

Pub Disconnect(socket)
'' Disconnect the socket/close connection.
'' Expects socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
'' Returns nothing.
    'send("Disconnect attempt")


 '   readreg(REG_Sn_IR,IDM_BSR_Socket1_Register,1,@REGBUFFER+((socket >> 5)*2))
  '  If REGBUFFER[0] <> $1C
    REGBUFFER[(socket >> 5)*2] := CR_DISCON
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == 0
        readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))

    repeat while (REGBUFFER[(socket >> 5)*2] & (Sn_IR_TIMEOUT + Sn_IR_DISCON)) == $00
        readreg(REG_Sn_IR,socket,1,@REGBUFFER+((socket >> 5)*2))
        'vid.hex(REGBUFFER[0],2)
        'vid.nl()
      if (REGBUFFER[(socket >> 5)*2] & (Sn_IR_TIMEOUT + Sn_IR_DISCON)) == Sn_IR_DISCON
       REGBUFFER[(socket >> 5)*2] := Sn_IR_DISCON
      else
       REGBUFFER[(socket >> 5)*2] := Sn_IR_TIMEOUT
      writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER+((socket >> 5)*2))

    'send("Disconnected")
    'vid.nl()
    ' Gonna try this bullshit right here because I am sure I didn't clear all of the interrupts
    REGBUFFER[(socket >> 5)*2] := $1F
    writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER+((socket >> 5)*2))

pub Close(socket)
'' Closes the socket (TCP or UDP) and returns it to SOCK_CLOSED.
'' Expects socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket0_Register
'' Returns nothing.
    ' Issue the CLOSE command and wait for the W6100 to accept it (Sn_CR returns to 0)
    REGBUFFER[(socket >> 5)*2] := CR_CLOSE
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == 0
        readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))

    ' Wait until the socket status reads SOCK_CLOSED
    readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == SOCK_CLOSED
        readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))

    ' Clear any leftover interrupt flags on this socket
    REGBUFFER[(socket >> 5)*2] := $FF
    writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER+((socket >> 5)*2))


pub Open(port,PM,socket)
'' Opens/sets port on socket
'' Expects-
''  Port: is TCP/UDP Port Number
''  PM:  Protocol Mode. See in CON section. Example: PM_TCP4 for TCP IPv4
''  Socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
'' Returns nothing.
  readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
  'vid.hex(REGBUFFER[(socket >> 5)*2],2)
  'vid.nl()
  repeat until REGBUFFER[(socket >> 5)*2] == SOCK_INIT or REGBUFFER[(socket >> 5)*2] == SOCK_UDP
    REGBUFFER[(socket >> 5)*2] := PM
    writereg(REG_Sn_MR,socket,1,@REGBUFFER+((socket >> 5)*2))

   ' Set Listening port
    REGBUFFER[(socket >> 5)*2] := port.BYTE[1]
    REGBUFFER[((socket >> 5)*2)+1] := port.BYTE[0]
    writereg(REG_Sn_PORTR,socket,2,@REGBUFFER+((socket >> 5)*2))

  ' Choose the form of the destructor. (Open the socket)
    REGBUFFER[(socket >> 5)*2] := CR_Open
    writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
      repeat until REGBUFFER[(socket >> 5)*2] == 0
         readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))

    readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
    'vid.hex(REGBUFFER[(socket >> 5)*2],2)
    'vid.nl()

pub ListenTCP(socket) : rtv
'' Creates listener on socket
'' Expects socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
'' Returns value in REG_Sn_SR for given socket.
  REGBUFFER[(socket >> 5)*2] := CR_LISTEN
  writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
  rtv := REGBUFFER[(socket >> 5)*2]

pub ReopenTCP(socket) : rtv
'' Reopens a previously configured TCP socket and returns to LISTEN state.
'' Skips MR/PORTR writes — assumes Open() was already called once.
'' Use after Disconnect() to minimize bus transactions.
  REGBUFFER[(socket >> 5)*2] := CR_Open
  writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  repeat until REGBUFFER[(socket >> 5)*2] == 0
    readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  REGBUFFER[(socket >> 5)*2] := CR_LISTEN
  writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  repeat until REGBUFFER[(socket >> 5)*2] == 0
    readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
  rtv := REGBUFFER[(socket >> 5)*2]

pub ConnectTCP(socket) : rtv
'' Creates connection on socket
'' Expects socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
'' Returns value in REG_Sn_SR for given socket.

  REGBUFFER[(socket >> 5)*2] := CR_CONNECT
  writereg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
  readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
    repeat until REGBUFFER[(socket >> 5)*2] == 0
       readreg(REG_Sn_CR,socket,1,@REGBUFFER+((socket >> 5)*2))
'  readreg(REG_Sn_SR,socket,1,@REGBUFFER+((socket >> 5)*2))
  rtv := REGBUFFER[(socket >> 5)*2]

pub EstablishTCP(socket,tot) : rtv | ctimeout
'' Establish connection on socket
'' Expects socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
'' Expects timeout timer in ms
'' Returns Sn_IR_TIMEOUT if no connection established
  ctimeout := getms()
  readreg(REG_Sn_IR,socket,1,@REGBUFFER+((socket >> 5)*2))
   repeat until (REGBUFFER[(socket >> 5)*2] & Sn_IR_CON) == Sn_IR_CON || (REGBUFFER[(socket >> 5)*2] & Sn_IR_TIMEOUT) == Sn_IR_TIMEOUT
    readreg(REG_Sn_IR,socket,1,@REGBUFFER+((socket >> 5)*2))
    if ((REGBUFFER[(socket >> 5)*2] & Sn_IR_TIMEOUT) == Sn_IR_TIMEOUT) or ((getms() > ctimeout + tot) & tot >= 1)
      'Timeout(socket)
      rtv := Sn_IR_TIMEOUT
      return(rtv)
  REGBUFFER[(socket >> 5)*2] := Sn_IR_CON
  writereg(REG_Sn_IRCLR,socket,1,@REGBUFFER+((socket >> 5)*2))

pub ReadSIR() : r
'' Reads the Socket Interrupt Register (SIR) — one byte from the common register block.
'' Each bit corresponds to a socket (bit 0 = Socket 0, bit 7 = Socket 7).
'' A set bit indicates that socket has a pending interrupt.
  readreg(REG_SIR, IDM_BSR_Common_Register, 1, @REGBUFFER)
  r := REGBUFFER[0]

pub ReceiveData(socket,tmov) : rtv | tmo
'' Receives Data from socket.
'' Expects:
''  socket: Socket Register from Block Selection. See Con Section. Example: IDM_BSR_Socket6_Register
''  tmov: Number of milliseconds before timing out
'' Returns Sn_IR_TIMEOUT if no data received
'' To actually place data into a buffer, call ReceiveProcess() if
'' Sn_IR_TIMEOUT is *NOT* returned

    tmo := getms()
    RX_RSR[(socket >> 5)] := 0
    repeat until RX_RSR[(socket >> 5)] > 0 or getms() >  tmo + tmov
      readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER+((socket >> 5)*2))
      RX_RSR[(socket >> 5)] := REGBUFFER[(socket >> 5)*2]
      RX_RSR[(socket >> 5)] <<= 8
      RX_RSR[(socket >> 5)] := RX_RSR[(socket >> 5)] + REGBUFFER[((socket >> 5)*2)+1]
    if getms() >  tmo + tmov
       rtv := Sn_IR_TIMEOUT
    'send("TMO: ")
    'vid.dec(tmo)
    'vid.nl()
pub FastReceiveData(socket,tmov) : rtv | tmo , rsr
'' Can't remmber if this works. Not sure why it exists.
''
''
    rsr := readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER+((socket >> 5)*2))
    repeat until rsr > 0
        rsr := readreg(REG_Sn_RX_RSR,socket,2,@REGBUFFER+((socket >> 5)*2))

    RX_RSR[(socket >> 5)] := rsr

pub FastReceiveProcess(socket,rxptr,REGBUFFERTMP) |  i , LADDRL, LADDRH, tmpdata, RB, datapin, REGISTER, BLEN, BS, socket_rd, l_RX_RSR, l_RX_RD, r
