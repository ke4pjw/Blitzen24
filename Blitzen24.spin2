#pragma exportdef SD_INCLUDE_DEFRAG
'#pragma exportdef SD_INCLUDE_REGISTERS
CON
    _xtlfreq = 20_000_000
    _clkfreq = 270_000_000

  PGM_RX   = 63  { I }                                          ' programming / debug
  PGM_TX   = 62  { O }

  ' SD card SPI pins (directly wired to microSD slot)

  SD_MISO = 58   ' was DOPin  — Master In, Slave Out (data FROM card)
  SD_SCK  = 61   ' was CLKPin — Serial Clock
  SD_MOSI = 59   ' was DIPin  — Master Out, Slave In (data TO card)
  SD_CS   = 60   ' was CSPin  — Chip Select

  CS    = 50
  RST   = 52
  DC    = 51
  CLK   = 49
  DATA  = 48

  ENC_B    = 53  { I }                                          ' encoder data
  ENC_A    = 54  { I }                                          ' encoder clock
  ENC_P    = 55  {Button}

  STRUCT nametype(BYTE namefield[32])

  ' Multi-task HTTP listener constants
  MAX_TASKS = 4
  MAX_MSS   = 1460

  ' Input protocols (PROTOCOL)
  PROTO_E131  = 0
  PROTO_DDP   = 1
  E131_PORT   = 5568
  DDP_PORT    = 4048
  DDP_DMX     = 28        ' DDPCONFIG entry index of DMX output 1 (entries 28-31 = DMX 1-4)
  DMX_CH      = 510       ' bytes per DMX buffer
  PIXBUF_SIZE = 73768     ' size of PIXELBUFFER
  DDP_MAXPIX  = (PIXBUF_SIZE - 4 * DMX_CH) / 3   ' pixels that fit with the 4 DMX buffers reserved
  DDP_MAXCH   = 16_777_216                       ' highest DDP start channel accepted

  ' readbuffer: up to two full 2K socket reads (the iOS split-request read, or a Socket 6 manifest read) plus a terminating zero
  STRUCT HTTPD_CTX(byte readbuffer[4096 + 1], byte filepath[256], byte webbuff[8192], long fh, long rdsize, word psize, long mss)

VAR
        long PIXELCONFIG[144]
        long E131CONFIG[432]
        byte MACADDRESS[6]  ' Must be unique per layer 2 network
        byte IPADDRESS[4]
        byte SUBNETMASK[4]
        byte GATEWAY[4]
        byte DHCP 'Non zero
        byte BRIGHTNESS
        byte DNS[4]
        byte SPEEDDUPLEX
        long SCREENTIMEOUT
        long DMXENABLED
        byte HOSTNAME[32]
        nametype OUTPUTNAME[32]
        ' ---- 2.6.1 additions: always append new config variables HERE, just above ENDOFCONFIG. ----
        ' ---- Never move or resize anything above, so older/newer blitzen.cfg files stay compatible. ----
        ' A 2.6.0 file ends before these, so they load as 0 (E1.31, no DDP map); 2.6.0 ignores them.
        long PROTOCOL           ' Input protocol: 0 = E1.31 (port 5568), 1 = DDP (port 4048)
        long DDPCONFIG[64]      ' DDP map, 32 entries x 2 longs: [start channel (1-based, 0 = unused), count]
                                '  entries 0-27  = outputs 1-28 as pixel outputs (count = pixels, 3 channels each)
                                '  entries 28-31 = DMX outputs 1-4 (count = channels, max 510)
        long ENDOFCONFIG ' End of the loadable config
        long DDPLUT[32*3+1]     ' Runtime DDP map for the fast-RX cog (not saved): [bytes, offset, hub addr], 0-terminated
        long ddpdmxbase         ' Runtime: hub address of the 4 DMX buffers in DDP mode (not saved)
        long TXBUFFER[8]
        byte PACKETBUFFER[4098]
        byte PIXELBUFFER[73768]
        byte BADBUFFER[2048]
        byte version
        byte regi[2]
        byte DHCPSERVER[4]
        byte RequestID[4]
        byte DHCPMESSAGETYPE
        byte CHIPID[2]
        byte CHIPVER[2]
        long byteindex
        long readptr
        byte READBUFFER[4096 + 1]   ' two full 2K Socket 6 reads (getURL waits for the end of the HTTP headers) plus a terminating zero
        byte WRITEBUFFER[2024]
        byte REGBUFFER[2]
        BYTE results[255]
        long resp_ptr
        long resp_css_ptr
        long resp_jpg_ptr
        long resp_png_ptr
        long resp_ico_ptr
        long resp_404_ptr
        long req_ptr
        long dhcp_ptr
        long resp_dl_ptr
        word psize
        long elock
        long tPIXELCONFIG[90]
        long tE131CONFIG[432]
        byte eutmp[4]
        byte pcnt[4]
        byte boundary[71]
        byte bgtmp
        long wdcounter
        long wdpps
        long wddiscards
        long wddps
        byte testpixel[28]
        long blinkmode
        long dot
        byte servername[256]
        byte serverip[4]
        byte buildver[256]
        long upgradeserver_ptr
        long savedcrc           ' CRC-32 (GETCRC) of the config block as last loaded/saved; RAM only, not in the config file
        long unsaved            ' TRUE while the running config differs from savedcrc
        byte md51[16]
        byte md52[16]
        byte manifest[64000]
        byte tmpfilepath[256]
        byte tmp2filepath[256]
        long resp_evt_ptr
        long resp_gif_ptr
        long resp_js_ptr
        byte b64md5[256]
        byte MD5DATA[64]
        byte vbuffer[12288]
        long rawptr
        LONG qrversion
        byte url[256]
        long alt
        byte MDNSGRP[8]
        byte MDNSBUFFER[1536]
        ' SIR dispatcher — hub flags set by dispatcher, read by tasks
        byte socket_ready[MAX_TASKS]
        ' Multi-task HTTP listener contexts and stacks
        HTTPD_CTX ctx[MAX_TASKS]
        long task_stack_1[1024]
        long task_stack_2[1024]
        long task_stack_3[1024]
        long watchdogstack[1023] ' Keep this on bottom

OBJ
        sd: "micro_sd_fat32_fs_v180"
        W6100: "W6100drv"
        prng: "jm_prng"
        WS2811: "tt_rgbx_pixel"
        WS28112: "tt_rgbx_pixel"
        WS28113: "tt_rgbx_pixel"
        WS28114: "tt_rgbx_NIBpixel"
        DMX: "tt_dmx_tx"
        str: "jm_strings"
        OLED: "oled_AsmDrv"
        B64: "base64"
        MD5: "MD5"
'        qrssd:     "qrssd"    'Object to display the QR code on an SSD1331.
        qr:     "p2qr"        'Object that creates the QR code.
        qe: "jm_quadraturesmartpin"

PUB main() | i, j, handle, fsize, merr
  str.append_str(@buildver, String("Blitzen 24 Edge 2.6.3 (Rocklin) Dev"))
  resp_ptr     := String("HTTP/1.1 200 OK", $0D, $0A, "Content-Type: text/html", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_css_ptr := String("HTTP/1.1 200 OK", $0D, $0A, "Content-Type: text/css",$0D, $0A, "Cache-Control: max-age=604800", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_jpg_ptr := String("HTTP/1.1 200 OK", $0D, $0A, "Cache-Control: max-age=604800", $0D, $0A,  "Content-Type: image/jpeg", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_png_ptr := String("HTTP/1.1 200 OK", $0D, $0A, "Cache-Control: max-age=604800", $0D, $0A,  "Content-Type: image/png", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_ico_ptr := String("HTTP/1.1 200 OK", $0D, $0A, "Cache-Control: max-age=604800", $0D, $0A,  "Content-Type: image/x-icon", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_404_ptr := String("HTTP/1.1 404 Not Found", $0D, $0A, "Connection: close", $0D, $0A, "Content-Type: text/html", $0D, $0A, $0D, $0A, "<HTML><BODY><H1>Nope, not here.</H2></BODY></HTML>", $0D, $0A)
  resp_dl_ptr  := String("Content-Type: application/octet-stream", $0D, $0A)
  resp_evt_ptr := String("HTTP/1.1 200 OK", $0D, $0A, "Content-Type: text/event-stream", $0D, $0A, "Cache-Control: no-cache", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_gif_ptr := String("HTTP/1.1 200 OK", $0D, $0A, "Cache-Control: max-age=604800", $0D, $0A,  "Content-Type: image/gif", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)
  resp_js_ptr  := String("HTTP/1.1 200 OK", $0D, $0A, "Content-Type: application/javascript", $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A)

  upgradeserver_ptr := String("files.griswoldfx.com")
  dot := String(".")
'  str.append_str(@servername,String("www.parallax.com"))
'  str.append_str(@servername,String("blalblaba.com"))
'  req_ptr      := String("test.htm")
  dhcp_ptr := String("document.getElementById('DHCP').checked = true;", $0D, $0A)


'  SEND := @OLED.TERMSEND
  OLED.Init(CS,DC,DATA,CLK,RST)
  OLED.AutoUpdateOff()
  OLED.clearDisplay()


  debug("Clock Speed: ",udec_(clkfreq) )

  debug("Starting SD driver and mounting filesystem")

  merr := sd.mount(SD_CS, SD_MOSI, SD_MISO, SD_SCK)
  if merr <> 0
     OLED.TERMSEND(STRING("Missing SD Card?", OLED.CR, OLED.LF))
     OLED.TERMSEND(STRING("Mount Error: "))
     OLED.TERMSEND(str.dec(merr,0))
     OLED.TERMSEND(STRING(OLED.CR, OLED.LF))
     Debug("Mount Error: ", udec_(merr))
     repeat
  debug("Config memory Size: ", udec_((@ENDOFCONFIG + 3) - @PIXELCONFIG) )
  debug("Opening config file: ")
  handle := sd.openFileRead(string("blitzen.cfg"))
  if handle >= 0

    debug("Opened")
    fsize := sd.fileSizeHandle(handle)
    debug("Config file Size:", udec_(fsize))
    if (@DMXENABLED + 3) - @PIXELCONFIG > fsize
      debug("V1 Config")
      sd.readHandle(handle, @PIXELCONFIG, 496)
'      debug("Position:", udec_(sd.tellHandle(handle)))
'      sd.seekHandle(handle, sd.tellHandle(handle) + 84)
 '     debug("File Position:", udec_(sd.tellHandle(handle)), " E131 Pos:", udec_(@E131CONFIG-@PIXELCONFIG))
      sd.readHandle(handle, @E131CONFIG, (@DMXENABLED + 3) - @E131CONFIG + 1)
      debug("Position:", udec_(sd.tellHandle(handle)))
      OLED.TERMSEND(STRING("V1 "))
      'Add needed data structures since this is a v1 config.
      i := 0
      repeat 4
        PIXELCONFIG[i * 5 + 120] := i + 25 ' Pin + 25, that way 0 is NULL
        PIXELCONFIG[(i * 5) + 1 + 120] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
        PIXELCONFIG[(i * 5) + 2 + 120] := 800 'Pixel holdoff time
        PIXELCONFIG[(i * 5) + 3 + 120] := @pixelbuffer
        PIXELCONFIG[(i * 5) + 4 + 120] := 0 ' Pixelcount in this pin
        i++

    else
      sd.readHandle(handle, @PIXELCONFIG, (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)
      OLED.TERMSEND(STRING("V2 "))
    if strsize(@hostname) == 0
        str.append_str(@HOSTNAME, String("blitzen-"))
        str.append_str(@HOSTNAME,str.fxhex(MACADDRESS[4],2,0))
        str.append_str(@HOSTNAME,str.fxhex(MACADDRESS[5],2,0))
    sd.closeFileHandle(handle)
    OLED.TERMSEND(STRING("Config Found!", OLED.CR, OLED.LF))
  else
    debug("Failed")
    debug("Zeroing Memory Configuration.")
    bytefill(@PIXELCONFIG, 0, (@ENDOFCONFIG +3) - @PIXELCONFIG + 1)

       'Configure Mac Address
    MACADDRESS[0] := $00 'wiznet don't change
    MACADDRESS[1] := $08 'wiznet don't change
    MACADDRESS[2] := $DC 'wiznet don't change
    MACADDRESS[3] := prng.xrandomize($00,$FF)
    MACADDRESS[4] := prng.xrandomize($00,$FF)
    MACADDRESS[5] := prng.xrandomize($00,$FF)
    debug("Generating MAC Address: ", uhex_(MACADDRESS[0]),":",uhex_(MACADDRESS[1]),":",uhex_(MACADDRESS[2]),":",uhex_(MACADDRESS[3]),":",uhex_(MACADDRESS[4]),":",uhex_(MACADDRESS[5]) )
    str.append_str(@HOSTNAME, String("blitzen-"))
    str.append_str(@HOSTNAME,str.hex(MACADDRESS[4],0))
    str.append_str(@HOSTNAME,str.hex(MACADDRESS[5],0))
    debug("Setting DHCP: True")
    DHCP := 1
    Brightness := 100

    debug("Configuring pixel config.")
    longfill(@PIXELCONFIG,0,124)
    longfill(@E131CONFIG,0,432)

    i := 0
    repeat 24
      PIXELCONFIG[i * 5] := i + 1 ' Pin + 1, that way 0 is NULL
      PIXELCONFIG[(i * 5) + 1] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
      PIXELCONFIG[(i * 5) + 2] := 800 'Pixel holdoff time
      PIXELCONFIG[(i * 5) + 3] := @pixelbuffer
      PIXELCONFIG[(i * 5) + 4] := 0 ' Pixelcount in this pin
      i++
    debug("Set displaytimeout based on hardware version.")
    if HardwareVer() == 1
      SCREENTIMEOUT := 0
    else
      SCREENTIMEOUT := 60

    sd.deleteFile(string("blitzen.cfg"))           ' Remove if exists (ignore error)
    handle := sd.createFileNew(string("blitzen.cfg"))
    if handle >= 0

      debug("Writing Configuration to SD Card.", $0D, $0A)
      sd.writeHandle(handle, @PIXELCONFIG, (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)
      sd.closeFileHandle(handle)
      OLED.TERMSEND(STRING("New config saved.", OLED.CR, OLED.LF))
    else

      debug("Unable to write config. Aborting.", $0D, $0A)
      OLED.TERMSEND(STRING("Config save fail", OLED.CR, OLED.LF))
      OLED.TERMSEND(STRING("Missing SD Card?", OLED.CR, OLED.LF))
      repeat


  str.lcstr(@HOSTNAME)                 ' mDNS compares lowercase; stored name may be uppercase

  ' Init Ethernet
  elock := W6100.initparallel()
  debug("Initialize Ethernet:", uhex_(elock))




  ' ID Chip
  W6100.readreg(W6100.REG_CIDR0,W6100.IDM_BSR_Common_Register,2,@CHIPID)
  debug("Chip Identification: ", uhex_(CHIPID[0])," ",uhex_(CHIPID[1]))


  ' Read Chipver
  W6100.readreg(W6100.REG_VER0,W6100.IDM_BSR_Common_Register,2,@CHIPVER)
  debug("Chip Version: ", uhex_(CHIPVER[0])," ",uhex_(CHIPVER[1]))

  debug("Physical Configuration Unlocked")
  WRITEBUFFER[0] := W6100.SYSR_PHYL
  W6100.writereg(W6100.REG_PHYLCKR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)


  debug("Set physical interface to 10BASETXFDX")
  WRITEBUFFER[0] := SPEEDDUPLEX
  W6100.writereg(W6100.REG_PHYCR0,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)


  WRITEBUFFER[0] := $41
  W6100.writereg(W6100.REG_PHYCR1,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)

  logo()
'  waitms (3000)
'  waitms (3000)


  debug("Physical Configuration Locked")
  WRITEBUFFER[0] := $00
  W6100.writereg(W6100.REG_PHYLCKR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)



  debug("Network Configuration locked.")
  WRITEBUFFER[0] := W6100.SYSR_NETU
  W6100.writereg(W6100.REG_NETLCKR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)

  debug("Set MAC address: ",uhex_(MACADDRESS[0]),":",uhex_(MACADDRESS[1]),":", uhex_(MACADDRESS[2]),":",uhex_(MACADDRESS[3]),":",uhex_(MACADDRESS[4]),":", uhex_(MACADDRESS[5]))

  W6100.writereg(W6100.REG_SHAR0,W6100.IDM_BSR_Common_Register,6,@MACADDRESS)

  debug("Network Configuration locked.")
  WRITEBUFFER[0] := W6100.SYSR_NETU
  W6100.writereg(W6100.REG_NETLCKR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)


  COGSPIN(NEWCOG,watchdogcog(), @watchdogstack)

  debug("Configuring 8 sockets with 2K TX buffer.")
  i := W6100.IDM_BSR_Socket0_Register
  WRITEBUFFER[0] := 2
  repeat 8
    W6100.writereg(W6100.REG_Sn_TX_BSR,i,1,@WRITEBUFFER)
    debug(".")
    i := i + %001_00_000





  debug("Validate TX buffer: ")
  i := W6100.IDM_BSR_Socket0_Register
  repeat 8
    W6100.readreg(W6100.REG_Sn_TX_BSR,i,1,@READBUFFER)
    debug(uhex_(READBUFFER[0],2))
    i := i + %001_00_000


  ' RX buffers (16 KB total): Socket 3 (E1.31/DDP) 4K so two full 1440-byte DDP packets fit;
  ' Socket 0 (DHCP/DNS) and Socket 7 (mDNS) 1K, their packets are small; all others 2K.
  debug("Configuring RX buffers: S3 4K, S0/S7 1K, others 2K.")
  i := W6100.IDM_BSR_Socket0_Register
  repeat 8
    case i
      W6100.IDM_BSR_Socket3_Register: WRITEBUFFER[0] := 4
      W6100.IDM_BSR_Socket0_Register, W6100.IDM_BSR_Socket7_Register: WRITEBUFFER[0] := 1
      other: WRITEBUFFER[0] := 2
    W6100.writereg(W6100.REG_Sn_RX_BSR,i,1,@WRITEBUFFER)
    debug(".")
    i := i + %001_00_000



  debug("Validate RX buffer: ")
  i := W6100.IDM_BSR_Socket0_Register
  repeat 8
    W6100.readreg(W6100.REG_Sn_RX_BSR,i,1,@READBUFFER)
    debug(uhex_(READBUFFER[0],2))
    i := i + %001_00_000

{
  debug("Configure Interrupt for Socket 3")
  WRITEBUFFER[0] := %0000_1000
  W6100.writereg(W6100.REG_SIMR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)

}
  if DHCP
    dhcpclient()
  debug("Network Configuration Unlocked.")
  WRITEBUFFER[0] := $3A
  W6100.writereg(W6100.REG_NETLCKR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)



  WRITEBUFFER[0] := GATEWAY[0]
  WRITEBUFFER[1] := GATEWAY[1]
  WRITEBUFFER[2] := GATEWAY[2]
  WRITEBUFFER[3] := GATEWAY[3]
  debug("Set Gateway address: ", udec_(WRITEBUFFER[0]),".",udec_(WRITEBUFFER[1]),".",udec_(WRITEBUFFER[2]),".",udec_(WRITEBUFFER[3]))
  W6100.writereg(W6100.REG_GAR0,W6100.IDM_BSR_Common_Register,4,@WRITEBUFFER)

  WRITEBUFFER[0] := SUBNETMASK[0]
  WRITEBUFFER[1] := SUBNETMASK[1]
  WRITEBUFFER[2] := SUBNETMASK[2]
  WRITEBUFFER[3] := SUBNETMASK[3]
  debug("Set Subnet: ", udec_(WRITEBUFFER[0]),".",udec_(WRITEBUFFER[1]),".",udec_(WRITEBUFFER[2]),".",udec_(WRITEBUFFER[3]))
  W6100.writereg(W6100.REG_SUBR0,W6100.IDM_BSR_Common_Register,4,@WRITEBUFFER)


  WRITEBUFFER[0] := IPADDRESS[0]
  WRITEBUFFER[1] := IPADDRESS[1]
  WRITEBUFFER[2] := IPADDRESS[2]
  WRITEBUFFER[3] := IPADDRESS[3]
  debug("Set IP Address: ", udec_(WRITEBUFFER[0]),".",udec_(WRITEBUFFER[1]),".",udec_(WRITEBUFFER[2]),".",udec_(WRITEBUFFER[3]))
  W6100.writereg(W6100.REG_SIPR0,W6100.IDM_BSR_Common_Register,4,@WRITEBUFFER)

  debug("Network Configuration locked.")
  WRITEBUFFER[0] := $C5
  W6100.writereg(W6100.REG_NETLCKR,W6100.IDM_BSR_Common_Register,1,@WRITEBUFFER)



  debug("System Status Register: ", uhex_(W6100.readreg(W6100.REG_SYSR,W6100.IDM_BSR_Common_Register,1,@READBUFFER)))

  debug("Configuring pixel config.")
  ConfigPixels()
  StartPixels()
  markconfigsaved()    ' Baseline: config loaded and applied, DHCP done

{
This is here to show what the data structure looks like.

  PIXELCONFIG[0] := 1 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[1] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[2] := 800 'Pixel holdoff time
  PIXELCONFIG[3] := @pixelbuffer
  PIXELCONFIG[4] := 0 ' Pixelcount in this pin

  PIXELCONFIG[5] := 2 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[6] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[7] := 800 'Pixel holdoff time
  PIXELCONFIG[8] := @pixelbuffer
  PIXELCONFIG[9] := 0 ' Pixelcount in this pin

  PIXELCONFIG[10] := 3 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[11] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[12] := 800 'Pixel holdoff time
  PIXELCONFIG[13] := @pixelbuffer
  PIXELCONFIG[14] := 0 ' Pixelcount in this pin

  PIXELCONFIG[15] := 4 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[16] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[17] := 800 'Pixel holdoff time
  PIXELCONFIG[18] := @pixelbuffer
  PIXELCONFIG[19] := 0 ' Pixelcount in this pin

  PIXELCONFIG[20] := 5 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[21] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[22] := 800 'Pixel holdoff time
  PIXELCONFIG[23] := @pixelbuffer
  PIXELCONFIG[24] := 0 ' Pixelcount in this pin

  PIXELCONFIG[25] := 6 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[26] := %%3120 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[27] := 800 'Pixel holdoff time
  PIXELCONFIG[28] := @pixelbuffer
  PIXELCONFIG[29] := 0 ' Pixelcount in this pin

  PIXELCONFIG[30] := 7 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[31] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[32] := 800 'Pixel holdoff time
  PIXELCONFIG[33] := @pixelbuffer
  PIXELCONFIG[34] := 0 ' Pixelcount in this pin

  PIXELCONFIG[35] := 8 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[36] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[37] := 800 'Pixel holdoff time
  PIXELCONFIG[38] := @pixelbuffer
  PIXELCONFIG[39] := 0 ' Pixelcount in this pin

  PIXELCONFIG[40] := 9 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[41] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[42] := 800 'Pixel holdoff time
  PIXELCONFIG[43] := @pixelbuffer
  PIXELCONFIG[44] := 0 ' Pixelcount in this pin

  PIXELCONFIG[45] := 10 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[46] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[47] := 800 'Pixel holdoff time
  PIXELCONFIG[48] := @pixelbuffer
  PIXELCONFIG[49] := 0 ' Pixelcount in this pin

  PIXELCONFIG[50] := 11 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[51] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[52] := 800 'Pixel holdoff time
  PIXELCONFIG[53] := @pixelbuffer
  PIXELCONFIG[54] := 0 ' Pixelcount in this pin

  PIXELCONFIG[55] := 12 ' Pin + 1, that way 0 is NULL
  PIXELCONFIG[56] := %%0123 ' Pixel Color order. In this case BB_RR_GG_WW
  PIXELCONFIG[57] := 800 'Pixel holdoff time
  PIXELCONFIG[58] := @pixelbuffer
  PIXELCONFIG[59] := 0 ' Pixelcount in this pin
 }
