pub watchdogcog() | time1,time2,lt, t, ev, last, now, check, counts, p, c, dnscounter
 OLED.clearDisplay()
 alt := false
 time1 := GETCT()
 lt := 0
 org
 WRPIN ##$00000900, 53
 WRPIN ##$00000900, 54
 WRPIN ##$00000900, 55
 end

 qe.start(54, 53, 55, TRUE, 1, 1, 3)
 last := 1
 repeat
    lt++
    if SCREENTIMEOUT <> 0 and lt > SCREENTIMEOUT
      OLED.ssd1331_command(OLED.SSD1331_CMD_DISPLAYOFF)
 ' Set E1.31 Packets/s
    wdpps :=  W6100.Counter() - wdcounter     ' Calculate E1.31 packets/sec
    wddps :=  W6100.Discards() - wddiscards   ' Calculate E1.31 discarded packets/sec

' Update counters
    wdcounter := W6100.Counter()
    wddiscards := W6100.Discards()

    if blinkmode == true
      if alt == true
        p := 0
        repeat 28

          if testpixel[p] > 0
            if testpixel[p] == 4
              c:= 0
            else
              c:= testpixel[p] - 1
            repeat PIXELCONFIG[p * 5 + 4]

              PIXELBUFFER[PIXELCONFIG[(p * 5) + 3] - @PIXELBUFFER + c]  := 255
              if testpixel[p] == 4
                PIXELBUFFER[PIXELCONFIG[(p * 5) + 3] - @PIXELBUFFER + c + 1]  := 255
                PIXELBUFFER[PIXELCONFIG[(p * 5) + 3] - @PIXELBUFFER + c + 2]  := 255

              c := c + 3
          p := p + 1
        alt := false
      else
        bytefill(@pixelbuffer,0,73768)
        alt := true

'    qrcodemenu()
    case last
     1: statsmenu()
     2: qrcodemenu()
     3: vermenu()

    time1 := GETSEC()
    repeat while time1 == GETSEC()
      waitms(20)
      if qe.button(5) == 1
          OLED.ssd1331_command(OLED.SSD1331_CMD_DISPLAYON)
          lt := 0
      now := qe.value()                    ' re-sample encoder inputs
      if (now <> last)
          OLED.clearDisplay()
          OLED.ssd1331_command(OLED.SSD1331_CMD_DISPLAYON)
          last := now
          lt := 0
          quit

'            if (pinr(ENC_P) == 0)                                         ' Set to 0 if you push the button
'                long[@qecounts] := 0
'                counts := 0


{    ' Wait 1 second
    time2 := (GETCT() - time1) / (CLKFREQ / 1_000_000)

    waitus(1_000_000 - time2)
    time1 := GETCT()
}
'    debug(zstr_(String("Updated")))
'    OLED.HEX(bgtmp[0],2)
pub qrcodemenu()
    url[0] := 0
    str.append_str(@url,string("http://"))
    str.append_str(@url,str.dec(IPADDRESS[0],3))
    str.append_str(@url,string("."))
    str.append_str(@url,str.dec(IPADDRESS[1],3))
    str.append_str(@url,string("."))
    str.append_str(@url,str.dec(IPADDRESS[2],3))
    str.append_str(@url,string("."))
    str.append_str(@url,str.dec(IPADDRESS[3],3))
    rawptr := qr.getimage()  ' Get the image pointer
    qr.parseMessage(@url,qr.TYPE_RAW,0)
    setversion(qr.getqrversion())
    displayqr(rawptr,OLED.WHITE,OLED.BLACK) 'Display the image.
pub vermenu(): time
    time := getsec()
    OLED.TERMPOSY(0)
    OLED.TERMPOSX(0)
    OLED.SETFG(OLED.White)
    OLED.TERMSEND(@buildver)
    OLED.TERMSEND(String(OLED.CR, OLED.LF))
    OLED.TERMSEND(String(OLED.CR, OLED.LF))
    OLED.TERMSEND(string("Uptime:",OLED.CR, OLED.LF))
    OLED.TERMSEND(str.dec(time / 86400,0))
    OLED.TERMSEND(String(":"))
    OLED.TERMSEND(str.rjdec(time // 86400 / 3600,2,"0",0))
    OLED.TERMSEND(String(":"))
    OLED.TERMSEND(str.rjdec(time // 3600 / 60,2,"0",0))
    OLED.TERMSEND(String(":"))
    OLED.TERMSEND(str.rjdec(time // 60,2,"0",0))
    OLED.TERMSEND(String(OLED.CR, OLED.LF))
    OLED.TERMSEND(String(OLED.CR, OLED.LF))
    OLED.TERMSEND(string("Speed/Dpx:"))
    CASE SPEEDDUPLEX
        0: OLED.TERMSEND(string("Auto",OLED.CR, OLED.LF))
        4: OLED.TERMSEND(string("100F",OLED.CR, OLED.LF))
        5: OLED.TERMSEND(string("100H",OLED.CR, OLED.LF))
        6: OLED.TERMSEND(string("10F",OLED.CR, OLED.LF))
        7: OLED.TERMSEND(string("10H",OLED.CR, OLED.LF))


pub statsmenu()| p,c
    W6100.readreg(W6100.REG_PHYSR,W6100.IDM_BSR_Common_Register,1,@bgtmp)
    OLED.TERMPOSY(0)
    OLED.TERMPOSX(0)
    OLED.SETFG(OLED.White)
    OLED.TERMSEND(string("Blitzen 24"))
'    OLED.TERMPOSX(12)
'    OLED.SETFG(OLED.Red)
'    OLED.TERMSEND(string($81))
'    OLED.TERMPOSX(14)
'    OLED.TERMSEND(string($80))


    OLED.TERMPOSY(6)
    OLED.TERMPOSX(0)

    OLED.TERMSEND(string("MAC Address:", OLED.CR, OLED.LF))
    OLED.hex(MACADDRESS[0],2)
    OLED.hex(MACADDRESS[1],2)
    OLED.hex(MACADDRESS[2],2)
    OLED.hex(MACADDRESS[3],2)
    OLED.hex(MACADDRESS[4],2)
    OLED.hex(MACADDRESS[5],2)

'    debug (uhex(PIXELCONFIG[80] + 15))
' Ethernet Status
    if (bgtmp & 1) == 0
        OLED.SETFG(OLED.Yellow)
    If (bgtmp & 128) == 128
        OLED.SETFG(OLED.Red)
    if (bgtmp & 1) == 1
        OLED.SETFG(OLED.Green)
    OLED.TERMPOSY(0)
    OLED.TERMPOSX(14)
    OLED.TERMSEND(string($80))
    OLED.SETFG(OLED.White)
    OLED.TERMPOSX(12)
' E1.31 Status
    if wdpps > 0
      OLED.SETFG(OLED.Green)
    else
      OLED.SETFG(OLED.Red)
    if wddps > 0 or blinkmode == true
      OLED.SETFG(OLED.Yellow)
    OLED.TERMSEND(string($81))
    OLED.SETFG(OLED.White)


' Counters on the OLED
    OLED.TERMPOSY(1)
    OLED.TERMPOSX(0)
    OLED.dec(wddps)
    OLED.TERMSEND(String(" drops/sec"))
    OLED.TERMPOSY(2)
    OLED.TERMPOSX(0)
    OLED.dec(wdpps)
    OLED.TERMSEND(String(" decodes/sec"))
' Update IP Address
    OLED.TERMPOSY(3)
    OLED.TERMPOSX(0)
    OLED.TERMSEND(string("IP Address:", OLED.CR, OLED.LF))
    OLED.DEC(IPADDRESS[0])
    OLED.TERMCHR(".")
    OLED.DEC(IPADDRESS[1])
    OLED.TERMCHR(".")
'  OLED.TERMSEND( string($0D, $0A))
    OLED.DEC(IPADDRESS[2])
    OLED.TERMCHR(".")
    OLED.DEC(IPADDRESS[3])

    if blinkmode == true
      if alt == false
        OLED.TERMPOSX(12)
        OLED.TERMPOSY(0)
        OLED.SETFG(OLED.Black)
        OLED.TERMSEND(string($81))
        OLED.SETFG(OLED.White)


pub ConfigPixels() |  pixelcount, pixeloffset, i, ei

  if PROTOCOL == PROTO_DDP
    ConfigPixelsDDP()   ' DDP layout; E131CONFIG is not touched
    return

  pixeloffset := 0
  i := 0
  ei := 0
  ' Do this loop until there are no more pins.
  repeat until PIXELCONFIG[i] == 0
    ' Reset the pixel count
    pixelcount :=  0
    ' Assign the staring point in hubram for this output's pixel data.
    PIXELCONFIG[i+3] := pixeloffset + @pixelbuffer
       ' Do this loop until the E1.31 pin is not equal to the pixel output pin.
       repeat until E131CONFIG[ei] <> PIXELCONFIG[i]
          if E131CONFIG[ei] == PIXELCONFIG[i]
               ' Assign the pixelbuffer to the universe.
               E131CONFIG[ei+3] := pixeloffset + @pixelbuffer
               ' Update the pixeloffset to the next location
               pixeloffset := pixeloffset + (E131CONFIG[ei+2] * 3) 'Probably going to need to change this for RGBW
               ' Update the pixelcount to the new value.
               pixelcount := pixelcount + E131CONFIG[ei+2]
          ' Increment ie to the next record in the E1.31 config.
          ei := ei + 4
    ' Set the total pixelcount for this output pin.
    PIXELCONFIG[i + 4] := pixelcount

    debug("Pin: ", udec_(PIXELCONFIG[i]))
'    waitms(500)
    ' Increment i to the next record in the pixelconfig.
    i := i + 5
  ' Reserve the last 4 E131CONFIG slots for DMX
  Repeat 4
    E131CONFIG[ei+3] := pixeloffset + @pixelbuffer
    pixeloffset := pixeloffset + 510
    ei := ei + 4

pub ConfigPixelsDDP() | pixeloffset, i, o, e, start, cnt
'' DDP layout. Each pixel output gets its own packed slice of PIXELBUFFER (so gaps
'' in the channel map cost no buffer space), followed by the 4 DMX buffers.
'' Builds DDPLUT for the fast-RX cog. Reads DDPCONFIG only; never writes E131CONFIG.

  pixeloffset := 0
  e := 0
  i := 0
  repeat until PIXELCONFIG[i] == 0 or i >= 140
    o := PIXELCONFIG[i] - 1                     ' output index 0-27
    start := DDPCONFIG[o * 2]
    cnt := DDPCONFIG[o * 2 + 1]
    if start == 0 or start > DDP_MAXCH or (o >= 24 and DMXENABLED == 1)
      cnt := 0                                  ' unused, or outputs 25-28 serving DMX
    cnt := cnt <# (DDP_MAXPIX - pixeloffset / 3) ' never overrun the buffer
    PIXELCONFIG[i + 3] := pixeloffset + @pixelbuffer
    PIXELCONFIG[i + 4] := cnt
    if cnt > 0
      DDPLUT[e] := cnt * 3
      DDPLUT[e + 1] := start - 1
      DDPLUT[e + 2] := pixeloffset + @pixelbuffer
      e := e + 3
    pixeloffset := pixeloffset + (cnt * 3)
    debug("DDP pin: ", udec_(o + 1), " start ", udec_(start), " pixels ", udec_(cnt))
    i := i + 5

  ddpdmxbase := pixeloffset + @pixelbuffer
  if DMXENABLED == 1
    repeat o from 0 to 3
      start := DDPCONFIG[(DDP_DMX + o) * 2]
      if start > 0 and start <= DDP_MAXCH       ' a DMX output always takes 510 channels
        DDPLUT[e] := DMX_CH
        DDPLUT[e + 1] := start - 1
        DDPLUT[e + 2] := ddpdmxbase + (o * DMX_CH)
        e := e + 3
  DDPLUT[e] := 0                                ' end of table

pub ddpempty() : r | o
'' True if no DDP output has a count (a 2.6.0 config, or DDP never set up).
  r := true
  repeat o from 0 to 31
    if DDPCONFIG[o * 2 + 1] <> 0
      return false

pub seedddp() | o, ei, ch, px, d
'' Fill an empty DDP map from the current E1.31 layout, so switching to DDP keeps
'' the same pixels on each output. Outputs are laid out back to back from channel 1.
'' E131CONFIG is only read.
  longfill(@DDPCONFIG, 0, 64)
  ch := 1
  repeat o from 0 to 27
    if o >= 24 and DMXENABLED == 1
      next                                      ' outputs 25-28 are DMX; seeded below
    px := 0
    ei := 0
    repeat until E131CONFIG[ei] == 0 or ei >= 432
      if E131CONFIG[ei] == o + 1
        px := px + E131CONFIG[ei + 2]
      ei := ei + 4
    if px > 0
      DDPCONFIG[o * 2] := ch
      DDPCONFIG[o * 2 + 1] := px
      ch := ch + (px * 3)
  if DMXENABLED == 1
    d := 0
    ei := 0
    repeat until E131CONFIG[ei] == 0 or ei >= 432 or d > 3
      if E131CONFIG[ei] == 25                   ' each output-25 universe feeds one DMX output
        DDPCONFIG[(DDP_DMX + d) * 2] := ch
        DDPCONFIG[(DDP_DMX + d) * 2 + 1] := DMX_CH
        ch := ch + DMX_CH
        d++
      ei := ei + 4

pub openrx()
'' (Re)open Socket 3 on the port for the current input protocol.
  W6100.Close(W6100.IDM_BSR_Socket3_Register)
  if PROTOCOL == PROTO_DDP
    W6100.Open(DDP_PORT, W6100.PM_UDP4, W6100.IDM_BSR_Socket3_Register)
  else
    W6100.Open(E131_PORT, W6100.PM_UDP4, W6100.IDM_BSR_Socket3_Register)

pub startrx()
'' Start the fast-RX cog for the current input protocol.
  if PROTOCOL == PROTO_DDP
    W6100.startfastrx(W6100.IDM_BSR_Socket3_Register, @pixelbuffer, @TXBUFFER, @DDPLUT, PROTO_DDP)
  else
    W6100.startfastrx(W6100.IDM_BSR_Socket3_Register, @pixelbuffer, @TXBUFFER, @E131CONFIG, PROTO_E131)

pub reloadoutputs()
'' Rebuild the pixel layout and restart the pixel drivers, then restart the
'' fast-RX cog if it was running (not in pixel-test blink mode).
  ConfigPixels()
  StopPixels()
  StartPixels()
  if blinkmode <> true and W6100.e131cognum() <> 0
    W6100.stopfastrx()
    startrx()

pub setprotocol(newp)
'' Switch the input protocol. E131CONFIG and DDPCONFIG are both kept as they are;
'' an empty DDP map is seeded from the E1.31 layout the first time DDP is chosen.
  if newp <> PROTO_DDP
    newp := PROTO_E131
  if newp == PROTOCOL
    return
  if newp == PROTO_DDP and ddpempty()
    seedddp()
  W6100.stopfastrx()
  PROTOCOL := newp
  bytefill(@pixelbuffer, 0, PIXBUF_SIZE)
  ConfigPixels()
  StopPixels()
  StartPixels()
  openrx()
  if blinkmode <> true
    startrx()

pub httpd(port,PM,socket) | t, i, sir, sockbit, firstopen

  t := TASKID()
  sockbit := 1 << (socket >> 5)  ' SIR bit for this task's socket
  firstopen := true

repeat
  ' First time: full Open + ListenTCP. After that: fast ReopenTCP.
  if firstopen
    W6100.Open(port,PM,socket)
    if W6100.ListenTCP(socket) <> W6100.SOCK_LISTEN
      debug("Socket Listener failed!")
      Return
    firstopen := false
  else
    W6100.ReopenTCP(socket)

  ' Clear any stale interrupts before entering dispatcher loop
  ctx[t].readbuffer[0] := $FF
  W6100.writereg(W6100.REG_Sn_IRCLR, socket, 1, @ctx[t].readbuffer)

  ' Clear our ready flag
  socket_ready[t] := 0

  ' Main loop — single SIR read dispatches all sockets, yield to other tasks
  repeat
        ' Every task reads SIR on its turn — still just 1 bus transaction per task
        sir := W6100.ReadSIR()
        if sir & sockbit                   ' Our own socket has activity
          socket_ready[t] := 1
        if t == 0                          ' Task 0 also dispatches for other tasks
          if sir & %0000_0100              ' Socket 2 → Task 1
            socket_ready[1] := 1
          if sir & %0010_0000              ' Socket 5 → Task 2
            socket_ready[2] := 1
          if sir & %0001_0000              ' Socket 4 → Task 3
            socket_ready[3] := 1
          if sir & %1000_0000              ' Socket 7 → mDNS
            mdnscheck()
        ' Check our flag — if set, confirm the connection
        if socket_ready[t]
          socket_ready[t] := 0
          if W6100.EstablishTCP(socket, 1) <> W6100.Sn_IR_TIMEOUT
            quit
        TASKNEXT()
  W6100.writereg(W6100.REG_Sn_IRCLR, socket, 1, @ctx[t].readbuffer)
  W6100.readreg(W6100.REG_Sn_DIPR,socket,4,@ctx[t].readbuffer)
    ' Get MSS for this socket
  W6100.readreg(W6100.REG_Sn_MSSR, socket, 2, @ctx[t].mss)
  BYTESWAP(@ctx[t].mss, @ctx[t].mss+1, 1)

      If (W6100.ReceiveData(socket,100) <> W6100.Sn_IR_TIMEOUT)
        ctx[t].psize := W6100.ReceiveProcess(socket,@ctx[t].readbuffer)
        If ( W6100.ReceiveData(socket,100) <> W6100.Sn_IR_TIMEOUT and ctx[t].readbuffer[ctx[t].psize-1] == $0A) 'Complete hack to support IOS
            ctx[t].psize := ctx[t].psize + W6100.ReceiveProcess(socket,@ctx[t].readbuffer+ctx[t].psize)
        ctx[t].readbuffer[ctx[t].psize] := 0

    '    debug("Packet Length: ", udec_(ctx[t].psize))
    '    debug("Start Filename: ",udec_(str.instr(@ctx[t].readbuffer,string("GET /"))+5))
    '    debug("End Filename: ", udec_(str.instr(@ctx[t].readbuffer,string("HTTP/1.1"))-1))

        ctx[t].readbuffer[2000] := 0
        if str.instr(@ctx[t].readbuffer,string("HTTP/1.1")) <> -1 and (str.instr(@ctx[t].readbuffer,string("GET /")) <> -1  or str.instr(@ctx[t].readbuffer,string("POST /")) <> -1  ) and (str.instr(@ctx[t].readbuffer,string("HTTP/1.1")) > str.instr(@ctx[t].readbuffer,string("GET /")) or str.instr(@ctx[t].readbuffer,string("HTTP/1.1")) > str.instr(@ctx[t].readbuffer,string("POST /")))
           bytefill(@ctx[t].filepath,0,25)

            if str.instr(@ctx[t].readbuffer,string("GET /")) <> -1
              str.mid(@ctx[t].filepath, @ctx[t].readbuffer, str.instr(@ctx[t].readbuffer,string("GET /"))+5, (str.instr(@ctx[t].readbuffer,string("HTTP/1.1"))) - (str.instr(@ctx[t].readbuffer,string("GET /"))) - 6 )
           '  Set filename to all uppercase
              str.ucstr(@ctx[t].filepath)

             ' Save config if token is in GET request
              if str.instr(@ctx[t].filepath,string("?SAVE=Y")) <> -1
                  writeconfig()

            else

              str.mid(@ctx[t].filepath, @ctx[t].readbuffer, str.instr(@ctx[t].readbuffer,string("POST /"))+6, (str.instr(@ctx[t].readbuffer,string("HTTP/1.1"))) - (str.instr(@ctx[t].readbuffer,string("POST /"))) - 7 )
            ' Set filename to all uppercase
              str.ucstr(@ctx[t].filepath)
              if str.instr(@ctx[t].filepath,string("NET.HTM")) <> -1
                netpost()
              if str.instr(@ctx[t].filepath,string("E131.HTM")) <> -1
                e131post()
              if str.instr(@ctx[t].filepath,string("DMX.HTM")) <> -1
                ' dmx.htm submits its DDP fields (DS1..DS4) only in DDP mode, universes only in E1.31 mode
                if str.instr(@ctx[t].readbuffer,string("DS1=")) <> -1
                  ddpdmxpost()
                else
                  e131post()
              if str.instr(@ctx[t].filepath,string("DDP.HTM")) <> -1
                ddppost()
              if str.instr(@ctx[t].filepath,string("CONFIGS.HTM")) <> -1
                configspost(socket)
              if str.instr(@ctx[t].filepath,string("OUTPUTS.HTM")) <> -1
                outputspost()
              if str.instr(@ctx[t].filepath,string("UPGRADE.HTM")) <> -1
                upgradepost()
              checkunsaved()   ' Any POST may have changed the running config

    '       debug("Filename: ", zstr_(@ctx[t].filepath))

            ' Set default document
           if (str.instr(@ctx[t].readbuffer,string("HTTP/1.1"))-1) == 5
               ctx[t].filepath[0] := 0
               str.append_str(@ctx[t].filepath,string("index.htm"))

           if str.instr(@ctx[t].filepath,string("STATS.JS")) == 0
             ctx[t].fh := -1                          ' Home page stats poll: built in RAM, skip the SD lookup
           else
             ctx[t].fh := sd.openFileRead(@ctx[t].filepath)
           if ctx[t].fh >= 0

                ' Default response header
                ctx[t].rdsize :=  strsize(resp_ptr)
                bytemove(@ctx[t].webbuff,resp_ptr,ctx[t].rdsize)

                ' Other MIME Type Response headers
                if str.instr(@ctx[t].filepath,string(".JPG")) == (strsize(@ctx[t].filepath) - 4)
                  ctx[t].rdsize :=  strsize(resp_jpg_ptr)
                  bytemove(@ctx[t].webbuff,resp_jpg_ptr,ctx[t].rdsize)

                if str.instr(@ctx[t].filepath,string(".ICO")) == (strsize(@ctx[t].filepath) - 4)
                  ctx[t].rdsize :=  strsize(resp_ico_ptr)
                  bytemove(@ctx[t].webbuff,resp_ico_ptr,ctx[t].rdsize)

                if str.instr(@ctx[t].filepath,string(".PNG")) == (strsize(@ctx[t].filepath) - 4)
                  ctx[t].rdsize :=  strsize(resp_png_ptr)
                  bytemove(@ctx[t].webbuff,resp_png_ptr,ctx[t].rdsize)

                if str.instr(@ctx[t].filepath,string(".CSS")) == (strsize(@ctx[t].filepath) - 4)
                  ctx[t].rdsize :=  strsize(resp_css_ptr)
                  bytemove(@ctx[t].webbuff,resp_css_ptr,ctx[t].rdsize)

                if str.instr(@ctx[t].filepath,string(".CFG")) == (strsize(@ctx[t].filepath) - 4)
                  ctx[t].webbuff[0] := 0
                  str.append_str(@ctx[t].webbuff, string("HTTP/1.1 200 OK", $0D, $0A))
                  str.append_str(@ctx[t].webbuff,resp_dl_ptr)
                  str.append_str(@ctx[t].webbuff, string("Content-Disposition: attachment; filename=", $22))
                  str.append_str(@ctx[t].webbuff, @HOSTNAME)
                  str.append_str(@ctx[t].webbuff, string("-boot.cfg", $22, $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A))
                  ctx[t].rdsize :=  strsize(@ctx[t].webbuff)

                if str.instr(@ctx[t].filepath,string(".GIF")) == (strsize(@ctx[t].filepath) - 4)
                  ctx[t].rdsize :=  strsize(resp_gif_ptr)
                  bytemove(@ctx[t].webbuff,resp_gif_ptr,ctx[t].rdsize)

                if str.instr(@ctx[t].filepath,string(".JS")) == (strsize(@ctx[t].filepath) - 3)
                  ctx[t].rdsize :=  strsize(resp_js_ptr)
                  bytemove(@ctx[t].webbuff,resp_js_ptr,ctx[t].rdsize)

                ' Send header in chunks
                i := 0
                repeat until ctx[t].rdsize <= ctx[t].mss
                  W6100.SendData(socket, @ctx[t].webbuff+i, ctx[t].mss)
                  TASKNEXT()
                  i := i + ctx[t].mss
                  ctx[t].rdsize := ctx[t].rdsize - ctx[t].mss
                if ctx[t].rdsize > 0
                  W6100.SendData(socket, @ctx[t].webbuff+i, ctx[t].rdsize)
                  TASKNEXT()

                ' Stream file body from SD in MSS-sized chunks
                Repeat until sd.tellHandle(ctx[t].fh) == sd.fileSizeHandle(ctx[t].fh) or W6100.isdisconnected(socket) == True
                  if sd.fileSizeHandle(ctx[t].fh) - sd.tellHandle(ctx[t].fh) > ctx[t].mss
                    sd.readHandle(ctx[t].fh, @ctx[t].webbuff, ctx[t].mss)
                    W6100.SendData(socket, @ctx[t].webbuff, ctx[t].mss)
                  else
                    ctx[t].rdsize := sd.fileSizeHandle(ctx[t].fh) - sd.tellHandle(ctx[t].fh)
                    sd.readHandle(ctx[t].fh, @ctx[t].webbuff, ctx[t].rdsize)
                    W6100.SendData(socket, @ctx[t].webbuff, ctx[t].rdsize)
                  TASKNEXT()
                sd.closeFileHandle(ctx[t].fh)
           else
                if str.instr(@ctx[t].filepath,string(".JS")) <> -1
                   bytemove(@ctx[t].webbuff,resp_404_ptr,strsize(resp_404_ptr))
                   ctx[t].rdsize :=  strsize(resp_404_ptr)
                   if str.instr(@ctx[t].filepath,string("STATS.JS")) == 0
                      statsjs()
                   if str.instr(@ctx[t].filepath,string("COUNTERS.JS")) <> -1
                      countersjs()
                      'This is here as an easy way to trigger a DNS lookup when testing.
                      'dnsresolver(@servername)
                   if str.instr(@ctx[t].filepath,string("NET.JS")) <> -1
                      netjs()
                   if str.instr(@ctx[t].filepath,string("E131.JS")) <> -1
                      e131js()
                   if str.instr(@ctx[t].filepath,string("DDP.JS")) <> -1
                      ddpjs()
                   if str.instr(@ctx[t].filepath,string("OUTPUT.JS")) <> -1
                      outputjs()
                   if str.instr(@ctx[t].filepath,string("CONFIG.JS")) <> -1
                      configjs()
                   if str.instr(@ctx[t].filepath,string("UPGRADE.JS")) <> -1
                      upgradejs()
                   if str.instr(@ctx[t].filepath,string("UPGRADERUN.JS")) <> -1
                      upgraderun(socket)
                   if str.instr(@ctx[t].filepath,string("REBOOT.JS")) <> -1
                      rebootjs()
                   ' Every page's firmware-generated script carries the unsaved banner
                   if unsaved and str.instr(@ctx[t].filepath,string("STATS.JS")) <> 0 and str.instr(@ctx[t].filepath,string("UPGRADERUN.JS")) == -1 and str.instr(@ctx[t].webbuff,string("404 Not Found")) == -1
                      unsavedbanner()
                else
                   if str.instr(@ctx[t].filepath,string("RUNNINGCONFIG.CFG")) <> -1
                      downloadconfig()
                   else

                      bytemove(@ctx[t].webbuff,resp_404_ptr,strsize(resp_404_ptr))
                      ctx[t].rdsize :=  strsize(resp_404_ptr)
                ' Send dynamic/404 response in MSS chunks
                ctx[t].webbuff[ctx[t].rdsize] := 0
                i := 0
                repeat until ctx[t].rdsize <= ctx[t].mss
                   W6100.SendData(socket,@ctx[t].webbuff+i,ctx[t].mss)
                   TASKNEXT()
                   i := i + ctx[t].mss
                   ctx[t].rdsize := ctx[t].rdsize - ctx[t].mss
                if ctx[t].rdsize > 0
                  W6100.SendData(socket,@ctx[t].webbuff+i,ctx[t].rdsize)

           W6100.Disconnect(socket)


pub netpost() | t

  t := TASKID()
        ' Get the output name
     if str.instr(@ctx[t].readbuffer,string("HOSTNAME=")) <> -1
       strcopy(@tmpfilepath, @ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("HOSTNAME="))+9, str.instr(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("HOSTNAME="))+9,string("&")))
       bytefill(@HOSTNAME, 0, 32)                  ' Clear the whole field: no leftover bytes from a longer name
       URLDecode(@tmpfilepath,@HOSTNAME)
       tmpfilepath[0] := 0 ' Zero out the tmp string. tmpfilepath is used because it is available.
     else
       str.append_str(@HOSTNAME, String("blitzen-"))
       str.append_str(@HOSTNAME,str.hex(MACADDRESS[4],0))
       str.append_str(@HOSTNAME,str.hex(MACADDRESS[5],0))
     str.lcstr(@HOSTNAME)
     if str.instr(@ctx[t].readbuffer,string("DHCP=1")) <> -1
        DHCP := 1
     else
        DHCP := 0

    IPADDRESS[0] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("IPADDRESS0="))+ 11, 3)
    IPADDRESS[1] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("IPADDRESS1="))+ 11, 3)
    IPADDRESS[2] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("IPADDRESS2="))+ 11, 3)
    IPADDRESS[3] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("IPADDRESS3="))+ 11, 3)

    SUBNETMASK[0] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("SUBNETMASK0="))+ 12, 3)
    SUBNETMASK[1] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("SUBNETMASK1="))+ 12, 3)
    SUBNETMASK[2] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("SUBNETMASK2="))+ 12, 3)
    SUBNETMASK[3] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("SUBNETMASK3="))+ 12, 3)

    GATEWAY[0] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("GATEWAY0="))+ 9, 3)
    GATEWAY[1] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("GATEWAY1="))+ 9, 3)
    GATEWAY[2] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("GATEWAY2="))+ 9, 3)
    GATEWAY[3] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("GATEWAY3="))+ 9, 3)

    DNS[0] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("DNS0="))+ 5, 3)
    DNS[1] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("DNS1="))+ 5, 3)
    DNS[2] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("DNS2="))+ 5, 3)
    DNS[3] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("DNS3="))+ 5, 3)

    SPEEDDUPLEX := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("SD="))+ 3, 1)
    SCREENTIMEOUT := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("DTO="))+ 4, 5)
    writeconfig()

pub writeconfig() | handle, written

    sd.deleteFile(string("blitzen.cfg"))           ' Delete existing (ignore error if not found)
    handle := sd.createFileNew(string("blitzen.cfg"))
    if handle >= 0

      debug("Writing Configuration to SD Card.", $0D, $0A)
      written := sd.writeHandle(handle, @PIXELCONFIG, (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)
      if sd.closeFileHandle(handle) == sd.SUCCESS and written == (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1
        markconfigsaved()                          ' Only a complete write becomes the new baseline
      else
        debug("Config write incomplete; still unsaved.", $0D, $0A)
        checkunsaved()

    else

      debug("Unable to write config. Aborting.", $0D, $0A)
      abort
pub configspost(socket) | t, length, startpoint, datarxed, bpos, qc, cpysize
    t := TASKID()
    boundary[0] := 0

    if str.instr(@ctx[t].readbuffer,string("boundary=")) <> -1
      str.mid(@boundary, @ctx[t].readbuffer, str.instr(@ctx[t].readbuffer,string("boundary="))+9, (str.instr(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("boundary="))+9 ,string( $0D, $0A)))  )
      debug("Boundary: ", zstr_(@boundary))

      length := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("Content-Length: "))+ 16, 10)
      debug("Content Length: ", udec_(length))
      debug("Packet Size: ", udec_(ctx[t].psize))

      qc := 0
      repeat until startpoint > 27 or qc > 4
        qc++
        startpoint := inbin(@ctx[t].readbuffer,string("Content-Type: application/octet-stream", $0D, $0A, $0D, $0A), ctx[t].psize) + 42
        if  startpoint == 41
          startpoint := inbin(@ctx[t].readbuffer,string("Content-Type: image/jpeg", $0D, $0A, $0D, $0A), ctx[t].psize) + 28
        if startpoint == 27
          ctx[t].psize := W6100.ReceiveProcess(socket,@ctx[t].readbuffer)
      debug("Data Startpoint: ", udec_(startpoint))
      debug()
      debug($0D, $0A)
      datarxed := ctx[t].psize - startpoint
      bpos := inbin(@ctx[t].readbuffer + startpoint, @boundary,datarxed)
      If bpos <> -1
        debug("Found Boundry in Packet: ", udec_(bpos))
        debug($0D, $0A)
        datarxed :=  startpoint - bpos
      ' 2.6.1: clear the appended config block first, so an older (shorter) file can't leave
      ' stale DDP settings behind, and never copy past ENDOFCONFIG.
      longfill(@PROTOCOL, 0, 65)
      bytemove(@PIXELCONFIG, @ctx[t].readbuffer + startpoint, datarxed <# ((@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)) ' Copy 1st packet of uploaded config into memory
      debug("Data size: ", udec_(datarxed))
      debug($0D, $0A)
'      waitms(3000)
'      waitms(3000)
      repeat until W6100.ReceiveData(socket,500) == W6100.Sn_IR_TIMEOUT
             startpoint := datarxed ' Set the last offset where you wrote to last.
             ctx[t].psize := W6100.ReceiveProcess(socket,@ctx[t].readbuffer)
             ctx[t].psize := ctx[t].psize
             debug("Packet Size: ", udec_(ctx[t].psize))
             debug($0D, $0A)
             bpos := inbin(@ctx[t].readbuffer, @boundary, ctx[t].psize)
             If bpos <> -1
                debug("Found Boundry in Subsequent Packet: ", udec_(bpos))
                 debug($0D, $0A)
                datarxed :=  datarxed + bpos - 4 ' -4 to remove CR LF and --
                cpysize := bpos - 4 ' -4 to remove CR LF and --
             else
                datarxed :=  datarxed + ctx[t].psize
                cpysize := ctx[t].psize
             if startpoint < ((@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)
               bytemove(@PIXELCONFIG + startpoint, @ctx[t].readbuffer, cpysize <# (((@ENDOFCONFIG + 3) - @PIXELCONFIG + 1) - startpoint))
      debug("Total Bytes RXed: ", udec_(datarxed))
      debug($0D, $0A)
'      waitms(3000)
'      waitms(3000)
pub e131post() | t, output, ei, eti, u , uascii
    t := TASKID()
    longfill(@tE131CONFIG,0,432) ' Clean up the tmp space
    eutmp[0] := 0
    pcnt[0] := 0
    ' Get the output Pin this E1.31 config is associated with
    output := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("output="))+ 7, 2)
    debug(STRING("DMXENABLED:" ),udec_(str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("dmxenabled="))+ 11, 2)))
    if output == 25
      if str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("dmxenabled="))+ 11, 2) == 1
        DMXENABLED := 1
      else
        DMXENABLED := 0

    ' Get the output name
    if str.instr(@ctx[t].readbuffer,string("ON=")) <> -1
      strcopy(@tmpfilepath, @ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("ON="))+3, str.instr(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("ON="))+3,string("&")))
      bytefill(@OUTPUTNAME[output-1].namefield, 0, 32)   ' Clear the whole field: no leftover bytes from a longer name
      URLDecode(@tmpfilepath,@OUTPUTNAME[output-1].namefield)
      tmpfilepath[0] := 0 ' Zero out the tmp string. tmpfilepath is used because it is available.

    ' Initialize the variables to be used.
    u  := 1
    ei := 0
    eti := 0
    'Populate tE131CONFIG with configured pin/universe/pixelcount/pixelbuffer records in the E131CONFIG structure until we come to the current output.
    repeat until (E131CONFIG[ei] >= output) or (E131CONFIG[ei] == 0)
      'Move 4 longs from the E1.31 config structure to the temp structure, before the output is found or end of structure is detected.
      'No idea why I am doing ei*4, maybe because longs?
      longmove(@tE131CONFIG+(ei*4),@E131CONFIG+(ei*4),4)
      ei := ei + 4
      eti := ei
    ' Populate eutemp with "U1="
    str.append_str(@eutmp,string("U"))
    str.append_str(@eutmp,str.dec(u,1))
    str.append_str(@eutmp,string("="))
    ' Populate pcnt (pixelcount) with "P1="
    str.append_str(@pcnt,string("P"))
    str.append_str(@pcnt,str.dec(u,1))
    str.append_str(@pcnt,string("="))

    'Look in the read buffer until the location of the current eutmp (ie "U1=", "U2=", etc) is found and repeat the code block. Stop if it cannot be found.
    repeat until str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@eutmp)+ 3, 6) == 0
      ' Set the output pin in the current location (ei) of tE131CONFIG. This is a many to one relationship with the pin in the pixelbuffer.
      tE131CONFIG[ei] := output

      ' Set the value of the eutmp (ie "U1=", "U2=", etc) universe associated with this pin.
      tE131CONFIG[ei+1] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@eutmp)+ 3, 6)
      ' Set the value of the pcnt (pixelcount ie "P1=", "P2=", etc ) of this universe assocaited with this pin.
      tE131CONFIG[ei+2] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@pcnt)+ 3, 3)

      debug(udec(str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@eutmp)+ 3, 6)))
      debug(udec(str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@pcnt)+ 3, 3)))

      ' Increment the universe and pixelcount to the next that may have been posted to the page.
      u := u + 1
      ' clear eutmp
      eutmp[0] := 0
      ' clear pcnt
      pcnt[0] := 0
      ' Populate eutemp with the next universe of this pin to look for.
      str.append_str(@eutmp,string("U"))
      str.append_str(@eutmp,str.dec(u,1))
      str.append_str(@eutmp,string("="))
      ' Populate pcnt with the next pixelcount of this pin to look for.
      str.append_str(@pcnt,string("P"))
      str.append_str(@pcnt,str.dec(u,1))
      str.append_str(@pcnt,string("="))
      ' Move to the next pin/universe/pixelcount/pixelbuffer in the structure.
      ei := ei + 4
       'waitms(3000)
    ' Increment et1 until we are past the currently configured output pin or the end of configured pin/universe/pixelcount/pixelbuffer records in the structure or the end of the structure.
    repeat until (E131CONFIG[eti] <> output) or (E131CONFIG[eti] == 0) or eti >= 432
        eti := eti + 4

 '   ei := ei - 4
    ' Copy any remaining records in the E1.31 structure to @tE131CONFIG
    repeat until (E131CONFIG[eti] == 0) or eti >= 432
        longmove(@tE131CONFIG+(ei*4),@E131CONFIG+(eti*4),4)
        eti := eti + 4
        ei := ei + 4

    ' Clear E131CONFIG
    longfill(@E131CONFIG,0,432)
    ' Overwrite the E131CONFIG with tE131CONFIG
    longmove(@E131CONFIG,@tE131CONFIG,432)
    ' Rebuild the Pixel/E1.31 relationship
    ConfigPixels()
    ' Stop and restart the pixel drivers
    StopPixels()
    StartPixels()
    if blinkmode <> true and W6100.e131cognum() <> 0
      ' Restart the E1.31 ethernet driver (only if it was running)
      W6100.stopfastrx()
      startrx()

pub e131js() | t, output, u, ei, type

  t := TASKID()
' Set output
   output := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("output="))+ 7, 2)
   type := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("type="))+ 5, 2)

' Zero out buffer
   ctx[t].webbuff[0] := 0

' send header
   str.append_str(@ctx[t].webbuff,resp_js_ptr)

' In DDP mode the output pages live in ddp.htm (dmx.htm switches itself to DDP fields below)
   if PROTOCOL == PROTO_DDP and type <> 2
       str.append_str(@ctx[t].webbuff, string($0D, $0A, "window.location.replace('ddp.htm?output="))
       str.append_str(@ctx[t].webbuff,str.dec(output,-1))
       str.append_str(@ctx[t].webbuff, string("');"))
       ctx[t].rdsize := strsize(@ctx[t].webbuff)
       return

   u  := 1
   ei := 0
'   if DMXENABLED <> 1 and type <> 2
   if type <> 2

       tmpfilepath[0] := 0
       str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('ON').value='"))
       singlequoteescape(@OUTPUTNAME[output-1].namefield, @tmpfilepath)
       str.append_str(@ctx[t].webbuff, @tmpfilepath)
       str.append_str(@ctx[t].webbuff, string("';"))
       tmpfilepath[0] := 0

   repeat until E131CONFIG[ei] == 0
      if E131CONFIG[ei] == output


               str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('U"))
               str.append_str(@ctx[t].webbuff,str.dec(u,-1))
               str.append_str(@ctx[t].webbuff, string("').value='"))
               str.append_str(@ctx[t].webbuff,str.dec(E131CONFIG[ei+1],-1))
               str.append_str(@ctx[t].webbuff, string("';"))

               str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('P"))
               str.append_str(@ctx[t].webbuff,str.dec(u,-1))
               str.append_str(@ctx[t].webbuff, string("').value='"))
               str.append_str(@ctx[t].webbuff,str.dec(E131CONFIG[ei+2],-1))
               str.append_str(@ctx[t].webbuff, string("';"))
               if  ((E131CONFIG[ei+1] <> 0 and E131CONFIG[ei+2] <> 0) or (u == 1)) and type <> 2
                    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('R"))
                    str.append_str(@ctx[t].webbuff,str.dec(u,-1))
                    str.append_str(@ctx[t].webbuff, string("').style.display = '';"))
                    if u > 2
                      str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('A"))
                      str.append_str(@ctx[t].webbuff,str.dec(u-1,-1))
                      str.append_str(@ctx[t].webbuff, string("').style.display = 'None';"))
                      str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('M"))
                      str.append_str(@ctx[t].webbuff,str.dec(u-1,-1))
                      str.append_str(@ctx[t].webbuff, string("').style.display = 'None';"))
               u := u + 1

      ei := ei + 4

'  Populate the E131 set to ensure user does not add duplicate.
   ei := 1

   str.append_str(@ctx[t].webbuff, string($0D, $0A, "const e131set = new Map(["))
   repeat until E131CONFIG[ei] == 0
    if E131CONFIG[ei-1] <> output
      str.append_str(@ctx[t].webbuff, string("['"))
      str.append_str(@ctx[t].webbuff,str.dec(E131CONFIG[ei],-1))
      str.append_str(@ctx[t].webbuff, string("','"))
      str.append_str(@ctx[t].webbuff,str.dec(E131CONFIG[ei-1],-1))
      str.append_str(@ctx[t].webbuff, string("']"))
      ei := ei + 4
       if E131CONFIG[ei] <> 0
         str.append_str(@ctx[t].webbuff, string(","))
    else
      ei := ei + 4

   str.append_str(@ctx[t].webbuff, string("]);"))
   str.append_str(@ctx[t].webbuff, string($0D, $0A, "function checke131(tf){ if (e131set.has(tf.value)){ tf.style.background='LightPink'; } else { tf.style.background='White'; } }"))

   if type == 2 and DMXENABLED == 0
      str.append_str(@ctx[t].webbuff, string($0D, $0A, "tableRowHide('R1');tableRowHide('R2');tableRowHide('R3');tableRowHide('R4');"))
   if type == 2 and DMXENABLED == 1
      str.append_str(@ctx[t].webbuff, String($0D, $0A, "document.getElementById('dmxenabled').checked = true;"))
   if type <> 2 and DMXENABLED == 0
      str.append_str(@ctx[t].webbuff, string($0D, $0A, "tableRowDisplay('LR');"))
   if type <> 2 and DMXENABLED == 1
      str.append_str(@ctx[t].webbuff, String($0D, $0A, "tableRowHide('LR');"))

' dmx.htm in DDP mode: hand it the DMX channel map and let it swap in the DDP fields
   if type == 2 and PROTOCOL == PROTO_DDP
      str.append_str(@ctx[t].webbuff, string($0D, $0A, "ddpmode(["))
      repeat u from 0 to 3
        str.append_str(@ctx[t].webbuff, string("["))
        str.append_str(@ctx[t].webbuff,str.dec(DDPCONFIG[(DDP_DMX + u) * 2],-1))
        str.append_str(@ctx[t].webbuff, string(","))
        str.append_str(@ctx[t].webbuff,str.dec(DDPCONFIG[(DDP_DMX + u) * 2 + 1],-1))
        str.append_str(@ctx[t].webbuff, string("],"))
      str.append_str(@ctx[t].webbuff, string("]);"))

   str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('logo').innerHTML += '</DIV><DIV style=\'font-size: 15px; font-weight: bold;\'>"))
   str.append_str(@ctx[t].webbuff, @HOSTNAME)
   str.append_str(@ctx[t].webbuff, string(".local</DIV>';"))

   ctx[t].rdsize := strsize(@ctx[t].webbuff)

pub ddpjs() | t, output, o
'' ddp.js?output=N: values for ddp.htm, plus the whole channel map.
  t := TASKID()
  output := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("output="))+ 7, 2)
  if output < 1 or output > 28
    output := 1

  ctx[t].webbuff[0] := 0
  str.append_str(@ctx[t].webbuff,resp_js_ptr)

' In E1.31 mode the output pages live in e131.htm
  if PROTOCOL <> PROTO_DDP
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "window.location.replace('e131.htm?output="))
    str.append_str(@ctx[t].webbuff,str.dec(output,-1))
    str.append_str(@ctx[t].webbuff, string("');"))
    ctx[t].rdsize := strsize(@ctx[t].webbuff)
    return

  tmpfilepath[0] := 0
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('ON').value='"))
  singlequoteescape(@OUTPUTNAME[output-1].namefield, @tmpfilepath)
  str.append_str(@ctx[t].webbuff, @tmpfilepath)
  str.append_str(@ctx[t].webbuff, string("';"))
  tmpfilepath[0] := 0

  if DDPCONFIG[(output - 1) * 2] <> 0
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DDPS').value='"))
    str.append_str(@ctx[t].webbuff,str.dec(DDPCONFIG[(output - 1) * 2],-1))
    str.append_str(@ctx[t].webbuff, string("';"))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DDPC').value='"))
    str.append_str(@ctx[t].webbuff,str.dec(DDPCONFIG[(output - 1) * 2 + 1],-1))
    str.append_str(@ctx[t].webbuff, string("';"))

  str.append_str(@ctx[t].webbuff, string($0D, $0A, "const ddpmax="))
  str.append_str(@ctx[t].webbuff,str.dec(DDP_MAXPIX,-1))
  str.append_str(@ctx[t].webbuff, string(";", $0D, $0A, "const dmxon="))
  str.append_str(@ctx[t].webbuff,str.dec(DMXENABLED,-1))
  str.append_str(@ctx[t].webbuff, string(";", $0D, $0A, "const ddpmap=["))
  ' [start channel, count, name] for outputs 1-28, then DMX 1-4
  repeat o from 0 to 31
    str.append_str(@ctx[t].webbuff, string("["))
    str.append_str(@ctx[t].webbuff,str.dec(DDPCONFIG[o * 2],-1))
    str.append_str(@ctx[t].webbuff, string(","))
    if o >= DDP_DMX                             ' DMX outputs always take 510 channels
      str.append_str(@ctx[t].webbuff,str.dec((DDPCONFIG[o * 2] == 0) ? 0 : DMX_CH,-1))
    else
      str.append_str(@ctx[t].webbuff,str.dec(DDPCONFIG[o * 2 + 1],-1))
    str.append_str(@ctx[t].webbuff, string(",'"))
    if o < 28
      tmpfilepath[0] := 0
      singlequoteescape(@OUTPUTNAME[o].namefield, @tmpfilepath)
      str.append_str(@ctx[t].webbuff, @tmpfilepath)
      tmpfilepath[0] := 0
    str.append_str(@ctx[t].webbuff, string("'],"))
  str.append_str(@ctx[t].webbuff, string("];", $0D, $0A, "ddpshow();"))

  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('logo').innerHTML += '</DIV><DIV style=\'font-size: 15px; font-weight: bold;\'>"))
  str.append_str(@ctx[t].webbuff, @HOSTNAME)
  str.append_str(@ctx[t].webbuff, string(".local</DIV>';"))

  ctx[t].rdsize := strsize(@ctx[t].webbuff)

pub ddppost() | t, output, p, s, c
'' POST to ddp.htm?output=N. Either a protocol switch (PROTO=0/1, sent by the selector on
'' e131.htm and ddp.htm), or one output's DDP settings (ON=, DDPS=start channel, DDPC=pixels).
'' Like the other settings pages this changes the running config; Configs > Save writes it to SD.
  t := TASKID()
  output := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("output="))+ 7, 2)
  if output < 1 or output > 28
    return

  p := str.instr(@ctx[t].readbuffer,string("PROTO="))
  if p <> -1
    setprotocol(str2dec(@ctx[t].readbuffer + p + 6, 1))
    return

  p := str.instr(@ctx[t].readbuffer,string("DDPS="))
  if p == -1
    return                                       ' not a DDP settings form; change nothing
  s := str2dec(@ctx[t].readbuffer + p + 5, 9)
  c := 0
  p := str.instr(@ctx[t].readbuffer,string("DDPC="))
  if p <> -1
    c := str2dec(@ctx[t].readbuffer + p + 5, 6) <# DDP_MAXPIX
  if s > DDP_MAXCH
    s := 0
  if s == 0
    c := 0

  ' Get the output name (same as e131post)
  if str.instr(@ctx[t].readbuffer,string("ON=")) <> -1
    strcopy(@tmpfilepath, @ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("ON="))+3, str.instr(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("ON="))+3,string("&")))
    bytefill(@OUTPUTNAME[output-1].namefield, 0, 32)     ' Clear the whole field: no leftover bytes from a longer name
    URLDecode(@tmpfilepath,@OUTPUTNAME[output-1].namefield)
    tmpfilepath[0] := 0

  DDPCONFIG[(output - 1) * 2] := s
  DDPCONFIG[(output - 1) * 2 + 1] := c
  if PROTOCOL == PROTO_DDP
    reloadoutputs()

pub ddpdmxpost() | t, n, p, s
'' POST from dmx.htm in DDP mode: dmxenabled, DS1-DS4 (start channel). Each DMX output
'' always takes 510 channels.
  t := TASKID()
  if str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string("dmxenabled="))+ 11, 2) == 1
    DMXENABLED := 1
  else
    DMXENABLED := 0

  repeat n from 0 to 3
    p := str.instr(@ctx[t].readbuffer, lookupz(n : string("DS1="), string("DS2="), string("DS3="), string("DS4=")))
    if p <> -1
      s := str2dec(@ctx[t].readbuffer + p + 4, 9)
      if s > DDP_MAXCH - DMX_CH + 1               ' all 510 channels must fit below 2^24
        s := 0
      DDPCONFIG[(DDP_DMX + n) * 2] := s
      DDPCONFIG[(DDP_DMX + n) * 2 + 1] := (s == 0) ? 0 : DMX_CH
  reloadoutputs()

pub outputspost() | t, p, dis
    t := TASKID()
    eutmp[0] := 0
    p := 0
    dis := false
    repeat 28
      str.append_str(@eutmp,string("O"))
      str.append_str(@eutmp,str.dec(p+1,1))
      str.append_str(@eutmp,string("="))
      ' Disabled outputs aren't submitted by the browser: keep their stored color order (bug 71)
      if str.instr(@ctx[t].readbuffer,@eutmp) <> -1
        PIXELCONFIG[(p * 5) + 1] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@eutmp)+ strsize(@eutmp), 3)
      eutmp[0] := 0
'      debug(udec(PIXELCONFIG[(p * 5) + 1] )
'
      p++
    eutmp[0] := 0
    str.append_str(@eutmp,string("brt="))
    Brightness := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@eutmp)+ strsize(@eutmp), 3)


    eutmp[0] := 0
    p := 0
    repeat 28
      str.append_str(@eutmp,string("T"))
      str.append_str(@eutmp,str.dec(p+1,1))
      str.append_str(@eutmp,string("="))
      testpixel[p] := str2dec(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,@eutmp)+ strsize(@eutmp), 3)
      if testpixel[p] > 0
        W6100.stopfastrx()
        dis := true
        blinkmode :=  true
      eutmp[0] := 0
'      debug(udec(PIXELCONFIG[(p * 5) + 1] )
'
      p++

    if dis == false and W6100.e131cognum() == 0
      blinkmode := false
      bytefill(@pixelbuffer,0,73768)
      startrx()

    if dis == true
      bytefill(@pixelbuffer,0,73768)

    stoppixels()
    startpixels()
'    waitms(3000)

pub outputjs() | t, p, idx
    t := TASKID()
' Zero out buffer
    ctx[t].webbuff[0] := 0

' send header
    str.append_str(@ctx[t].webbuff,resp_js_ptr)

    p := 0
    repeat 28
      CASE PIXELCONFIG[(p * 5) + 1]
        %%0123: idx:=0
        %%2013: idx:=1
        %%1023: idx:=2
        %%0213: idx:=3
        %%1203: idx:=4
        %%2103: idx:=5
      str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('O"))
      str.append_str(@ctx[t].webbuff,str.dec(p+1,-1))
      str.append_str(@ctx[t].webbuff, string("').selectedIndex = '"))
      str.append_str(@ctx[t].webbuff,str.dec(idx,-1))
      str.append_str(@ctx[t].webbuff, string("'; "))
      p++
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('brt').value='"))
    str.append_str(@ctx[t].webbuff,str.dec(Brightness,-1))
    str.append_str(@ctx[t].webbuff, string("';"))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('sld').value='"))
    str.append_str(@ctx[t].webbuff,str.dec(Brightness,-1))
    str.append_str(@ctx[t].webbuff, string("';"))

    p := 0
    repeat 28
      CASE testpixel[p]
        0: idx:=0
        1: idx:=1
        2: idx:=2
        3: idx:=3
        4: idx:=4

      str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('T"))
      str.append_str(@ctx[t].webbuff,str.dec(p+1,-1))
      str.append_str(@ctx[t].webbuff, string("').selectedIndex = '"))
      str.append_str(@ctx[t].webbuff,str.dec(idx,-1))
      str.append_str(@ctx[t].webbuff, string("'; "))
      p++

    p := 1
    repeat 28
      Debug(udec(pinpixelcnt(p)))
      Debug(udec(p))
      if pinpixelcnt(p) == 0
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('T"))
        str.append_str(@ctx[t].webbuff,str.dec(p,-1))
        str.append_str(@ctx[t].webbuff, string("').disabled = true ;"))
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('O"))
        str.append_str(@ctx[t].webbuff,str.dec(p,-1))
        str.append_str(@ctx[t].webbuff, string("').disabled = true ;"))
      p++

    if  DMXENABLED == 0
      str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('LR12').style.display = ''; document.getElementById('LR34').style.display = '';"))
    if  DMXENABLED == 1
      str.append_str(@ctx[t].webbuff, String($0D, $0A, "document.getElementById('LR12').style.display = 'None'; document.getElementById('LR34').style.display = 'None';"))

    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('logo').innerHTML += '</DIV><DIV style=\'font-size: 15px; font-weight: bold;\'>"))
    str.append_str(@ctx[t].webbuff, @HOSTNAME)
    str.append_str(@ctx[t].webbuff, string(".local</DIV>';"))

    ctx[t].rdsize := strsize(@ctx[t].webbuff)
    debug(zstr(@ctx[t].webbuff))
pub netjs() | t, idx

  t := TASKID()
' Zero out buffer
  ctx[t].webbuff[0] := 0

' send header
  str.append_str(@ctx[t].webbuff,resp_js_ptr)

  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('HOSTNAME').value='"))
  singlequoteescape(@HOSTNAME, @tmpfilepath)
  str.append_str(@ctx[t].webbuff, @tmpfilepath)
  str.append_str(@ctx[t].webbuff, string("';"))
  tmpfilepath[0] := 0



' set checkbox if DHCP is enabled
  if DHCP == 1
     str.append_str(@ctx[t].webbuff, dhcp_ptr)

' Set IP Address in form
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('IPADDRESS0').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(IPADDRESS[0],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('IPADDRESS1').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(IPADDRESS[1],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('IPADDRESS2').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(IPADDRESS[2],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('IPADDRESS3').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(IPADDRESS[3],-1))
  str.append_str(@ctx[t].webbuff, string("';"))

' Set Subnet in form
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('SUBNETMASK0').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(SUBNETMASK[0],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('SUBNETMASK1').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(SUBNETMASK[1],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('SUBNETMASK2').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(SUBNETMASK[2],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('SUBNETMASK3').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(SUBNETMASK[3],-1))
  str.append_str(@ctx[t].webbuff, string("';"))

' Set Gateway in form
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('GATEWAY0').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(GATEWAY[0],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('GATEWAY1').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(GATEWAY[1],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('GATEWAY2').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(GATEWAY[2],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('GATEWAY3').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(GATEWAY[3],-1))
  str.append_str(@ctx[t].webbuff, string("';"))

' Set DNS in form
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DNS0').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(DNS[0],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DNS1').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(DNS[1],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DNS2').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(DNS[2],-1))
  str.append_str(@ctx[t].webbuff, string("';"))
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DNS3').value='"))
  str.append_str(@ctx[t].webbuff,str.dec(DNS[3],-1))
  str.append_str(@ctx[t].webbuff, string("';"))

' Set Speed and Duplex
  CASE SPEEDDUPLEX
        0: idx:=0
        4: idx:=1
        5: idx:=2
        6: idx:=3
        7: idx:=4

  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('SD').selectedIndex = '"))
  str.append_str(@ctx[t].webbuff,str.dec(idx,-1))
  str.append_str(@ctx[t].webbuff, string("'; "))

  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('DTO').value = '"))
  str.append_str(@ctx[t].webbuff,str.dec(SCREENTIMEOUT,-1))
  str.append_str(@ctx[t].webbuff, string("'; "))

  str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('logo').innerHTML += '</DIV><DIV style=\'font-size: 15px; font-weight: bold;\'>"))
  str.append_str(@ctx[t].webbuff, @HOSTNAME)
  str.append_str(@ctx[t].webbuff, string(".local</DIV>';"))

  ctx[t].rdsize := strsize(@ctx[t].webbuff)

PUB countersjs() | t
  t := TASKID()
' Zero out buffer
   ctx[t].webbuff[0] := 0

' send header
   str.append_str(@ctx[t].webbuff,resp_js_ptr)

   str.append_str(@ctx[t].webbuff, string($0D, $0A, "var myTable = document.getElementById('stats');"))

   str.append_str(@ctx[t].webbuff, string($0D, $0A, "myTable.rows[0].cells[1].innerHTML = '"))
   str.append_str(@ctx[t].webbuff,str.dec(wdpps,-1))
   str.append_str(@ctx[t].webbuff, string(" pkt/sec';"))
   str.append_str(@ctx[t].webbuff, string($0D, $0A, "myTable.rows[1].cells[1].innerHTML = '"))
   str.append_str(@ctx[t].webbuff,str.dec(wddps,-1))
   str.append_str(@ctx[t].webbuff, string(" drops/sec';"))
   str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('logo').innerHTML += '</DIV><DIV style=\'font-size: 15px; font-weight: bold;\'>"))
   str.append_str(@ctx[t].webbuff, @HOSTNAME)
   str.append_str(@ctx[t].webbuff, string(".local</DIV>';"))

   ctx[t].rdsize := strsize(@ctx[t].webbuff)

PUB markconfigsaved()
'' The running config now matches blitzen.cfg (boot load or a complete save).
  savedcrc := GETCRC(@PIXELCONFIG, $EDB8_8320, (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)
  unsaved := false

PUB checkunsaved()
'' After a settings change: unsaved only if the config block differs from the baseline,
'' so a no-op save or a change that is undone does not count.
  unsaved := GETCRC(@PIXELCONFIG, $EDB8_8320, (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1) <> savedcrc

PUB unsavedbanner() | t
'' Appends the "Unsaved changes" banner to this page's script, and swaps any link to
'' upgrade.htm (Upgrade Available, Development Firmware) for a save-first note.
  t := TASKID()
  if strsize(@ctx[t].webbuff) > 7000
    return
  str.append_str(@ctx[t].webbuff, string($0D, $0A, "(function()", 123, "if(document.getElementById('unsaved'))return;var d=document.createElement('div');d.id='unsaved';"))
  str.append_str(@ctx[t].webbuff, string("d.style.cssText='background:#FFD54F;color:#000;padding:6px;text-align:center;font-weight:bold;';"))
  str.append_str(@ctx[t].webbuff, string("d.innerHTML='Unsaved changes. <a href=configs.htm?save=y>Save</a>';"))
  str.append_str(@ctx[t].webbuff, string("var h=document.querySelector('header');if(h)h.insertAdjacentElement('afterend',d);else document.body.insertAdjacentElement('afterbegin',d);"))
  str.append_str(@ctx[t].webbuff, string("document.querySelectorAll('a[href*=upgrade]').forEach(function(a)", 123, "var s=document.createElement('span');s.textContent='Save your changes before upgrading.';s.style.color='#999';a.replaceWith(s);", 125, ");"))
  str.append_str(@ctx[t].webbuff, string(125, ")();"))
  ctx[t].rdsize := strsize(@ctx[t].webbuff)

PUB statsjs() | t
'' Home page Input Stats poll (index.htm, about once a second): only the two
'' per-second values from the stats loop, as JSON. No SD access.
   t := TASKID()
   ctx[t].webbuff[0] := 0
   str.append_str(@ctx[t].webbuff,resp_js_ptr)
   str.append_str(@ctx[t].webbuff, string("{", $22, "pps", $22, ":"))
   str.append_str(@ctx[t].webbuff,str.dec(wdpps,-1))
   str.append_str(@ctx[t].webbuff, string(",", $22, "dps", $22, ":"))
   str.append_str(@ctx[t].webbuff,str.dec(wddps,-1))
   str.append_str(@ctx[t].webbuff, string("}"))
   ctx[t].rdsize := strsize(@ctx[t].webbuff)
PUB configjs() | dns_ptr, t
    t := TASKID()
    ' Zero out buffers
    ctx[t].webbuff[0] := 0
    servername[0] := 0
    ' send header
    str.append_str(@ctx[t].webbuff,resp_js_ptr)
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "function secondsToDhms(seconds) ", 123))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "seconds = Number(seconds); "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var d = Math.floor(seconds / (3600*24)); "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var h = Math.floor(seconds % (3600*24) / 3600); "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var m = Math.floor(seconds % 3600 / 60);"))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var s = Math.floor(seconds % 60); "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var dDisplay = d > 0 ? d + (d == 1 ? 'D:' : 'D:') : ''; "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var hDisplay = h > 0 ? h + (h == 1 ? 'H:' : 'H:') : ''; "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var mDisplay = m > 0 ? m + (m == 1 ? 'M:' : 'M:') : ''; "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var sDisplay = s > 0 ? s + (s == 1 ? 'S ': 'S') : ''; "))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "return dDisplay + hDisplay + mDisplay + sDisplay;",125))

    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var version = document.getElementById('version');"))
    str.append_str(@ctx[t].webbuff, string("str = secondsToDhms("))
    str.append_str(@ctx[t].webbuff,str.dec(getsec(),-1))
    str.append_str(@ctx[t].webbuff, string(");"))
    str.append_str(@ctx[t].webbuff, string($0D, $0A, "version.innerHTML = 'Version: "))
    str.append_str(@ctx[t].webbuff,@buildver)
    str.append_str(@ctx[t].webbuff, string("<br>Uptime: '"))

    str.append_str(@ctx[t].webbuff, string("+str;"))

    str.append_str(@ctx[t].webbuff, string($0D, $0A, "var div = document.getElementById('upgrade');"))

    str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('logo').innerHTML += '</DIV><DIV style=\'font-size: 15px; font-weight: bold;\'>"))
    str.append_str(@ctx[t].webbuff, @HOSTNAME)
    str.append_str(@ctx[t].webbuff, string(".local</DIV>';"))



    str.append_str(@servername,upgradeserver_ptr)

    dns_ptr := dnsresolver(@servername)
    if dns_ptr == -1
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Cant resolve "))
        str.append_str(@ctx[t].webbuff,@servername)
        str.append_str(@ctx[t].webbuff, string("';"))
        ctx[t].rdsize := strsize(@ctx[t].webbuff)
        return
    W6100.Open(80,W6100.PM_TCP4,W6100.IDM_BSR_Socket6_Register)

   ' Set Destination IP
    WRITEBUFFER[0] := SERVERIP[0]
    WRITEBUFFER[1] := SERVERIP[1]
    WRITEBUFFER[2] := SERVERIP[2]
    WRITEBUFFER[3] := SERVERIP[3]

    W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@WRITEBUFFER)

    ' Set Destination port
    WRITEBUFFER[0] := 00
    WRITEBUFFER[1] := 80
    W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket6_Register,2,@WRITEBUFFER)


    W6100.ConnectTCP(W6100.IDM_BSR_Socket6_Register)
'    W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@ctx[t].readbuffer)
'    debug("Connection Established to ", udec_(ctx[t].readbuffer[0]),".",udec_(ctx[t].readbuffer[1]),".",udec_(ctx[t].readbuffer[2]),".",udec_(ctx[t].readbuffer[3]))

    if (W6100.EstablishTCP(W6100.IDM_BSR_Socket6_Register, 1000) <> W6100.Sn_IR_TIMEOUT)
        W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@ctx[t].readbuffer)
        debug("Connection Established to ", udec_(ctx[t].readbuffer[0]),".",udec_(ctx[t].readbuffer[1]),".",udec_(ctx[t].readbuffer[2]),".",udec_(ctx[t].readbuffer[3]))
    else
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Cant connect to "))
        str.append_str(@ctx[t].webbuff,@servername)
        str.append_str(@ctx[t].webbuff, string("';"))
        ctx[t].rdsize := strsize(@ctx[t].webbuff)
        W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
        return



    debug("Checking Sn_RX_RSR Socket Status/number of bytes in buffer: ")

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,100) <> W6100.Sn_IR_TIMEOUT)
 '     W6100.ReceiveData(socket,100000)
        ctx[t].psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@ctx[t].readbuffer)
        ctx[t].readbuffer[ctx[t].psize] := 0
        debug("Received: ",zstr_(@ctx[t].readbuffer))


    WRITEBUFFER[0] := 0
    str.append_str(@WRITEBUFFER,string("GET /firmware/Blitzen24/Manifest.txt HTTP/1.1", $0D, $0A, "Host: "))
    str.append_str(@WRITEBUFFER,@servername)
    str.append_str(@WRITEBUFFER,string($0D, $0A, $0D, $0A))
    W6100.SendData(W6100.IDM_BSR_Socket6_Register,@WRITEBUFFER,strsize(@WRITEBUFFER))

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,300) <> W6100.Sn_IR_TIMEOUT)
 '     W6100.ReceiveData(socket,100000)
        ctx[t].psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@ctx[t].readbuffer)
        ctx[t].readbuffer[ctx[t].psize] := 0
        debug("Received: ",zstr_(@ctx[t].readbuffer))

    if str.instr(@ctx[t].readbuffer,string("HTTP/1.1 200")) == -1
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Response Code "))
        str.mid(@ctx[t].webbuff+strsize(@ctx[t].webbuff), @ctx[t].readbuffer, str.instr(@ctx[t].readbuffer,string("HTTP/1.1"))+8, (str.instr(@ctx[t].readbuffer,string("HTTP/1.1"))) + 4 )
        str.append_str(@ctx[t].webbuff,string("';"))
    else
        if str.instr(@ctx[t].readbuffer + str.instr(@ctx[t].readbuffer,string($0D, $0A, $0D, $0A)) + 4,@buildver) == -1
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.innerHTML = '<A HREF=/upgrade.htm>Upgrade Available</A> <br> <font size=2>"))
          str.mid(@ctx[t].webbuff+strsize(@ctx[t].webbuff),@ctx[t].readbuffer, str.instr(@ctx[t].readbuffer,string($0D, $0A, $0D, $0A)) + 4,str.instr(@ctx[t].readbuffer+str.instr(@ctx[t].readbuffer,string($0D, $0A, $0D, $0A)) + 4,String($0D, $0A)))
          str.append_str(@ctx[t].webbuff, string("</font>';"))
        else
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Firmware up to date.';"))



    ctx[t].rdsize := strsize(@ctx[t].webbuff)
    W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
pub downloadconfig() | t
  t := TASKID()
' Zero out buffer
  ctx[t].webbuff[0] := 0

' send header
  str.append_str(@ctx[t].webbuff, string("HTTP/1.1 200 OK", $0D, $0A))
  str.append_str(@ctx[t].webbuff,resp_dl_ptr)
  str.append_str(@ctx[t].webbuff, string("Content-Disposition: attachment; filename=", $22))
  str.append_str(@ctx[t].webbuff, @HOSTNAME)
  str.append_str(@ctx[t].webbuff, string("-runnning.cfg", $22, $0D, $0A, "Connection: close", $0D, $0A, $0D, $0A))

  ctx[t].rdsize := strsize(@ctx[t].webbuff)
' Copy running config into web buffer
  bytemove(@ctx[t].webbuff + ctx[t].rdsize, @PIXELCONFIG, (@ENDOFCONFIG + 3) - @PIXELCONFIG + 1)
  ctx[t].rdsize := ctx[t].rdsize + ((@ENDOFCONFIG + 3) - @PIXELCONFIG) + 1


pub dhcpclient() | i
' Clear IP Saved in config
  IPADDRESS[0] := 0
  IPADDRESS[1] := 0
  IPADDRESS[2] := 0
  IPADDRESS[3] := 0



  debug("Configuring Protocol Mode UDP on Socket 0", $0D, $0A)
  W6100.Open(68,W6100.PM_UDP4,W6100.IDM_BSR_Socket0_Register)

  ' Set Destination IP
  WRITEBUFFER[0] := 255
  WRITEBUFFER[1] := 255
  WRITEBUFFER[2] := 255
  WRITEBUFFER[3] := 255
  W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket0_Register,4,@WRITEBUFFER)

  ' Set Destination port
  WRITEBUFFER[0] := 00
  WRITEBUFFER[1] := 67
  W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket0_Register,2,@WRITEBUFFER)


  ' Set XID
  RequestID[0] := prng.xrandomize($00,$FF)
  RequestID[1] := prng.xrandomize($00,$FF)
  RequestID[2] := prng.xrandomize($00,$FF)
  RequestID[3] := prng.xrandomize($00,$FF)
  debug("Set XID to: ", uhex_(RequestID[0]),":", uhex_(RequestID[1]),":", uhex_(RequestID[2]),":", uhex_(RequestID[3]))

  WRITEBUFFER[0]  := $01 'Op $01 This is a discover packet
  WRITEBUFFER[1]  := $01 'HType $01 Ethernet xBase-T
  WRITEBUFFER[2]  := $06 'HLen $06 because we have 6 Octets in the hardware address.
  WRITEBUFFER[3]  := $00 'Hops setting Hops counter to 0. Is incremented by DHCP relays
  WRITEBUFFER[4]  := RequestID[0] 'XID Unique ID
  WRITEBUFFER[5]  := RequestID[1] 'XID Unique ID
  WRITEBUFFER[6]  := RequestID[2] 'XID Unique ID
  WRITEBUFFER[7]  := RequestID[3] 'XID Unique ID
  WRITEBUFFER[8]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[9]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[10] := $80 'Flags $80 sets this to broadcast from the DHCP server, becasue we are not on the network yet.
  WRITEBUFFER[11] := $00 'Flags Reserved
  WRITEBUFFER[12] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[13] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[14] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[15] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[16] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[17] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[18] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[19] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[20] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[21] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[22] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[23] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[24] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[25] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[26] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[27] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[28] := $00 'CHAddr MAC address
  WRITEBUFFER[29] := $08 'CHAddr MAC address
  WRITEBUFFER[30] := $DC 'CHAddr MAC address
  WRITEBUFFER[31] := $00 'CHAddr MAC address
  WRITEBUFFER[32] := $00 'CHAddr MAC address
  WRITEBUFFER[33] := $00 'CHAddr MAC address
  BYTEFILL(@WRITEBUFFER + 34, $00, 10) 'CHAddr fill with 0's
  BYTEFILL(@WRITEBUFFER + 44, $00, 64) 'bootp.server fill with 0's
  BYTEFILL(@WRITEBUFFER + 108, $00, 128) 'File fill with 0's
  WRITEBUFFER[236] := $63 'Magic Cookie
  WRITEBUFFER[237] := $82 'Magic Cookie
  WRITEBUFFER[238] := $53 'Magic Cookie
  WRITEBUFFER[239] := $63 'Magic Cookie
  WRITEBUFFER[240] :=  53 'Option 53
  WRITEBUFFER[241] := $01 'Option 53 Length
  WRITEBUFFER[242] := $01 'Option 53 Discovery Value
  WRITEBUFFER[243] :=  55 'Option 55
  WRITEBUFFER[244] := $03 'Option 55 Length
  WRITEBUFFER[245] := $01 'Option 55 Request Subnet Mask
  WRITEBUFFER[246] := $03 'Option 3 Request Router
  WRITEBUFFER[247] := $06 'Option 6 Request DNS Server
  WRITEBUFFER[248] := $FF 'End this shit

  W6100.SendData(W6100.IDM_BSR_Socket0_Register,@WRITEBUFFER,249)

  repeat until READBUFFER[12] == RequestID[0] && READBUFFER[13] == RequestID[1] && READBUFFER[14] == RequestID[2] && READBUFFER[15] == RequestID[3]
     repeat until W6100.ReceiveData(W6100.IDM_BSR_Socket0_Register,1) == 0
     psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket0_Register,@READBUFFER)

    debug("UDP Header Information: ", uhex_(READBUFFER[0]),uhex_(READBUFFER[1]) )

    debug("UDP Source IP: ",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]),".",udec_(READBUFFER[4]),".",udec_(READBUFFER[5]) )

    debug("UDP Port Number: ",udec_(READBUFFER[6]), udec_(READBUFFER[7]) )

    debug("Received XID is: ",uhex_(READBUFFER[12]),":",uhex_(READBUFFER[13]),":",uhex_(READBUFFER[14]),":",uhex_(READBUFFER[15]))

  debug("DHCP Assigned IP Address: ",udec_(READBUFFER[24]),".", udec_(READBUFFER[25]),".",udec_(READBUFFER[26]),".",udec_(READBUFFER[27])  )

  IPADDRESS[0] := READBUFFER[24]
  IPADDRESS[1] := READBUFFER[25]
  IPADDRESS[2] := READBUFFER[26]
  IPADDRESS[3] := READBUFFER[27]

  debug("Request IP Address: ", udec_(IPADDRESS[0]),".", udec_(IPADDRESS[1]),".",udec_(IPADDRESS[2]),".",udec_(IPADDRESS[3]))

  debug("Magic Cookie: ", uhex_(READBUFFER[244]), uhex_(READBUFFER[245]),uhex_(READBUFFER[246]), uhex_(READBUFFER[247]) )

  i:=248
  repeat until i >= psize || READBUFFER[i] == $FF
    case READBUFFER[i]
      53  :
             DHCPMESSAGETYPE := READBUFFER[i+2]
             debug("DHCP Message Type: ", udec_(READBUFFER[i+2]))

             i := i + 3
      54  :
               debug("DHCP Server: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               DHCPSERVER[0] := READBUFFER[i+2]
               DHCPSERVER[1] := READBUFFER[i+3]
               DHCPSERVER[2] := READBUFFER[i+4]
               DHCPSERVER[3] := READBUFFER[i+5]
               i := i + 6

      1 :
               debug("DHCP Subnet Mask: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               SUBNETMASK[0] := READBUFFER[i+2]
               SUBNETMASK[1] := READBUFFER[i+3]
               SUBNETMASK[2] := READBUFFER[i+4]
               SUBNETMASK[3] := READBUFFER[i+5]
               i := i + 6
      3 :
               debug("DHCP Gateway: " , udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               GATEWAY[0] := READBUFFER[i+2]
               GATEWAY[1] := READBUFFER[i+3]
               GATEWAY[2] := READBUFFER[i+4]
               GATEWAY[3] := READBUFFER[i+5]
               i := i + 6
      6 :
               debug("DNS Server: " , udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               DNS[0] := READBUFFER[i+2]
               DNS[1] := READBUFFER[i+3]
               DNS[2] := READBUFFER[i+4]
               DNS[3] := READBUFFER[i+5]
               i := i + 6

      $ff :
               debug("Detected end of DHCP Options.")

      OTHER :
               debug("DHCP Option Unknown: ", udec_(READBUFFER[i]), " Incrementing ", udec_(READBUFFER[i+1] + 2))
               i++
               i := i + READBUFFER[i]
               i++


  W6100.readreg(W6100.REG_SIPR0,W6100.IDM_BSR_Common_Register,4,@READBUFFER)
  debug("Current IP Address: ",udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))

  W6100.readreg(W6100.REG_GAR0,W6100.IDM_BSR_Common_Register,4,@READBUFFER)
  debug("Current Subnet Mask: ",udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))

  WRITEBUFFER[0]  := $01 'Op $01 This is a request packet
  WRITEBUFFER[1]  := $01 'HType $01 Ethernet xBase-T
  WRITEBUFFER[2]  := $06 'HLen $06 because we have 6 Octets in the hardware address.
  WRITEBUFFER[3]  := $00 'Hops setting Hops counter to 0. Is incremented by DHCP relays
  WRITEBUFFER[4]  := RequestID[0] 'XID Unique ID
  WRITEBUFFER[5]  := RequestID[1] 'XID Unique ID
  WRITEBUFFER[6]  := RequestID[2] 'XID Unique ID
  WRITEBUFFER[7]  := RequestID[3] 'XID Unique ID
  WRITEBUFFER[8]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[9]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[10] := $80 'Flags $80 sets this to broadcast from the DHCP server, becasue we are not on the network yet.
  WRITEBUFFER[11] := $00 'Flags Reserved
  WRITEBUFFER[12] := IPADDRESS[0] 'CIAddr
  WRITEBUFFER[13] := IPADDRESS[1] 'CIAddr
  WRITEBUFFER[14] := IPADDRESS[2] 'CIAddr
  WRITEBUFFER[15] := IPADDRESS[3] 'CIAddr
  WRITEBUFFER[16] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[17] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[18] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[19] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[20] := DHCPSERVER[0] 'SIAddr DHCP Server IP
  WRITEBUFFER[21] := DHCPSERVER[1] 'SIAddr DHCP Server IP
  WRITEBUFFER[22] := DHCPSERVER[2] 'SIAddr DHCP Server IP
  WRITEBUFFER[23] := DHCPSERVER[3] 'SIAddr DHCP Server IP
  WRITEBUFFER[24] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[25] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[26] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[27] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[28] := $00 'CHAddr MAC address
  WRITEBUFFER[29] := $08 'CHAddr MAC address
  WRITEBUFFER[30] := $DC 'CHAddr MAC address
  WRITEBUFFER[31] := $00 'CHAddr MAC address
  WRITEBUFFER[32] := $00 'CHAddr MAC address
  WRITEBUFFER[33] := $00 'CHAddr MAC address
  BYTEFILL(@WRITEBUFFER + 34, $00, 10) 'CHAddr fill with 0's
  BYTEFILL(@WRITEBUFFER + 44, $00, 64) 'bootp.server fill with 0's
  BYTEFILL(@WRITEBUFFER + 108, $00, 128) 'File fill with 0's
  WRITEBUFFER[236] := $63 'Magic Cookie
  WRITEBUFFER[237] := $82 'Magic Cookie
  WRITEBUFFER[238] := $53 'Magic Cookie
  WRITEBUFFER[239] := $63 'Magic Cookie
  WRITEBUFFER[240] :=  53 'Option 53
  WRITEBUFFER[241] := $01 'Option 53 Length
  WRITEBUFFER[242] := $03 'Option 53 Request Value
  WRITEBUFFER[243] :=  50 'Option 50 ' Requesting this IP
  WRITEBUFFER[244] := $04 'Option 50 Length
  WRITEBUFFER[245] := IPADDRESS[0] 'Option 50 requested IP 1st Octect
  WRITEBUFFER[246] := IPADDRESS[1] 'Option 50 requested IP 2nd Octect
  WRITEBUFFER[247] := IPADDRESS[2] 'Option 50 requested IP 3rd Octect
  WRITEBUFFER[248] := IPADDRESS[3] 'Option 50 requested IP 4th Octect
  WRITEBUFFER[249] := $03 'Option 54 DHCP Server
  WRITEBUFFER[250] := $04 'Option 54 Length
  WRITEBUFFER[251] := DHCPSERVER[0] 'SIAddr DHCP Server IP
  WRITEBUFFER[252] := DHCPSERVER[1] 'SIAddr DHCP Server IP
  WRITEBUFFER[253] := DHCPSERVER[2] 'SIAddr DHCP Server IP
  WRITEBUFFER[254] := DHCPSERVER[3] 'SIAddr DHCP Server IP
  WRITEBUFFER[255] := $FF 'End this shit

  W6100.SendData(W6100.IDM_BSR_Socket0_Register,@WRITEBUFFER,256)

  'clearing readbuffer
  BYTEFILL(@READBUFFER,$00,1024)

  W6100.readreg(W6100.REG_Sn_IR,W6100.IDM_BSR_Socket0_Register,1,@READBUFFER)
  debug("Checking Sn_IR Socket Status: ", uhex_(READBUFFER[0]))

  repeat until READBUFFER[12] == RequestID[0] && READBUFFER[13] == RequestID[1] && READBUFFER[14] == RequestID[2] && READBUFFER[15] == RequestID[3]
     repeat until W6100.ReceiveData(W6100.IDM_BSR_Socket0_Register,1) == 0
     psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket0_Register,@READBUFFER)

    debug("Received XID is: ", uhex_(READBUFFER[12]),":",uhex_(READBUFFER[13]),":",uhex_(READBUFFER[14]),":",uhex_(READBUFFER[15]))

  i:=248
  repeat until i >= psize || READBUFFER[i] == $FF
    case READBUFFER[i]
      53  :  debug("DHCP Message Type: ",udec_(READBUFFER[i+2]) )
             DHCPMESSAGETYPE := READBUFFER[i+2]

             i := i + 3
      54  :  debug("DHCP Server: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))

               DHCPSERVER[0] := READBUFFER[i+2]
               DHCPSERVER[1] := READBUFFER[i+3]
               DHCPSERVER[2] := READBUFFER[i+4]
               DHCPSERVER[3] := READBUFFER[i+5]
               i := i + 6

      1 : debug("DHCP Subnet Mask: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))

               SUBNETMASK[0] := READBUFFER[i+2]
               SUBNETMASK[1] := READBUFFER[i+3]
               SUBNETMASK[2] := READBUFFER[i+4]
               SUBNETMASK[3] := READBUFFER[i+5]
               i := i + 6
      3 : debug("DHCP Gateway: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))

               GATEWAY[0] := READBUFFER[i+2]
               GATEWAY[1] := READBUFFER[i+3]
               GATEWAY[2] := READBUFFER[i+4]
               GATEWAY[3] := READBUFFER[i+5]
               i := i + 6
      6 :
               debug("DNS Server: " , udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               DNS[0] := READBUFFER[i+2]
               DNS[1] := READBUFFER[i+3]
               DNS[2] := READBUFFER[i+4]
               DNS[3] := READBUFFER[i+5]
               i := i + 6

      $ff : debug("Detected end of DHCP Options.")

      OTHER : debug("DHCP Option Unknown: ", udec_(READBUFFER[i]), " Incrementing ", udec_(READBUFFER[i+1] + 2))
               i++
               i := i + READBUFFER[i]
               i++

  ' Close Socket 0 so it doesn't stay bound to port 68 collecting DHCP broadcasts
  W6100.Close(W6100.IDM_BSR_Socket0_Register)

  if DHCPMESSAGETYPE <> 5
    debug("DHCP Messagetype: ", udec_(DHCPMESSAGETYPE))

    debug("DHCP Failure")
    abort





pub str2dec(p_str, len) : value |  ch

'' Convert string at p_str to decimal value
'' -- max length is len characters

  value := 0                                                     ' initialize result

  repeat len
    ch := byte[p_str++]                                          ' get a character
    if ((ch >= "0") and (ch <= "9"))                             ' valid digit?
      value := (value * 10) + (ch - "0")                         ' ASCII --> decimal
    else
      quit

  return
pub inbin(p_haystack, p_needle, slen) : pos | len1, len2, idx

'' Returns position of p_needle in str1
'' -- p_haystack is pointer to string to search
'' -- p_needle is pointer to string to look for in p_haystack
'' -- if p_needle not in p_haystack returns -1

  pos  := -1

  len1 := slen
  len2 := strsize(p_needle)
  idx  := 0

  if (len1 >= len2)
    repeat (len1 - len2 + 1)
      if idx == slen
        quit
      else
        if (str.strncmp(p_haystack++, p_needle, len2) == 0)
          pos := idx
          quit
        else
          ++idx
pub startpixels()
  WS2811.start_2812b(PIXELCONFIG[3], PIXELCONFIG[1],PIXELCONFIG[8], PIXELCONFIG[6],PIXELCONFIG[13], PIXELCONFIG[11],PIXELCONFIG[18], PIXELCONFIG[16],PIXELCONFIG[23], PIXELCONFIG[21],PIXELCONFIG[28], PIXELCONFIG[26],PIXELCONFIG[33], PIXELCONFIG[31],PIXELCONFIG[38], PIXELCONFIG[36],pixelcnt(PIXELCONFIG[0]),PIXELCONFIG[0] - 1, PIXELCONFIG[2],Brightness)
  WS28112.start_2812b(PIXELCONFIG[43], PIXELCONFIG[41],PIXELCONFIG[48],PIXELCONFIG[46],PIXELCONFIG[53], PIXELCONFIG[51],PIXELCONFIG[58], PIXELCONFIG[56],PIXELCONFIG[63], PIXELCONFIG[61],PIXELCONFIG[68], PIXELCONFIG[66],PIXELCONFIG[73], PIXELCONFIG[71],PIXELCONFIG[78], PIXELCONFIG[76],pixelcnt(PIXELCONFIG[40]),PIXELCONFIG[40] - 1, PIXELCONFIG[42],Brightness)
  WS28113.start_2812b(PIXELCONFIG[83], PIXELCONFIG[81],PIXELCONFIG[88],PIXELCONFIG[86],PIXELCONFIG[93], PIXELCONFIG[91],PIXELCONFIG[98], PIXELCONFIG[96],PIXELCONFIG[103], PIXELCONFIG[101],PIXELCONFIG[108], PIXELCONFIG[106],PIXELCONFIG[113], PIXELCONFIG[111],PIXELCONFIG[118], PIXELCONFIG[116],pixelcnt(PIXELCONFIG[80]),PIXELCONFIG[80] + 15, PIXELCONFIG[82],Brightness)
  if dmxenabled <> 1
    WS28114.start_2812b(PIXELCONFIG[123] , PIXELCONFIG[121], PIXELCONFIG[128],PIXELCONFIG[126], PIXELCONFIG[133], PIXELCONFIG[131],PIXELCONFIG[138], PIXELCONFIG[136],pixelcnt(PIXELCONFIG[120]),44, PIXELCONFIG[122],Brightness)
  else
    DMX.start(44, 45, 46, 47, -1, dmxbufferaddr(), dmxbufferaddr() + 510 , dmxbufferaddr() + 1020, dmxbufferaddr()+ 1530)

pub stoppixels()
  WS2811.stop()
  WS28112.stop()
  WS28113.stop()
  WS28114.stop()
  DMX.stop()
pub pixelcnt(pingroup) : pixelct | index , rptcnt
  pingroup := pingroup - 1 'This is so that we can pass what is configured in the data structure in pixelconfig.
  index := pingroup * 5
  pixelct := 0
  ' Special case for long range boards
  if pingroup == 24
      rptcnt := 4
  else
      rptcnt := 8

  repeat rptcnt
    if PIXELCONFIG[index + 4] >=  pixelct
      pixelct := PIXELCONFIG[index + 4]
    index := index + 5
  return pixelct
pub pinpixelcnt(pinnum) : pinpixcnt
  pinnum := pinnum - 1
  pinpixcnt := PIXELCONFIG[pinnum*5+4]
  return pinpixcnt
pub dmxbufferaddr() : dmxbuffer | ei
   if PROTOCOL == PROTO_DDP
     return ddpdmxbase       ' DDP layout: 4 x 510-byte DMX buffers after the pixel outputs
   ei := 0
   repeat until E131CONFIG[ei] == 0
      if E131CONFIG[ei] == 25
        debug(udec(E131CONFIG[ei+3]))
        return E131CONFIG[ei+3]
      ei := ei + 4
   return -1
pub dnsresolver(hostname) : rv | i, l
  debug("Configuring Protocol Mode UDP on Socket 0", $0D, $0A)
  ' Close first so Open() rebinds to port 53 with an empty RX buffer
  W6100.Close(W6100.IDM_BSR_Socket0_Register)
  W6100.Open(53,W6100.PM_UDP4,W6100.IDM_BSR_Socket0_Register)
  ' Set Destination IP
  WRITEBUFFER[0] := DNS[0]
  WRITEBUFFER[1] := DNS[1]
  WRITEBUFFER[2] := DNS[2]
  WRITEBUFFER[3] := DNS[3]
  W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket0_Register,4,@WRITEBUFFER)

  ' Set Destination port
  WRITEBUFFER[0] := 00
  WRITEBUFFER[1] := 53
  W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket0_Register,2,@WRITEBUFFER)

  ' Transaction ID
  RequestID[0] := prng.xrandomize($00,$FF)
  RequestID[1] := prng.xrandomize($00,$FF)

  ' Construct Request
  ' Set Transaction ID
  WRITEBUFFER[0] := RequestID[0]
  WRITEBUFFER[1] := RequestID[1]
  ' Set Query (1 bit), Opcode (4 bits) , Authoratative Answer (1 bit), Truncation (1 bit), Recursion Desired (1 bit)
  WRITEBUFFER[2] := %%1_0000_0_0_1
  ' Set Recursion Available (1 bit), Reserved (3 bits), Response Code (4 bits)
  WRITEBUFFER[3] := %%0_000_0000
  ' Set Query Count
  WRITEBUFFER[4] := 0
  WRITEBUFFER[5] := 1
  ' Set Answer Count
  WRITEBUFFER[6] := 0
  WRITEBUFFER[7] := 0
  ' Set Name Server Resource Record Count
  WRITEBUFFER[8] := 0
  WRITEBUFFER[9] := 0
  'Set Number of Resource Records in the Additional Records Section
  WRITEBUFFER[10] := 0
  WRITEBUFFER[11] := 0
  ' Set question
  i := 12
  repeat until l == -1
    l := str.instr(hostname+i-12,dot)
    debug(zstr(hostname+i-12))
    debug(udec(l))
    if l <> -1
      WRITEBUFFER[i] := l
      str.mid(@WRITEBUFFER+i+1, hostname, i-12,l)
      i := i + l + 1

  WRITEBUFFER[i] := strsize(hostname) - str.last(hostname, ".") - 1
  str.mid(@WRITEBUFFER+i+1, hostname, i-12,WRITEBUFFER[i])
  i := i + WRITEBUFFER[i] + 2
  ' Set Query Type
  WRITEBUFFER[i] := 0
  WRITEBUFFER[i+1] := 1   ' $0001 is for A records
  ' Set Query Class
  WRITEBUFFER[i+2] := 0
  WRITEBUFFER[i+3] := 1   ' $0001 is IN for Internet

  'Send Query
  W6100.SendData(W6100.IDM_BSR_Socket0_Register,@WRITEBUFFER,i+4)

  'clearing readbuffer
  BYTEFILL(@READBUFFER,$00,1024)

  W6100.readreg(W6100.REG_Sn_IR,W6100.IDM_BSR_Socket0_Register,1,@READBUFFER)
  debug("Checking Sn_IR Socket Status: ", uhex_(READBUFFER[0]))

  repeat until READBUFFER[8] == RequestID[0] && READBUFFER[9] == RequestID[1]
     ' Set timeout to 5 seconds
     l := GETSEC() + 5
     repeat until W6100.ReceiveData(W6100.IDM_BSR_Socket0_Register,1) == 0
      if GETSEC() >= l
         debug("DNS Server timed out.")
         W6100.Close(W6100.IDM_BSR_Socket0_Register)
         return -1

     psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket0_Register,@READBUFFER)

     debug("Received XID is: ", uhex_(READBUFFER[8]),":",uhex_(READBUFFER[9]))
  if READBUFFER[10] == $81 && READBUFFER[11] == $80
     i := 20
     debug("Name Resolved")
     repeat until READBUFFER[i] == 0
        debug("Question length ", uhex_(READBUFFER[i]))
        i := i + READBUFFER[i] + 1
     'Jump ahead to Answer Type
     i := i + 7
     debug("Answer Type", uhex_(READBUFFER[i]),uhex_(READBUFFER[i+1]))
     debug("Resolves as ", udec_(READBUFFER[psize-4]),".",udec_(READBUFFER[psize-3]),".",udec_(READBUFFER[psize-2]),".",udec_(READBUFFER[psize-1]))
     SERVERIP[0] := READBUFFER[psize-4]
     SERVERIP[1] := READBUFFER[psize-3]
     SERVERIP[2] := READBUFFER[psize-2]
     SERVERIP[3] := READBUFFER[psize-1]
     W6100.Close(W6100.IDM_BSR_Socket0_Register)
     return @SERVERIP
  else
     debug("Name did not resolve")
     W6100.Close(W6100.IDM_BSR_Socket0_Register)
     return -1
pri upgradejs()| dns_ptr, gur, t
    t := TASKID()
    ' Zero out buffers
    ctx[t].webbuff[0] := 0

    if unsaved                                    ' No upgrade (production or dev) while changes are unsaved
      str.append_str(@ctx[t].webbuff,resp_ptr)
      str.append_str(@ctx[t].webbuff, string($0D, $0A, "document.getElementById('main').innerHTML = '<h3>Save your changes first.</h3>Upgrades are blocked while the running configuration has unsaved changes. <a href=configs.htm?save=y>Save now</a>';"))
      ctx[t].rdsize := strsize(@ctx[t].webbuff)
      return

    if str.instr(@ctx[t].readbuffer,string("/upgrade.htm?Save=Upgrade+My+Controller")) == -1
      ' send header
        str.append_str(@ctx[t].webbuff,resp_ptr)
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "var div = document.getElementById('main');"))

        manifest[0] := 0
        if str.instr(@ctx[t].readbuffer,string("dev=Y")) == -1
            gur := getURL(string("/firmware/Blitzen24/Manifest.txt"),upgradeserver_ptr,0)
        else
            gur := getURL(string("/devfirmware/Blitzen24/Manifest.txt"),upgradeserver_ptr,0)

        if gur == -2
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Cant resolve "))
          str.append_str(@ctx[t].webbuff,@servername)
          str.append_str(@ctx[t].webbuff, string("';"))
          ctx[t].rdsize := strsize(@ctx[t].webbuff)
          return

        if gur == -1
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Cant connect to "))
          str.append_str(@ctx[t].webbuff,@servername)
          str.append_str(@ctx[t].webbuff, string("';"))
          ctx[t].rdsize := strsize(@ctx[t].webbuff)
          return

        if gur == -3
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Connection timed out to  "))
          str.append_str(@ctx[t].webbuff,@servername)
          str.append_str(@ctx[t].webbuff, string("';"))
          ctx[t].rdsize := strsize(@ctx[t].webbuff)
          return

        if gur == -4
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Unexpected response from  "))
          str.append_str(@ctx[t].webbuff,@servername)
          str.append_str(@ctx[t].webbuff, string("';"))
          ctx[t].rdsize := strsize(@ctx[t].webbuff)
          return

        if gur == -5
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'Not an HTTP response from  "))
          str.append_str(@ctx[t].webbuff,@servername)
          str.append_str(@ctx[t].webbuff, string("';"))
          ctx[t].rdsize := strsize(@ctx[t].webbuff)
          return

        if gur <> 200
          str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.textContent = 'HTTP response code "))
          str.dec(gur, @ctx[t].webbuff + strsize(@ctx[t].webbuff))
          str.append_str(@ctx[t].webbuff, string(" from "))
          str.append_str(@ctx[t].webbuff,@servername)
          str.append_str(@ctx[t].webbuff, string("';"))
          ctx[t].rdsize := strsize(@ctx[t].webbuff)
          return

        str.append_str(@manifest,@READBUFFER + 4 + str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)))

        str.append_str(@ctx[t].webbuff, string("str = `<font size=+1>Manifest file contents</font><br><br><pre>"))
        str.append_str(@ctx[t].webbuff,@READBUFFER + 4 + str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)))
        str.append_str(@ctx[t].webbuff, string("</pre><BR><BR><FORM METHOD='GET'><INPUT TYPE='SUBMIT' Name='Save' Value='Upgrade My Controller' OnClick=''>"))
        if str.instr(@ctx[t].readbuffer,string("dev=Y")) <> -1
            str.append_str(@ctx[t].webbuff, string("<INPUT TYPE='hidden' ID='dev' NAME='OUTPUT' Value='Y'>"))
        str.append_str(@ctx[t].webbuff, string("</FORM><BR><BR><BR><BR>`;"))
        str.append_str(@ctx[t].webbuff, string($0D, $0A, "div.insertAdjacentHTML('afterbegin', str);"))


    else
      upgradepost()


    ctx[t].rdsize := strsize(@ctx[t].webbuff)
pub upgradepost() | t
    t := TASKID()
    str.append_str(@ctx[t].webbuff,resp_ptr)
    str.append_str(@ctx[t].webbuff, string("var source = new EventSource('upgraderun.js'); ", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("source.onmessage = function(event) {", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("  document.getElementById('main').insertAdjacentHTML('beforeend', event.data + '<br>');", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("window.scrollBy(0, 500);", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("};", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("source.onerror = (err) => { ", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("source.close();", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("console.error('EventSource failed:', err);", $0D, $0A))
    str.append_str(@ctx[t].webbuff, string("};", $0D, $0A))
    return
pub httpflush(socket) | i, t
    t := TASKID()
    ctx[t].rdsize := strsize(@ctx[t].webbuff)
    if ctx[t].rdsize > 0
      ctx[t].webbuff[ctx[t].rdsize] := 0
      i := 0
      repeat until ctx[t].rdsize <= ctx[t].mss
         W6100.SendData(socket,@ctx[t].webbuff+i,ctx[t].mss)
         TASKNEXT()
         i := i + ctx[t].mss
         ctx[t].rdsize := ctx[t].rdsize - ctx[t].mss
      W6100.SendData(socket,@ctx[t].webbuff+i,ctx[t].rdsize)
      ctx[t].rdsize := 0
      ctx[t].webbuff[0] := 0
pub getURL(path,svr,download) : rt | dns_ptr, length, rcode, contentmd5, md5loc, i, bc, tfs, handle
'' Gets a file via http
'' path: pointer to string of the path to the file on the webserver
'' svr: hostname or IP of webserver
'' download: If a non-zero number, download the file and place it
'' in the /Download folder on the SD Card.
'' download: If a zero is passed, the contents of the file are placed into @READBUFFER
'' Return codes
'' -1 : Can't connect
'' -2 : Does not resolve
'' -3 : Timed Out
'' -4 : Unexpected response upon connect
'' -5 : Not an HTTP reponse
'' -6 : MD5 does not match
''
'' Otherwise, return HTTP Status code.

    servername[0] := 0
    tmp2filepath[0] := 0
    str.append_str(@servername,svr)
    dns_ptr := dnsresolver(@servername)
    if dns_ptr == -1
      return(-2)
    W6100.Open(80,W6100.PM_TCP4,W6100.IDM_BSR_Socket6_Register)

   ' Set Destination IP
    WRITEBUFFER[0] := SERVERIP[0]
    WRITEBUFFER[1] := SERVERIP[1]
    WRITEBUFFER[2] := SERVERIP[2]
    WRITEBUFFER[3] := SERVERIP[3]

    W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@WRITEBUFFER)

    ' Set Destination port
    WRITEBUFFER[0] := 00
    WRITEBUFFER[1] := 80
    W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket6_Register,2,@WRITEBUFFER)


    W6100.ConnectTCP(W6100.IDM_BSR_Socket6_Register)

    if (W6100.EstablishTCP(W6100.IDM_BSR_Socket6_Register, 1000) <> W6100.Sn_IR_TIMEOUT)
        W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@READBUFFER)
        debug("Connection Established to ", udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))
    else
        return(-1)

    debug("Checking Sn_RX_RSR Socket Status/number of bytes in buffer: ")

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,100) <> W6100.Sn_IR_TIMEOUT)
        psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
        READBUFFER[psize] := 0
        debug("Unexpected response of ",udec_(psize)," Bytes.")
        debug("Received: ",zstr_(@READBUFFER))
        W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
        return(-4)

    WRITEBUFFER[0] := 0
    str.append_str(@WRITEBUFFER,string("GET "))
    str.append_str(@WRITEBUFFER,path)
    debug("Path: ",zstr_(path))
    str.append_str(@WRITEBUFFER,string(" HTTP/1.1", $0D, $0A, "Host: "))
    str.append_str(@WRITEBUFFER,@servername)
    str.append_str(@WRITEBUFFER,string($0D, $0A, $0D, $0A))
    W6100.SendData(W6100.IDM_BSR_Socket6_Register,@WRITEBUFFER,strsize(@WRITEBUFFER))

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,100) <> W6100.Sn_IR_TIMEOUT)
        psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
        READBUFFER[psize] := 0
        'debug("Received: ",zstr_(@READBUFFER))
        ' The response headers can arrive in more than one TCP segment. Keep reading until the blank
        ' line that ends them is in the buffer; at most two full 2K reads, which READBUFFER holds.
        repeat while str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) == -1 and psize <= 2048
          if W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,100) == W6100.Sn_IR_TIMEOUT
            quit
          psize += W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER + psize)
          READBUFFER[psize] := 0
          debug("Headers continued in another read, psize = ", udec_(psize))
        if str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) == -1
          debug("End of HTTP headers not received")
          W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
          return(-5)                                   ' the caller retries the file
    else
        'W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
        return(-3)

    length := str2dec(@READBUFFER + str.instr(@READBUFFER,string("Content-Length: "))+ 16, 10)
    debug("Content Length:", udec_(length))
    rcode := str2dec(@READBUFFER + str.instr(@READBUFFER,string("HTTP/1.1 "))+ 9, 3)
    debug("HTTP Status: ", udec_(rcode))
    md5loc := str.instr(@READBUFFER,string("Content-MD5: ")) + 13
    debug(udec(md5loc))
    ' initialize @b64md5
    b64md5[0] := 0
    str.mid(@b64md5,@READBUFFER,md5loc,255)
    b64.inplaceDecode(@b64md5)
    showhash(@b64md5)
    debug(udec(download))
    debug(udec(psize))
    debug(zstr_(string("Calculated content length: ")), udec_(psize - str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) + 4 - 8))

    i := 0
    i := psize - str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) + 4 - 8
    if download <> 0
'      sd.changeDirectory(String("Download"))
      str.append_str(@tmp2filepath,String("/Download/"))
      str.append_str(@tmp2filepath,path+str.last(path, "/")+1)
      debug(zstr_(@tmp2filepath))

      sd.deleteFile(@tmp2filepath)                    ' Remove if exists (ignore error)
      handle := sd.createFileNew(@tmp2filepath)
      if handle < 0
        debug("Failed to create file ",zstr_(@tmp2filepath))
      else
        debug("Created file ",zstr_(@tmp2filepath))

      if handle >= 0
        sd.writeHandle(handle, @READBUFFER + str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) + 4,i)

    if length > i

       'debug(udec(i))
       repeat until i >= length
          ' 1 s, not 100 ms: a long download (GFX.RAW) can pause for a few hundred ms mid-stream
          If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,1000) <> W6100.Sn_IR_TIMEOUT)
             psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
'             READBUFFER[psize] := 0
'             debug("Received: ",zstr_(@READBUFFER))
             if download <> 0
                 sd.writeHandle(handle, @READBUFFER, psize)

             i := i + psize
             'debug(udec(i))
          else
              debug(udec(i))
              debug("Content Length:", udec_(length))
              W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
              ' Close the partial file, or the retry can't delete and recreate it ("Failed to create file")
              if download <> 0 and handle >= 0
                sd.closeFileHandle(handle)
              return(-3)
    W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)

    if download <> 0
      sd.closeFileHandle(handle)
      waitms(50)
      handle := sd.openFileRead(@tmp2filepath)
      if handle >= 0
        i := 0
       '
        bc := sd.fileSizeHandle(handle)
        tfs := bc
  '      debug(udec(bc))
        MD5.hashStart(@md51)

        repeat
          if bc < 64
            sd.readHandle(handle, @MD5DATA,bc)
            MD5.hashFinish(@MD5DATA,bc,tfs,@md51)
            MD5DATA[bc] :=0
            i+=bc
            quit
          else

            sd.readHandle(handle, @MD5DATA,64)
            MD5.hashBlock(@MD5DATA,@md51)
          bc -= 64
          i += 64
        sd.closeFileHandle(handle)

      sd.changeDirectory(String("/"))
      showhash(@md51)
      If long[b64md5][0] <> long[md51][0] or ...
         long[b64md5][4] <> long[md51][4] or ...
         long[b64md5][8] <> long[md51][8] or ...
         long[b64md5][12] <> long[md51][12]
         debug("MD5's do not match")
         if rcode == 200
'           W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
           return(-6)

    debug("Content Length:", udec_(length))
    debug(udec(i))



'    W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
    return(rcode)

pub upgraderun(socket) | gur, fn, i, e, r, t, frags
   t := TASKID()
   if unsaved                                     ' Refuse to start, even from a typed or bookmarked URL
     ctx[t].webbuff[0] := 0
     str.append_str(@ctx[t].webbuff,resp_evt_ptr)
     str.append_str(@ctx[t].webbuff, String("data: <h2>Save your changes first.</h2>Upgrades are blocked while the running configuration has unsaved changes.", $0A, $0A))
     ctx[t].rdsize := strsize(@ctx[t].webbuff)
     return
   stoppixels()
   W6100.stopfastrx()

    ' Zero out buffers
    ctx[t].webbuff[0] := 0

   i := 1
   e := 0
   tmpfilepath[0] := 0
   str.append_str(@ctx[t].webbuff,resp_evt_ptr)
'   str.append_str(@ctx[t].webbuff, string($0D, $0A, "var div = document.getElementById('main');"))


'   gur := getURL(string("/firmware/Blitzen24/Manifest.txt"),upgradeserver_ptr,0)
'   str.append_str(@ctx[t].webbuff, string($0D, $0A, "var div = document.getElementById('main');"))
   str.append_str(@ctx[t].webbuff, string("data: <font size=+1>Upgrade log</font>", $0A, $0A))
   httpflush(socket)
'   str.append_str(@ctx[t].webbuff, @manifest)

   if sd.newDirectory(string("Download")) == sd.SUCCESS
     debug("Create /Download directory.")
     str.append_str(@ctx[t].webbuff,String("data: Create /Download directory.",$0A, $0A))
     httpflush(socket)
   else
     str.append_str(@ctx[t].webbuff,String("data: /Download directory exists. Deleting files.",$0A, $0A))
     debug("/Download directory exists. Deleting files.")
     debug("Changing to /Download Directory.")
     httpflush(socket)
     cleandirectory(string("/Download"), socket)



   e := 0
   tmpfilepath[0] := 0

   if sd.newDirectory(string("/Backup")) == sd.SUCCESS
     str.append_str(@ctx[t].webbuff,String("data: Create /Backup directory.",$0A, $0A))
     httpflush(socket)
   else
     str.append_str(@ctx[t].webbuff,String("data: /Backup directory exists. Deleting files.",$0A, $0A))
     debug("/Backup directory exists. Deleting files.")
     debug("Changing to /Backup Directory.")
     httpflush(socket)
     cleandirectory(string("/Backup"), socket)


   fn := str.fields(@manifest, $0A)
   str.append_str(@ctx[t].webbuff,String("data: "))
   str.dec(fn,@ctx[t].webbuff + strsize(@ctx[t].webbuff))
   str.append_str(@ctx[t].webbuff,String(" lines in the manifest file.",$0A, $0A))
   httpflush(socket)

   sd.changeDirectory(string("/"))
   repeat fn - 1
      tmpfilepath[0] := 0
      str.copy_field(@tmpfilepath, str.field_pntr(@manifest, i, $0A), $0A, 256)
      str.trim(@tmpfilepath)
      str.append_str(@ctx[t].webbuff,String("data: "))
      str.append_str(@ctx[t].webbuff, String("Downloading "))
      str.append_str(@ctx[t].webbuff, @tmpfilepath)
      str.append_str(@ctx[t].webbuff, String($0A, $0A))
      httpflush(socket)
      gur := getURL(@tmpfilepath,upgradeserver_ptr,1)
      r := 0
{
      if gur <> 200
          str.append_str(@ctx[t].webbuff,String("data:  Error: "))
          case gur
            -1: str.append_str(@ctx[t].webbuff,String("Can't connect"))
           -2: str.append_str(@ctx[t].webbuff,String("Does not resolve"))
           -3: str.append_str(@ctx[t].webbuff,String("Timed Out"))
           -4: str.append_str(@ctx[t].webbuff,String("Unexpected response upon connect"))
           -5: str.append_str(@ctx[t].webbuff,String("Not an HTTP reponse"))
           -6: str.append_str(@ctx[t].webbuff,String("MD5 does not match"))
           OTHER: str.append_str(@ctx[t].webbuff,String("HTTP Response "))
                  str.append_str(@ctx[t].webbuff,str.dec(gur,-1))
         str.append_str(@ctx[t].webbuff, String($0A, $0A))
         httpflush(socket)
 }
      repeat until gur == 200 or r == 4
        if gur <> 200
          if gur == -6
             sd.deleteFile(@tmp2filepath)
                str.append_str(@ctx[t].webbuff,String("data: "))
          str.append_str(@ctx[t].webbuff, String("Deleting and retrying  "))
          str.append_str(@ctx[t].webbuff, @tmpfilepath)
          str.append_str(@ctx[t].webbuff, String($0A, $0A))
          httpflush(socket)

          gur := getURL(@tmpfilepath,upgradeserver_ptr,1)
          if gur <> 200
            str.append_str(@ctx[t].webbuff,String("data:  Error: "))
            case gur
              -1: str.append_str(@ctx[t].webbuff,String("Can't connect"))
             -2: str.append_str(@ctx[t].webbuff,String("Does not resolve"))
             -3: str.append_str(@ctx[t].webbuff,String("Timed Out"))
             -4: str.append_str(@ctx[t].webbuff,String("Unexpected response upon connect"))
             -5: str.append_str(@ctx[t].webbuff,String("Not an HTTP reponse"))
             -6: str.append_str(@ctx[t].webbuff,String("MD5 does not match"))
             OTHER: str.append_str(@ctx[t].webbuff,String("HTTP Response "))
                    str.append_str(@ctx[t].webbuff,str.dec(gur,-1))
           str.append_str(@ctx[t].webbuff, String($0A, $0A))
           httpflush(socket)
           r++

          else
           str.append_str(@ctx[t].webbuff,String("data: "))
           str.append_str(@ctx[t].webbuff, String("Retry sucessful"))
           str.append_str(@ctx[t].webbuff, String($0A, $0A))
         httpflush(socket)

      if r == 3
         e := 1
      i++
{
-1 : Can't connect
-2 : Does not resolve
-3 : Timed Out
-4 : Unexpected response upon connect
-5 : Not an HTTP reponse
-6 : MD5 does not match
}
   If e == 0

     str.append_str(@ctx[t].webbuff, String("data: Moving files to Backup"))
     str.append_str(@ctx[t].webbuff, String($0A, $0A))
     httpflush(socket)
     movedirectory(String("/"),String("/Backup"), socket)

     str.append_str(@ctx[t].webbuff, String("data: Moving new files to /"))
     str.append_str(@ctx[t].webbuff, String($0A, $0A))
     httpflush(socket)
     movedirectory(String("/Download"),String("/"), socket)


     str.append_str(@ctx[t].webbuff, String("data: Moving BLITZEN.CFG back to /"))
     str.append_str(@ctx[t].webbuff, String($0A, $0A))

     httpflush(socket)

     sd.moveFile(string("/Backup/BLITZEN.CFG"), string("/"))

     str.append_str(@ctx[t].webbuff, String("data: Checking if boot file is fragmented"))
     str.append_str(@ctx[t].webbuff, String($0A, $0A))

     httpflush(socket)

     ' fileFragments(): 1 = contiguous, >1 = fragmented, 0 = empty, <0 = check failed
     frags := sd.fileFragments(@"/_BOOT_P2.BIX")
     debug("Boot file fragments: ", sdec_(frags))

     if frags > 1

        str.append_str(@ctx[t].webbuff, String("data: Boot file is fragmented!"))
        str.append_str(@ctx[t].webbuff, String($0A, $0A))
        httpflush(socket)
        r := sd.compactFile(@"/_BOOT_P2.BIX")
        debug("compactFile: ", sdec_(r))
        if r == sd.SUCCESS
          frags := sd.fileFragments(@"/_BOOT_P2.BIX")
          debug("Boot file fragments after compact: ", sdec_(frags))

        if r == sd.SUCCESS and frags == 1
            str.append_str(@ctx[t].webbuff, String("data: Boot file compacted successfully"))
            str.append_str(@ctx[t].webbuff, String($0A, $0A))
        else
            str.append_str(@ctx[t].webbuff, String("data: Boot file NOT compacted successfully. Remove SD card and peform manual defrag."))
            str.append_str(@ctx[t].webbuff, String($0A, $0A))

        httpflush(socket)
     elseif frags == 1
        str.append_str(@ctx[t].webbuff, String("data: Boot file is not fragmented. Good to go!"))
        str.append_str(@ctx[t].webbuff, String($0A, $0A))
        httpflush(socket)
     else
        str.append_str(@ctx[t].webbuff, String("data: Could not check the boot file (missing, empty or SD error). Do not reboot until it is checked."))
        str.append_str(@ctx[t].webbuff, String($0A, $0A))
        httpflush(socket)

  '  No need to flush the last output.

     str.append_str(@ctx[t].webbuff, String("data: Done.<BR><H2> <A HREF='reboot.htm'>Click here to reboot.</A></H2>"))
     str.append_str(@ctx[t].webbuff, String($0A, $0A))

   else
     str.append_str(@ctx[t].webbuff, String("data: <h2>Errors detected. Aborting</h2>"))
     str.append_str(@ctx[t].webbuff, String($0A, $0A))

   sd.changeDirectory(string("/"))

   ctx[t].rdsize := strsize(@ctx[t].webbuff)
   startpixels()
   startrx()

pub cleandirectory(deldir, socket) | dirhandle, attrs, t
     t := TASKID()
     sd.changeDirectory(deldir)
     dirhandle := sd.openDirectory(string("."))
     if dirhandle < 0
       return
     repeat while sd.readDirectoryHandle(dirhandle)
              tmpfilepath[0] := 0
              str.append_str(@tmpfilepath,sd.fileName())
              str.Rtrim(@tmpfilepath)
              if tmpfilepath[0] == 0
                quit
              attrs := sd.attributes()
              if not (attrs & sd.ATTR_SYSTEM) and not (attrs & sd.ATTR_DIRECTORY) and not (attrs & sd.ATTR_READONLY)

                if sd.deleteFile(@tmpfilepath) == sd.SUCCESS
                   debug("Deleting file ->",zstr_(@tmpfilepath), "<-")
                   str.append_str(@ctx[t].webbuff,String("data: Deleted file "))
                   str.append_str(@ctx[t].webbuff, deldir)
                   str.append_str(@ctx[t].webbuff,String("/"))
                   str.append_str(@ctx[t].webbuff, @tmpfilepath)
                else
                   str.append_str(@ctx[t].webbuff, String(" failed"))
                   debug("Failed delete ->",zstr_(@tmpfilepath), "<-")
                str.append_str(@ctx[t].webbuff, String($0A, $0A))

              else
                debug("Skipped system/directory/readonly file ",zstr_(@tmpfilepath))
                str.append_str(@ctx[t].webbuff,String("data: Skipped system/directory/readonly file "))
                str.append_str(@ctx[t].webbuff, deldir)
                str.append_str(@ctx[t].webbuff,String("/"))
                str.append_str(@ctx[t].webbuff, @tmpfilepath)
                str.append_str(@ctx[t].webbuff, String($0A, $0A))
              httpflush(socket)
     sd.closeDirectoryHandle(dirhandle)
pub movedirectory(sourcedir,destdir, socket) | dirhandle, attrs, t
     t := TASKID()

     sd.changeDirectory(sourcedir)

     dirhandle := sd.openDirectory(string("."))
'     debug("Can't list directory ", zstr_(sourcedir))

     if dirhandle < 0
       return
     repeat while sd.readDirectoryHandle(dirhandle)
          tmpfilepath[0] := 0
          str.append_str(@tmpfilepath,sd.fileName())
          str.Rtrim(@tmpfilepath)
          if tmpfilepath[0] == 0
            quit
          attrs := sd.attributes()

          if not (attrs & sd.ATTR_SYSTEM) and not (attrs & sd.ATTR_DIRECTORY) and not (attrs & sd.ATTR_READONLY)
                tmpfilepath[0] := 0
                tmp2filepath[0] := 0
                if str.strncmp(sourcedir,String("/"),2) <> 0
                    str.append_str(@tmpfilepath, sourcedir)
                str.append_str(@tmpfilepath,String("/"))
                str.append_str(@tmpfilepath,str.rtrim(sd.fileName()))
                if  str.strncmp(destdir,String("/"),2) <> 0
                    str.append_str(@tmp2filepath, destdir)
                str.append_str(@tmp2filepath,String("/"))
                str.append_str(@tmp2filepath,str.rtrim(sd.fileName()))
                debug("Move ",zstr_(@tmpfilepath), " to ", zstr_(@tmp2filepath))
                str.append_str(@ctx[t].webbuff,String("data: Move file "))
                str.append_str(@ctx[t].webbuff, @tmpfilepath)
                str.append_str(@ctx[t].webbuff,String(" to "))
                str.append_str(@ctx[t].webbuff, @tmp2filepath)


                if sd.moveFile(@tmpfilepath, destdir) <> sd.SUCCESS

                   debug("Move ",zstr_(@tmpfilepath), " to ", zstr_(@tmp2filepath), " failed")
                   str.append_str(@ctx[t].webbuff, String(" failed"))
              str.append_str(@ctx[t].webbuff, String($0A, $0A))
          else
                debug("Skipped system/directory/readonly file ",zstr_(@tmpfilepath))
                str.append_str(@ctx[t].webbuff,String("data: Skipped system/directory/readonly file "))
                'str.append_str(@ctx[t].webbuff, @tmpfilepath)
                str.append_str(@ctx[t].webbuff, String($0A, $0A))
          httpflush(socket)
     sd.closeDirectoryHandle(dirhandle)
pub rebootjs() | t
    t := TASKID()
    if unsaved and str.instr(@ctx[t].readbuffer,string("force=Y")) == -1
      ' Warn instead of rebooting; reboot.htm?force=Y reboots anyway
      ctx[t].webbuff[0] := 0
      str.append_str(@ctx[t].webbuff,resp_js_ptr)
      str.append_str(@ctx[t].webbuff, string("if(window.rbt)clearTimeout(rbt);document.querySelector('main').innerHTML = '<center><h2>Unsaved changes</h2>Rebooting now loses the changes that have not been saved.<br><br>"))
      str.append_str(@ctx[t].webbuff, string("<a href=configs.htm?save=y>Save first</a> &nbsp; | &nbsp; <a href=reboot.htm?force=Y>Reboot anyway</a></center>';"))
      ctx[t].rdsize := strsize(@ctx[t].webbuff)
      return
    waitms(1000)
    sd.unmount()
    sd.stop()
    org
      HUBSET  ##$1000_0000    'hard reset, reboots the P2 chip
    end
PUB showhash(hash_ptr) | i
      i := 0
      repeat 16
        debug(uhex_byte_(byte[hash_ptr][i]))

        i++
PUB logo() | i, rb, rg, handle, fsize
''Writes the screen buffer to the memory of the display
  OLED.ssd1331_command($E3) ' NOP
  OLED.ssd1331_command($E3) ' NOP
  OLED.ssd1331_command(OLED.SSD1331_CMD_SETCOLUMN)  ' Set X
  OLED.ssd1331_command($0)
  OLED.ssd1331_command(95)
  OLED.ssd1331_command(OLED.SSD1331_CMD_SETROW)  ' Set Y
  OLED.ssd1331_command($0)
  OLED.ssd1331_command(63)

  OLED.ssd1331_command($A1)
  OLED.ssd1331_command($0)
  OLED.ssd1331_command($A2)
  OLED.ssd1331_command($0)

  handle := sd.openFileRead(string("GFX.raw"))
  if handle >= 0

    debug("Opened Logo")
    fsize := sd.fileSizeHandle(handle)
    repeat fsize/12288
      sd.readHandle(handle, @vbuffer, 12288)
      i := 0
        repeat 6144
                rb := vbuffer[i]
                rg := vbuffer[i+1]
                OLED.ssd1331_Data(rg)
                OLED.ssd1331_Data(rb)
                i := i+2

    sd.closeFileHandle(handle)
  OLED.clearDisplay()
  OLED.ssd1331_command($E3) ' NOP
  OLED.ssd1331_command($E3) ' NOP
  OLED.ssd1331_command(OLED.SSD1331_CMD_SETCOLUMN)  ' Set X
  OLED.ssd1331_command($0)
  OLED.ssd1331_command(95)
  OLED.ssd1331_command(OLED.SSD1331_CMD_SETROW)  ' Set Y
  OLED.ssd1331_command($0)
  OLED.ssd1331_command(63)

  OLED.ssd1331_command($A1)
  OLED.ssd1331_command($0)
  OLED.ssd1331_command($A2)
  OLED.ssd1331_command($0)
PUB displayqr(raw,fgc,bgc)|di, maxpix, c, r, pixsize
    c := 0
    r := 0
    maxpix := (qrversion*4)+21
    if maxpix <= 33
       pixsize := 2
    else
       pixsize := 1
    repeat maxpix * maxpix
      writeQR(BYTE[raw][di++],c,r,fgc,bgc,pixsize)
      c := c + pixsize
      if c + pixsize > maxpix * pixsize
        c := 0
        r := r + pixsize

'      debug(udec(c),udec(r))
       if r > 64
        return
PUB setversion(ver)
    qrversion := ver
PUB writeQR(ch,row,col,RGB,BRGB,pixsize)|i,j,mask,r

  ''Write a write to the display @ row and column
    OLED.ssd1331_command(OLED.SSD1331_CMD_SETREMAP)       ' $A0
    OLED.ssd1331_command($61)                       ' RGB Color
    OLED.ssd1331_command(OLED.SSD1331_CMD_SETCOLUMN)  ' Set X
    OLED.ssd1331_command(row)
    OLED.ssd1331_command(row + pixsize)
    OLED.ssd1331_command(OLED.SSD1331_CMD_SETROW)  ' Set Y
    OLED.ssd1331_command(col)
    OLED.ssd1331_command(col + pixsize)

    repeat pixsize * pixsize
'        debug(udec(ch))
        if ch == 255
           OLED.ssd1331_Data(OLED.RG16bitColor(RGB)) ' Set foreground color
           OLED.ssd1331_Data(OLED.GB16bitColor(RGB))
        else
           OLED.ssd1331_Data(OLED.RG16bitColor(BRGB))' Set background color
           OLED.ssd1331_Data(OLED.GB16bitColor(BRGB))
PUB HardwareVer() : r
    PINCLEAR(ENC_P)
    org
     DRVH #ENC_P
     FLTL #ENC_P
     DRVL #ENC_P
     FLTL #ENC_P
    end
    waitus(1)
    debug(udec_(PINREAD(ENC_P)))
    if PINREAD(ENC_P) == 1
           ' Pin has a pullup
     debug("Version 2 hardware")
      r := 2
    else
      debug("Version 1 hardware")
      r := 1
    return r

PUB URLDecode(src, dst) : len | c, hex1, hex2
'' Decode URL-encoded string from src to dst
'' src: pointer to source URL-encoded string (zero-terminated)
'' dst: pointer to destination buffer
'' Returns: length of decoded string

  len := 0

  repeat while c := BYTE[src++]
    case c
      "+":
        ' Plus sign becomes space
        BYTE[dst++] := " "
        len++

      "%":
        ' Percent encoding - next two chars are hex digits
        hex1 := BYTE[src++]
        hex2 := BYTE[src++]

        if hex1 and hex2
          ' Convert hex digits to byte value
          BYTE[dst++] := (HexDigitValue(hex1) << 4) | HexDigitValue(hex2)
          len++
        else
          ' Invalid encoding, just copy the percent
          BYTE[dst++] := "%"
          len++
          if hex1
            BYTE[dst++] := hex1
            len++

      other:
        ' Regular character, copy as-is
        BYTE[dst++] := c
        len++

  ' Null terminate the destination
  BYTE[dst] := 0

PRI HexDigitValue(c) : value
'' Convert ASCII hex digit to numeric value

  case c
    "0".."9":
      return c - "0"
    "A".."F":
      return c - "A" + 10
    "a".."f":
      return c - "a" + 10
    other:
      return 0

PUB HTMLEncode(src, dst) : len | c
'' Encode string to HTML-safe format
'' src: pointer to source string (zero-terminated)
'' dst: pointer to destination buffer (must be large enough - up to 6x source size)
'' Returns: length of encoded string

  len := 0

  repeat while c := BYTE[src++]
    case c
      "<":
        ' Less-than becomes &lt;
        BYTEMOVE(dst, @"&lt;", 4)
        dst += 4
        len += 4

      ">":
        ' Greater-than becomes &gt;
        BYTEMOVE(dst, @"&gt;", 4)
        dst += 4
        len += 4

      "&":
        ' Ampersand becomes &amp;
        BYTEMOVE(dst, @"&amp;", 5)
        dst += 5
        len += 5

      '"':
        ' Double quote becomes &quot;
        BYTEMOVE(dst, @"&quot;", 6)
        dst += 6
        len += 6

      "'":
        ' Single quote becomes &#39;
        BYTEMOVE(dst, @"&#39;", 5)
        dst += 5
        len += 5

      other:
        ' Regular character, copy as-is
        BYTE[dst++] := c
        len++

  ' Null terminate the destination
  BYTE[dst] := 0
PUB singlequoteescape(src, dst) : len | c
  len := 0

  repeat while c := BYTE[src++]
    case c
      "\":
        ' "'" becomes "\\"
        BYTEMOVE(dst, @"\\", 2)
        dst += 2
        len += 2

      "'":
        ' "'" becomes "\'"
        BYTEMOVE(dst, @"\'", 2)
        dst += 2
        len += 2

      other:
        ' Regular character, copy as-is
        BYTE[dst++] := c
        len++
  ' Null terminate the destination
  BYTE[dst] := 0
PUB MDNSopen() | temp
 MDNSGRP[0] := 1
 MDNSGRP[1] := 0
 MDNSGRP[2] := $5E
 MDNSGRP[3] := 0
 MDNSGRP[4] := 0
 MDNSGRP[5] := 251
 MDNSGRP[6] := $14
 MDNSGRP[7] := $E9
 W6100.writereg(W6100.REG_Sn_DHAR,W6100.IDM_BSR_Socket7_Register,6,@MDNSGRP)
 MDNSGRP[2] := 224
 W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket7_Register,4,@MDNSGRP+2)
 W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket7_Register,2,@MDNSGRP+6)
 'temp := W6100.PM_M_UDP4
 'W6100.writereg(W6100.REG_Sn_Mr,W6100.IDM_BSR_Socket7_Register,1,@temp)
 W6100.Open(5353,W6100.PM_M_UDP4,W6100.IDM_BSR_Socket7_Register)

PUB MDNScheck() | flags, SrcPort, SrcIP
  BYTEFILL(@MDNSBUFFER,0,1536)
  W6100.readreg(W6100.REG_Sn_IR,W6100.IDM_BSR_Socket7_Register,1,@MDNSBUFFER)

'  debug("Checking Sn_IR Socket Status: ", uhex_(MDNSBUFFER[0]))
  if  W6100.ReceiveData(W6100.IDM_BSR_Socket7_Register,1) <> W6100.Sn_IR_TIMEOUT
'    W6100.readreg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket7_Register,2,@SrcPort)
'    byteswap(@SrcPort,@SrcPort+1,1)

'    W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket7_Register,4,@SrcIP)

    psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket7_Register,@MDNSBUFFER)
    flags := (MDNSBUFFER[10] << 8) | MDNSBUFFER[11]
    if flags < $8000 and MDNSBUFFER[21+MDNSBUFFER[20]+8] == 1 and MDNSBUFFER[20] == strsize(@hostname)' QR bit = 0, it's a query and Is it an A record?
       MDNSBUFFER[21 + MDNSBUFFER[20]] := 0 ' Terminate requested hostname with 0
       str.lcstr(@MDNSBUFFER+21) ' Why do resolvers send upper case? Come on man!
'       debug(zstr(@MDNSBUFFER+21))
'       debug(zstr(@hostname))
       if STRCOMP(@MDNSBUFFER+21, @hostname) == -1
'            debug("Matched hostname")
            SrcPort := WORD[@MDNSBUFFER+6]
            byteswap(@SrcPort,@SrcPort+1,1)
            SrcIP := LONG[@MDNSBUFFER+2]
'            debug("UDP Port Number: ",udec(SrcPort))
'            debug("UDP Source IP: ",udec_(byte[@SrcIP]),".",udec_(byte[@SrcIP+1]),".",udec_(byte[@SrcIP+2]),".",udec_(byte[@SrcIP+3]))
'            debug("UDP Source IP: ",udec_(MDNSBUFFER[2]),".",udec_(MDNSBUFFER[3]),".",udec_(MDNSBUFFER[4]),".",udec_(MDNSBUFFER[5]) )
'            debug("UDP Port Number: ",uhex_(MDNSBUFFER[6]), uhex_(MDNSBUFFER[7]) )
'            debug(udec(MDNSBUFFER[21+MDNSBUFFER[20]+8]))
            if MDNSBUFFER[21+MDNSBUFFER[20]+8] == 1 ' Is it an A record?
                MDNSbeacon(MDNSBUFFER[8],MDNSBUFFER[9],SrcPort,SrcIP)
            if MDNSBUFFER[21+MDNSBUFFER[20]+8] == $1C ' Is it an AAAA record?
                MDNSbeaconNOANSWER(MDNSBUFFER[8],MDNSBUFFER[9],SrcPort,SrcIP)
PUB MDNSbeaconNOANSWER(id1,id2,SrcPort,SrcIP) | temp
    if SrcPort == 5353
        W6100.SendData(W6100.IDM_BSR_Socket7_Register,@MDNSBUFFER,build_mdns_negative_aaaa_response(id1,id2))
    else
        temp := W6100.PM_UDP4
        W6100.writereg(W6100.REG_Sn_Mr,W6100.IDM_BSR_Socket7_Register,1,@temp)
        waitms(10)
        temp := W6100.CR_CLOSE
        W6100.writereg(W6100.REG_Sn_CR,W6100.IDM_BSR_Socket7_Register,1,@temp)
        REPEAT until W6100.readreg(W6100.REG_Sn_SR,W6100.IDM_BSR_Socket7_Register,1,@temp) == W6100.SOCK_CLOSED

        W6100.Open(5353,W6100.PM_UDP4,W6100.IDM_BSR_Socket7_Register)
        W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket7_Register,4,@SrcIP)
        byteswap(@SrcPort,@SrcPort+1,1)
        W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket7_Register,2,@SrcPort)
'        debug(ubin(w6100.readreg(W6100.REG_Sn_Mr,W6100.IDM_BSR_Socket7_Register,1,@temp)))
        W6100.SendData(W6100.IDM_BSR_Socket7_Register,@MDNSBUFFER,build_mdns_negative_aaaa_response(id1,id2))
        waitms(20)
        temp := W6100.CR_CLOSE
        W6100.writereg(W6100.REG_Sn_CR,W6100.IDM_BSR_Socket7_Register,1,@temp)
        REPEAT until W6100.readreg(W6100.REG_Sn_SR,W6100.IDM_BSR_Socket7_Register,1,@temp) == W6100.SOCK_CLOSED
        MDNSopen()

PUB MDNSbeacon(id1,id2,SrcPort,SrcIP) | temp

  if SrcPort == 5353
        W6100.SendData(W6100.IDM_BSR_Socket7_Register,@MDNSBUFFER,build_mdns_response(id1,id2))

        W6100.SendData(W6100.IDM_BSR_Socket7_Register,@MDNSBUFFER,build_mdns_announcement(0,0))

  else

        debug("Unicast Received")
        debug("UDP Source IP: ",udec_(byte[@SrcIP]),".",udec_(byte[@SrcIP+1]),".",udec_(byte[@SrcIP+2]),".",udec_(byte[@SrcIP+3]))
        debug("UDP Port Number: ", udec_(SrcPort))
        W6100.Disconnect(W6100.IDM_BSR_Socket7_Register)
        temp := W6100.PM_UDP4
        W6100.writereg(W6100.REG_Sn_Mr,W6100.IDM_BSR_Socket7_Register,1,@temp)

        temp := W6100.CR_CLOSE
        W6100.writereg(W6100.REG_Sn_CR,W6100.IDM_BSR_Socket7_Register,1,@temp)
        REPEAT until W6100.readreg(W6100.REG_Sn_SR,W6100.IDM_BSR_Socket7_Register,1,@temp) == W6100.SOCK_CLOSED

        W6100.Open(5353,W6100.PM_UDP4,W6100.IDM_BSR_Socket7_Register)
        W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket7_Register,4,@SrcIP)
        byteswap(@SrcPort,@SrcPort+1,1)
        W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket7_Register,2,@SrcPort)
'        debug(ubin(w6100.readreg(W6100.REG_Sn_Mr,W6100.IDM_BSR_Socket7_Register,1,@temp)))
        W6100.SendData(W6100.IDM_BSR_Socket7_Register,@MDNSBUFFER,build_mdns_response(id1,id2))
        waitms(20)

'        REPEAT until W6100.readreg(W6100.REG_Sn_IR,W6100.IDM_BSR_Socket7_Register, 1, @temp) == W6100.Sn_IR_SENDOK

        temp := W6100.CR_CLOSE
        W6100.writereg(W6100.REG_Sn_CR,W6100.IDM_BSR_Socket7_Register,1,@temp)
        REPEAT until W6100.readreg(W6100.REG_Sn_SR,W6100.IDM_BSR_Socket7_Register,1,@temp) == W6100.SOCK_CLOSED
        MDNSopen()

PUB build_mdns_announcement(id1,id2) : packet_length | ptr, len, i

'' Build mDNS announcement packet in MDNSBUFFER
'' Uses HOSTNAME (null-terminated string) and IPADDRESS (4 bytes)
'' Returns total packet length

  BYTEFILL(@MDNSBUFFER,0,1536)
  ptr := @MDNSBUFFER

  ' ===== DNS HEADER (12 bytes) =====

  ' Transaction ID: 0x0000
  byte[ptr++] := id1
  byte[ptr++] := id2

  ' Flags: 0x8400 (Response, Authoritative)
  byte[ptr++] := $84
  byte[ptr++] := $00

  ' Question Count: 0x0000
  byte[ptr++] := $00
  byte[ptr++] := $00

  ' Answer Count: 0x0001
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' Authority Count: 0x0000
  byte[ptr++] := $00
  byte[ptr++] := $00

  ' Additional Count: 0x0000
  byte[ptr++] := $00
  byte[ptr++] := $00

  ' ===== ANSWER SECTION =====

  ' NAME: hostname.local (DNS label format)

  ' First label: hostname (length-prefixed)
  len := strsize(@HOSTNAME)
  byte[ptr++] := len                    ' Length byte
  repeat i from 0 to len-1              ' Copy hostname
    byte[ptr++] := str.lower(byte[@HOSTNAME][i])

  ' Second label: "local" (length-prefixed)
  byte[ptr++] := 5                      ' Length of "local"
  byte[ptr++] := "l"
  byte[ptr++] := "o"
  byte[ptr++] := "c"
  byte[ptr++] := "a"
  byte[ptr++] := "l"

  ' Root label (terminator)
  byte[ptr++] := $00

  ' TYPE: 0x0001 (A record - IPv4 address)
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' CLASS: 0x8001 (IN class with cache-flush bit not set)
  byte[ptr++] := $80
  byte[ptr++] := $01

  ' TTL: 120 seconds (0x00000078)
  byte[ptr++] := $00
  byte[ptr++] := $00
  byte[ptr++] := $00
  byte[ptr++] := $78

  ' RDLENGTH: 0x0004 (4 bytes for IPv4 address)
  byte[ptr++] := $00
  byte[ptr++] := $04

  ' RDATA: IP Address (4 bytes)
  byte[ptr++] := IPADDRESS[0]
  byte[ptr++] := IPADDRESS[1]
  byte[ptr++] := IPADDRESS[2]
  byte[ptr++] := IPADDRESS[3]

  ' Return total packet length
  packet_length := ptr - @MDNSBUFFER

PUB build_mdns_response(id1,id2) : packet_length | ptr, len, i

'' Build mDNS response packet in MDNSBUFFER (solicited response to query)
'' Uses HOSTNAME (null-terminated string) and IPADDRESS (4 bytes)
'' Returns total packet length

  BYTEFILL(@MDNSBUFFER, 0, 1536)
  ptr := @MDNSBUFFER

  ' ===== DNS HEADER (12 bytes) =====

  ' Transaction ID: 0x0000
  byte[ptr++] := id1
  byte[ptr++] := id2

  ' Flags: 0x8400 (Response, Authoritative)
  byte[ptr++] := $84
  byte[ptr++] := $00

  ' Question Count: 0x0001 (CHANGED - echo the question)
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' Answer Count: 0x0001
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' Authority Count: 0x0000
  byte[ptr++] := $00
  byte[ptr++] := $00

  ' Additional Count: 0x0000
  byte[ptr++] := $00
  byte[ptr++] := $00

  ' ===== QUESTION SECTION (echo what was asked) =====

  ' First label: hostname (length-prefixed)
  len := strsize(@HOSTNAME)
  byte[ptr++] := len                    ' Length byte
  repeat i from 0 to len-1              ' Copy hostname
    byte[ptr++] := str.lower(byte[@HOSTNAME][i])

  ' Second label: "local" (length-prefixed)
  byte[ptr++] := 5                      ' Length of "local"
  byte[ptr++] := "l"
  byte[ptr++] := "o"
  byte[ptr++] := "c"
  byte[ptr++] := "a"
  byte[ptr++] := "l"

  ' Root label (terminator)
  byte[ptr++] := $00

  ' QTYPE: 0x0001 (A record)
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' QCLASS: 0x0001 (IN class - no cache-flush in questions)
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' ===== ANSWER SECTION =====

  ' NAME: Use compression pointer to question (offset 12 = 0x0C)
  byte[ptr++] := $C0                    ' Pointer flag (top 2 bits = 11)
  byte[ptr++] := $0C                    ' Offset to question name at byte 12

  ' TYPE: 0x0001 (A record - IPv4 address)
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' CLASS: 0x8001 (IN class with cache-flush bit not set)
  byte[ptr++] := $00
  byte[ptr++] := $01

  ' TTL: 120 seconds (0x00000078)
  byte[ptr++] := $00
  byte[ptr++] := $00
  byte[ptr++] := $00
  byte[ptr++] := $78

  ' RDLENGTH: 0x0004 (4 bytes for IPv4 address)
  byte[ptr++] := $00
  byte[ptr++] := $04

  ' RDATA: IP Address (4 bytes)
  byte[ptr++] := IPADDRESS[0]
  byte[ptr++] := IPADDRESS[1]
  byte[ptr++] := IPADDRESS[2]
  byte[ptr++] := IPADDRESS[3]

  ' Return total packet length
  packet_length := ptr - @MDNSBUFFER

PUB build_mdns_negative_aaaa_response(id1,id2) : packet_length | ptr, len, i

  BYTEFILL(@MDNSBUFFER, 0, 1536)
  ptr := @MDNSBUFFER

  ' DNS Header
  byte[ptr++] := id1  ' Transaction ID
  byte[ptr++] := id2
  byte[ptr++] := $84  ' Response, Authoritative
  byte[ptr++] := $00
  byte[ptr++] := $00  ' Questions: 1
  byte[ptr++] := $01
  byte[ptr++] := $00  ' Answers: 0 (no AAAA record)
  byte[ptr++] := $00
  byte[ptr++] := $00  ' Authority: 0
  byte[ptr++] := $00
  byte[ptr++] := $00  ' Additional: 1 (NSEC record)
  byte[ptr++] := $01

  ' Question section (echo the AAAA query)
  len := strsize(@HOSTNAME)
  byte[ptr++] := len
  repeat i from 0 to len-1
    byte[ptr++] := str.lower(byte[@HOSTNAME][i])
  byte[ptr++] := 5
  bytemove(ptr, string("local"), 5)
  ptr += 5
  byte[ptr++] := $00

  byte[ptr++] := $00  ' QTYPE: AAAA
  byte[ptr++] := $1C
  byte[ptr++] := $00  ' QCLASS: IN
  byte[ptr++] := $01

  ' Additional section: NSEC record
  byte[ptr++] := $C0  ' Name compression pointer
  byte[ptr++] := $0C

  byte[ptr++] := $00  ' TYPE: NSEC
  byte[ptr++] := $2F
  byte[ptr++] := $80  ' CLASS: IN + cache-flush
  byte[ptr++] := $01
  byte[ptr++] := $00  ' TTL: 120 seconds
  byte[ptr++] := $00
  byte[ptr++] := $00
  byte[ptr++] := $78

  ' RDLENGTH - will calculate
  i := ptr
  ptr += 2

  ' RDATA: Next domain name (same as this one)
  byte[ptr++] := $C0
  byte[ptr++] := $0C

  ' Type bitmap: Indicates we have A records but not AAAA
  ' Window block 0, bitmap length 1
  byte[ptr++] := $00  ' Window number
  byte[ptr++] := $01  ' Bitmap length
  byte[ptr++] := $40  ' Bit 1 set = A record exists (bit 0=unused, bit 1=A)

  ' Fill RDLENGTH
  len := ptr - i - 2
  byte[i] := len.BYTE[1]
  byte[i+1] := len.BYTE[0]

  packet_length := ptr - @MDNSBUFFER


