  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('SUBNETMASK2').value='"))
  str.append_str(@webbuff,str.dec(SUBNETMASK[2],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('SUBNETMASK3').value='"))
  str.append_str(@webbuff,str.dec(SUBNETMASK[3],-1))
  str.append_str(@webbuff, string("';"))

' Set Gateway in form
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('GATEWAY0').value='"))
  str.append_str(@webbuff,str.dec(GATEWAY[0],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('GATEWAY1').value='"))
  str.append_str(@webbuff,str.dec(GATEWAY[1],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('GATEWAY2').value='"))
  str.append_str(@webbuff,str.dec(GATEWAY[2],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('GATEWAY3').value='"))
  str.append_str(@webbuff,str.dec(GATEWAY[3],-1))
  str.append_str(@webbuff, string("';"))

' Set DNS in form
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('DNS0').value='"))
  str.append_str(@webbuff,str.dec(DNS[0],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('DNS1').value='"))
  str.append_str(@webbuff,str.dec(DNS[1],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('DNS2').value='"))
  str.append_str(@webbuff,str.dec(DNS[2],-1))
  str.append_str(@webbuff, string("';"))
  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('DNS3').value='"))
  str.append_str(@webbuff,str.dec(DNS[3],-1))
  str.append_str(@webbuff, string("';"))

' Set Speed and Duplex
  CASE SPEEDDUPLEX
        0: idx:=0
        4: idx:=1
        5: idx:=2
        6: idx:=3
        7: idx:=4

  str.append_str(@webbuff, string($0D, $0A, "document.getElementById('SD').selectedIndex = '"))
  str.append_str(@webbuff,str.dec(idx,-1))
  str.append_str(@webbuff, string("'; "))


  rdsize := strsize(@webbuff)

PUB countersjs()
' Zero out buffer
   webbuff[0] := 0

' send header
   str.append_str(@webbuff,resp_ptr)

   str.append_str(@webbuff, string($0D, $0A, "var myTable = document.getElementById('stats');"))

   str.append_str(@webbuff, string($0D, $0A, "myTable.rows[0].cells[1].innerHTML = '"))
   str.append_str(@webbuff,str.dec(wdpps,-1))
   str.append_str(@webbuff, string(" pkt/sec';"))
   str.append_str(@webbuff, string($0D, $0A, "myTable.rows[1].cells[1].innerHTML = '"))
   str.append_str(@webbuff,str.dec(wddps,-1))
   str.append_str(@webbuff, string(" drops/sec';"))

   rdsize := strsize(@webbuff)
PUB configjs() | dns_ptr
    ' Zero out buffers
    webbuff[0] := 0
    servername[0] := 0
    ' send header
    str.append_str(@webbuff,resp_ptr)
    str.append_str(@webbuff, string($0D, $0A, "var div = document.getElementById('upgrade');"))

    str.append_str(@servername,upgradeserver_ptr)

    dns_ptr := dnsresolver(@servername)
    if dns_ptr == -1
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Cant resolve "))
        str.append_str(@webbuff,@servername)
        str.append_str(@webbuff, string("';"))
        rdsize := strsize(@webbuff)
        return
    W6100.Open(80,W6100.PM_TCP4,W6100.IDM_BSR_Socket6_Register)

   ' Set Destination IP
    WRITEBUFFER[0] := SERVERIP[0]
    WRITEBUFFER[1] := SERVERIP[1]
    WRITEBUFFER[2] := SERVERIP[2]
    WRITEBUFFER[3] := SERVERIP[3]

    W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@WRITEBUFFER)

    ' Set Destination port
    WRITEBUFFER[0] := 00
    WRITEBUFFER[1] := 80
    W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket6_Register,2,@WRITEBUFFER)


    W6100.ConnectTCP(W6100.IDM_BSR_Socket6_Register)
'    W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@READBUFFER)
'    debug("Connection Established to ", udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))

    if (W6100.EstablishTCP(W6100.IDM_BSR_Socket6_Register) <> W6100.Sn_IR_TIMEOUT)
        W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@READBUFFER)
        debug("Connection Established to ", udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))
    else
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Cant connect to "))
        str.append_str(@webbuff,@servername)
        str.append_str(@webbuff, string("';"))
        rdsize := strsize(@webbuff)
        return



    debug("Checking Sn_RX_RSR Socket Status/number of bytes in buffer: ")

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,10000) <> W6100.Sn_IR_TIMEOUT)
 '     W6100.ReceiveData(socket,100000)
        psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
        READBUFFER[psize] := 0
        debug("Received: ",zstr_(@READBUFFER))


    WRITEBUFFER[0] := 0
    str.append_str(@WRITEBUFFER,string("GET /firmware/Blitzen24/upgrade.txt HTTP/1.1", $0D, $0A, "Host: "))
    str.append_str(@WRITEBUFFER,@servername)
    str.append_str(@WRITEBUFFER,string($0D, $0A, $0D, $0A))
    W6100.SendData(W6100.IDM_BSR_Socket6_Register,@WRITEBUFFER,strsize(@WRITEBUFFER))

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,10000) <> W6100.Sn_IR_TIMEOUT)
 '     W6100.ReceiveData(socket,100000)
        psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
        READBUFFER[psize] := 0
        debug("Received: ",zstr_(@READBUFFER))

    if str.instr(@READBUFFER,string("HTTP/1.1 200")) == -1
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Response Code "))
        str.mid(@webbuff+strsize(@webbuff), @READBUFFER, str.instr(@READBUFFER,string("HTTP/1.1"))+8, (str.instr(@READBUFFER,string("HTTP/1.1"))) + 4 )
        str.append_str(@webbuff,string("';"))
    else
        if str.instr(@READBUFFER + str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) + 4,@buildver) == -1
          str.append_str(@webbuff, string($0D, $0A, "div.innerHTML = '<A HREF=/upgrade.htm>Upgrade Available</A> <br> <font size=2>"))
          str.mid(@webbuff+strsize(@webbuff),@READBUFFER, str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) + 4,str.instr(@READBUFFER+str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)) + 4,String($0D, $0A)))
          str.append_str(@webbuff, string("</font>';"))
        else
          str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Firmware up to date.';"))
    rdsize := strsize(@webbuff)
    W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
pub downloadconfig()
' Zero out buffer
  webbuff[0] := 0

' send header
  str.append_str(@webbuff,resp_dl_ptr)
  rdsize := strsize(@webbuff)
' Copy running config into web buffer
  bytemove(@webbuff + rdsize, @PIXELCONFIG, @SPEEDDUPLEX - @PIXELCONFIG + 1)
  rdsize := rdsize + (@SPEEDDUPLEX - @PIXELCONFIG) + 1


pub dhcpclient() | i
' Clear IP Saved in config
  IPADDRESS[0] := 0
  IPADDRESS[1] := 0
  IPADDRESS[2] := 0
  IPADDRESS[3] := 0



  debug("Configuring Protocol Mode UDP on Socket 0", $0D, $0A)
  W6100.Open(68,W6100.PM_UDP4,W6100.IDM_BSR_Socket0_Register)

  ' Set Destination IP
  WRITEBUFFER[0] := 255
  WRITEBUFFER[1] := 255
  WRITEBUFFER[2] := 255
  WRITEBUFFER[3] := 255
  W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket0_Register,4,@WRITEBUFFER)

  ' Set Destination port
  WRITEBUFFER[0] := 00
  WRITEBUFFER[1] := 67
  W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket0_Register,2,@WRITEBUFFER)


  ' Set XID
  RequestID[0] := prng.xrandomize($00,$FF)
  RequestID[1] := prng.xrandomize($00,$FF)
  RequestID[2] := prng.xrandomize($00,$FF)
  RequestID[3] := prng.xrandomize($00,$FF)
  debug("Set XID to: ", uhex_(RequestID[0]),":", uhex_(RequestID[1]),":", uhex_(RequestID[2]),":", uhex_(RequestID[3]))

  WRITEBUFFER[0]  := $01 'Op $01 This is a discover packet
  WRITEBUFFER[1]  := $01 'HType $01 Ethernet xBase-T
  WRITEBUFFER[2]  := $06 'HLen $06 because we have 6 Octets in the hardware address.
  WRITEBUFFER[3]  := $00 'Hops setting Hops counter to 0. Is incremented by DHCP relays
  WRITEBUFFER[4]  := RequestID[0] 'XID Unique ID
  WRITEBUFFER[5]  := RequestID[1] 'XID Unique ID
  WRITEBUFFER[6]  := RequestID[2] 'XID Unique ID
  WRITEBUFFER[7]  := RequestID[3] 'XID Unique ID
  WRITEBUFFER[8]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[9]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[10] := $80 'Flags $80 sets this to broadcast from the DHCP server, becasue we are not on the network yet.
  WRITEBUFFER[11] := $00 'Flags Reserved
  WRITEBUFFER[12] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[13] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[14] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[15] := $00 'CIAddr We have no IP yet, so set to $00
  WRITEBUFFER[16] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[17] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[18] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[19] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[20] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[21] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[22] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[23] := $00 'SIAddr Client Request, so set to $00
  WRITEBUFFER[24] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[25] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[26] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[27] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[28] := $00 'CHAddr MAC address
  WRITEBUFFER[29] := $08 'CHAddr MAC address
  WRITEBUFFER[30] := $DC 'CHAddr MAC address
  WRITEBUFFER[31] := $00 'CHAddr MAC address
  WRITEBUFFER[32] := $00 'CHAddr MAC address
  WRITEBUFFER[33] := $00 'CHAddr MAC address
  BYTEFILL(@WRITEBUFFER + 34, $00, 10) 'CHAddr fill with 0's
  BYTEFILL(@WRITEBUFFER + 44, $00, 64) 'bootp.server fill with 0's
  BYTEFILL(@WRITEBUFFER + 108, $00, 128) 'File fill with 0's
  WRITEBUFFER[236] := $63 'Magic Cookie
  WRITEBUFFER[237] := $82 'Magic Cookie
  WRITEBUFFER[238] := $53 'Magic Cookie
  WRITEBUFFER[239] := $63 'Magic Cookie
  WRITEBUFFER[240] :=  53 'Option 53
  WRITEBUFFER[241] := $01 'Option 53 Length
  WRITEBUFFER[242] := $01 'Option 53 Discovery Value
  WRITEBUFFER[243] :=  55 'Option 55
  WRITEBUFFER[244] := $03 'Option 55 Length
  WRITEBUFFER[245] := $01 'Option 55 Request Subnet Mask
  WRITEBUFFER[246] := $03 'Option 3 Request Router
  WRITEBUFFER[247] := $06 'Option 6 Request DNS Server
  WRITEBUFFER[248] := $FF 'End this shit

  W6100.SendData(W6100.IDM_BSR_Socket0_Register,@WRITEBUFFER,249)

  repeat until READBUFFER[12] == RequestID[0] && READBUFFER[13] == RequestID[1] && READBUFFER[14] == RequestID[2] && READBUFFER[15] == RequestID[3]
     repeat until W6100.ReceiveData(W6100.IDM_BSR_Socket0_Register,1) == 0
     psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket0_Register,@READBUFFER)

    debug("UDP Header Information: ", uhex_(READBUFFER[0]),uhex_(READBUFFER[1]) )

    debug("UDP Source IP: ",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]),".",udec_(READBUFFER[4]),".",udec_(READBUFFER[5]) )

    debug("UDP Port Number: ",udec_(READBUFFER[6]), udec_(READBUFFER[7]) )

    debug("Received XID is: ",uhex_(READBUFFER[12]),":",uhex_(READBUFFER[13]),":",uhex_(READBUFFER[14]),":",uhex_(READBUFFER[15]))

  debug("DHCP Assigned IP Address: ",udec_(READBUFFER[24]),".", udec_(READBUFFER[25]),".",udec_(READBUFFER[26]),".",udec_(READBUFFER[27])  )

  IPADDRESS[0] := READBUFFER[24]
  IPADDRESS[1] := READBUFFER[25]
  IPADDRESS[2] := READBUFFER[26]
  IPADDRESS[3] := READBUFFER[27]

  debug("Request IP Address: ", udec_(IPADDRESS[0]),".", udec_(IPADDRESS[1]),".",udec_(IPADDRESS[2]),".",udec_(IPADDRESS[3]))

  debug("Magic Cookie: ", uhex_(READBUFFER[244]), uhex_(READBUFFER[245]),uhex_(READBUFFER[246]), uhex_(READBUFFER[247]) )

  i:=248
  repeat until i >= psize || READBUFFER[i] == $FF
    case READBUFFER[i]
      53  :
             DHCPMESSAGETYPE := READBUFFER[i+2]
             debug("DHCP Message Type: ", udec_(READBUFFER[i+2]))

             i := i + 3
      54  :
               debug("DHCP Server: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               DHCPSERVER[0] := READBUFFER[i+2]
               DHCPSERVER[1] := READBUFFER[i+3]
               DHCPSERVER[2] := READBUFFER[i+4]
               DHCPSERVER[3] := READBUFFER[i+5]
               i := i + 6

      1 :
               debug("DHCP Subnet Mask: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               SUBNETMASK[0] := READBUFFER[i+2]
               SUBNETMASK[1] := READBUFFER[i+3]
               SUBNETMASK[2] := READBUFFER[i+4]
               SUBNETMASK[3] := READBUFFER[i+5]
               i := i + 6
      3 :
               debug("DHCP Gateway: " , udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               GATEWAY[0] := READBUFFER[i+2]
               GATEWAY[1] := READBUFFER[i+3]
               GATEWAY[2] := READBUFFER[i+4]
               GATEWAY[3] := READBUFFER[i+5]
               i := i + 6
      6 :
               debug("DNS Server: " , udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               DNS[0] := READBUFFER[i+2]
               DNS[1] := READBUFFER[i+3]
               DNS[2] := READBUFFER[i+4]
               DNS[3] := READBUFFER[i+5]
               i := i + 6

      $ff :
               debug("Detected end of DHCP Options.")

      OTHER :
               debug("DHCP Option Unknown: ", udec_(READBUFFER[i]), " Incrementing ", udec_(READBUFFER[i+1] + 2))
               i++
               i := i + READBUFFER[i]
               i++


  W6100.readreg(W6100.REG_SIPR0,W6100.IDM_BSR_Common_Register,4,@READBUFFER)
  debug("Current IP Address: ",udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))

  W6100.readreg(W6100.REG_GAR0,W6100.IDM_BSR_Common_Register,4,@READBUFFER)
  debug("Current Subnet Mask: ",udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))

  WRITEBUFFER[0]  := $01 'Op $01 This is a request packet
  WRITEBUFFER[1]  := $01 'HType $01 Ethernet xBase-T
  WRITEBUFFER[2]  := $06 'HLen $06 because we have 6 Octets in the hardware address.
  WRITEBUFFER[3]  := $00 'Hops setting Hops counter to 0. Is incremented by DHCP relays
  WRITEBUFFER[4]  := RequestID[0] 'XID Unique ID
  WRITEBUFFER[5]  := RequestID[1] 'XID Unique ID
  WRITEBUFFER[6]  := RequestID[2] 'XID Unique ID
  WRITEBUFFER[7]  := RequestID[3] 'XID Unique ID
  WRITEBUFFER[8]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[9]  := $00 'Secs Elapsed Seconds (Not used)
  WRITEBUFFER[10] := $80 'Flags $80 sets this to broadcast from the DHCP server, becasue we are not on the network yet.
  WRITEBUFFER[11] := $00 'Flags Reserved
  WRITEBUFFER[12] := IPADDRESS[0] 'CIAddr
  WRITEBUFFER[13] := IPADDRESS[1] 'CIAddr
  WRITEBUFFER[14] := IPADDRESS[2] 'CIAddr
  WRITEBUFFER[15] := IPADDRESS[3] 'CIAddr
  WRITEBUFFER[16] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[17] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[18] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[19] := $00 'YIAddr Client Request, so set to $00
  WRITEBUFFER[20] := DHCPSERVER[0] 'SIAddr DHCP Server IP
  WRITEBUFFER[21] := DHCPSERVER[1] 'SIAddr DHCP Server IP
  WRITEBUFFER[22] := DHCPSERVER[2] 'SIAddr DHCP Server IP
  WRITEBUFFER[23] := DHCPSERVER[3] 'SIAddr DHCP Server IP
  WRITEBUFFER[24] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[25] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[26] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[27] := $00 'GIAddr Client Request, so set to $00
  WRITEBUFFER[28] := $00 'CHAddr MAC address
  WRITEBUFFER[29] := $08 'CHAddr MAC address
  WRITEBUFFER[30] := $DC 'CHAddr MAC address
  WRITEBUFFER[31] := $00 'CHAddr MAC address
  WRITEBUFFER[32] := $00 'CHAddr MAC address
  WRITEBUFFER[33] := $00 'CHAddr MAC address
  BYTEFILL(@WRITEBUFFER + 34, $00, 10) 'CHAddr fill with 0's
  BYTEFILL(@WRITEBUFFER + 44, $00, 64) 'bootp.server fill with 0's
  BYTEFILL(@WRITEBUFFER + 108, $00, 128) 'File fill with 0's
  WRITEBUFFER[236] := $63 'Magic Cookie
  WRITEBUFFER[237] := $82 'Magic Cookie
  WRITEBUFFER[238] := $53 'Magic Cookie
  WRITEBUFFER[239] := $63 'Magic Cookie
  WRITEBUFFER[240] :=  53 'Option 53
  WRITEBUFFER[241] := $01 'Option 53 Length
  WRITEBUFFER[242] := $03 'Option 53 Request Value
  WRITEBUFFER[243] :=  50 'Option 50 ' Requesting this IP
  WRITEBUFFER[244] := $04 'Option 50 Length
  WRITEBUFFER[245] := IPADDRESS[0] 'Option 50 requested IP 1st Octect
  WRITEBUFFER[246] := IPADDRESS[1] 'Option 50 requested IP 2nd Octect
  WRITEBUFFER[247] := IPADDRESS[2] 'Option 50 requested IP 3rd Octect
  WRITEBUFFER[248] := IPADDRESS[3] 'Option 50 requested IP 4th Octect
  WRITEBUFFER[249] := $03 'Option 54 DHCP Server
  WRITEBUFFER[250] := $04 'Option 54 Length
  WRITEBUFFER[251] := DHCPSERVER[0] 'SIAddr DHCP Server IP
  WRITEBUFFER[252] := DHCPSERVER[1] 'SIAddr DHCP Server IP
  WRITEBUFFER[253] := DHCPSERVER[2] 'SIAddr DHCP Server IP
  WRITEBUFFER[254] := DHCPSERVER[3] 'SIAddr DHCP Server IP
  WRITEBUFFER[255] := $FF 'End this shit

  W6100.SendData(W6100.IDM_BSR_Socket0_Register,@WRITEBUFFER,256)

  'clearing readbuffer
  BYTEFILL(@READBUFFER,$00,1024)

  W6100.readreg(W6100.REG_Sn_IR,W6100.IDM_BSR_Socket0_Register,1,@READBUFFER)
  debug("Checking Sn_IR Socket Status: ", uhex_(READBUFFER[0]))

  repeat until READBUFFER[12] == RequestID[0] && READBUFFER[13] == RequestID[1] && READBUFFER[14] == RequestID[2] && READBUFFER[15] == RequestID[3]
     repeat until W6100.ReceiveData(W6100.IDM_BSR_Socket0_Register,1) == 0
     psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket0_Register,@READBUFFER)

    debug("Received XID is: ", uhex_(READBUFFER[12]),":",uhex_(READBUFFER[13]),":",uhex_(READBUFFER[14]),":",uhex_(READBUFFER[15]))

  i:=248
  repeat until i >= psize || READBUFFER[i] == $FF
    case READBUFFER[i]
      53  :  debug("DHCP Message Type: ",udec_(READBUFFER[i+2]) )
             DHCPMESSAGETYPE := READBUFFER[i+2]

             i := i + 3
      54  :  debug("DHCP Server: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))

               DHCPSERVER[0] := READBUFFER[i+2]
               DHCPSERVER[1] := READBUFFER[i+3]
               DHCPSERVER[2] := READBUFFER[i+4]
               DHCPSERVER[3] := READBUFFER[i+5]
               i := i + 6

      1 : debug("DHCP Subnet Mask: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))

               SUBNETMASK[0] := READBUFFER[i+2]
               SUBNETMASK[1] := READBUFFER[i+3]
               SUBNETMASK[2] := READBUFFER[i+4]
               SUBNETMASK[3] := READBUFFER[i+5]
               i := i + 6
      3 : debug("DHCP Gateway: ", udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))

               GATEWAY[0] := READBUFFER[i+2]
               GATEWAY[1] := READBUFFER[i+3]
               GATEWAY[2] := READBUFFER[i+4]
               GATEWAY[3] := READBUFFER[i+5]
               i := i + 6
      6 :
               debug("DNS Server: " , udec_(READBUFFER[i+2]),".",udec_(READBUFFER[i+3]),".",udec_(READBUFFER[i+4]),".",udec_(READBUFFER[i+5]))
               DNS[0] := READBUFFER[i+2]
               DNS[1] := READBUFFER[i+3]
               DNS[2] := READBUFFER[i+4]
               DNS[3] := READBUFFER[i+5]
               i := i + 6

      $ff : debug("Detected end of DHCP Options.")

      OTHER : debug("DHCP Option Unknown: ", udec_(READBUFFER[i]), " Incrementing ", udec_(READBUFFER[i+1] + 2))
               i++
               i := i + READBUFFER[i]
               i++


  if DHCPMESSAGETYPE <> 5
    debug("DHCP Messagetype: ", udec_(DHCPMESSAGETYPE))

    debug("DHCP Failure")
    abort





pub str2dec(p_str, len) : value |  ch

'' Convert string at p_str to decimal value
'' -- max length is len characters

  value := 0                                                     ' initialize result

  repeat len
    ch := byte[p_str++]                                          ' get a character
    if ((ch >= "0") and (ch <= "9"))                             ' valid digit?
      value := (value * 10) + (ch - "0")                         ' ASCII --> decimal
    else
      quit

  return
pub inbin(p_haystack, p_needle, slen) : pos | len1, len2, idx

'' Returns position of p_needle in str1
'' -- p_haystack is pointer to string to search
'' -- p_needle is pointer to string to look for in p_haystack
'' -- if p_needle not in p_haystack returns -1

  pos  := -1

  len1 := slen
  len2 := strsize(p_needle)
  idx  := 0

  if (len1 >= len2)
    repeat (len1 - len2 + 1)
      if idx == slen
        quit
      else
        if (str.strncmp(p_haystack++, p_needle, len2) == 0)
          pos := idx
          quit
        else
          ++idx
pub startpixels()
  WS2811.start_2812b(PIXELCONFIG[3], PIXELCONFIG[1],PIXELCONFIG[8], PIXELCONFIG[6],PIXELCONFIG[13], PIXELCONFIG[11],PIXELCONFIG[18], PIXELCONFIG[16],PIXELCONFIG[23], PIXELCONFIG[21],PIXELCONFIG[28], PIXELCONFIG[26],PIXELCONFIG[33], PIXELCONFIG[31],PIXELCONFIG[38], PIXELCONFIG[36],pixelcnt(PIXELCONFIG[0]),PIXELCONFIG[0] - 1, PIXELCONFIG[2],Brightness)
  WS28112.start_2812b(PIXELCONFIG[43], PIXELCONFIG[41],PIXELCONFIG[48],PIXELCONFIG[46],PIXELCONFIG[53], PIXELCONFIG[51],PIXELCONFIG[58], PIXELCONFIG[56],PIXELCONFIG[63], PIXELCONFIG[61],PIXELCONFIG[68], PIXELCONFIG[66],PIXELCONFIG[73], PIXELCONFIG[71],PIXELCONFIG[78], PIXELCONFIG[76],pixelcnt(PIXELCONFIG[40]),PIXELCONFIG[40] - 1, PIXELCONFIG[42],Brightness)
  WS28113.start_2812b(PIXELCONFIG[83], PIXELCONFIG[81],PIXELCONFIG[88],PIXELCONFIG[86],PIXELCONFIG[93], PIXELCONFIG[91],PIXELCONFIG[98], PIXELCONFIG[96],PIXELCONFIG[103], PIXELCONFIG[101],PIXELCONFIG[108], PIXELCONFIG[106],PIXELCONFIG[113], PIXELCONFIG[111],PIXELCONFIG[118], PIXELCONFIG[116],pixelcnt(PIXELCONFIG[80]),PIXELCONFIG[80] + 15, PIXELCONFIG[82],Brightness)
  DMX.start(44, 45, 46, 47, -1, dmxbufferaddr(), dmxbufferaddr() + 510 , dmxbufferaddr() + 1020, dmxbufferaddr()+ 1530)

pub stoppixels()
  WS2811.stop()
  WS28112.stop()
  WS28113.stop()
  DMX.stop()
pub pixelcnt(pingroup) : pixelct | index
  pingroup := pingroup - 1 'This is so that we can pass what is configured in the data structure in pixelconfig.
  index := pingroup * 5
  pixelct := 0
  repeat 8
    if PIXELCONFIG[index + 4] >=  pixelct
      pixelct := PIXELCONFIG[index + 4]
    index := index + 5
  return pixelct
pub dmxbufferaddr() : dmxbuffer | ei
   ei := 0
   repeat until E131CONFIG[ei] == 0
      if E131CONFIG[ei] == 25
        debug(udec(E131CONFIG[ei+3]))
        return E131CONFIG[ei+3]
      ei := ei + 4
   return -1
pub dnsresolver(hostname) : rv | i, l
  debug("Configuring Protocol Mode UDP on Socket 0", $0D, $0A)
  W6100.Open(53,W6100.PM_UDP4,W6100.IDM_BSR_Socket0_Register)
  ' Set Destination IP
  WRITEBUFFER[0] := DNS[0]
  WRITEBUFFER[1] := DNS[1]
  WRITEBUFFER[2] := DNS[2]
  WRITEBUFFER[3] := DNS[3]
  W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket0_Register,4,@WRITEBUFFER)

  ' Set Destination port
  WRITEBUFFER[0] := 00
  WRITEBUFFER[1] := 53
  W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket0_Register,2,@WRITEBUFFER)

  ' Transaction ID
  RequestID[0] := prng.xrandomize($00,$FF)
  RequestID[1] := prng.xrandomize($00,$FF)

  ' Construct Request
  ' Set Transaction ID
  WRITEBUFFER[0] := RequestID[0]
  WRITEBUFFER[1] := RequestID[1]
  ' Set Query (1 bit), Opcode (4 bits) , Authoratative Answer (1 bit), Truncation (1 bit), Recursion Desired (1 bit)
  WRITEBUFFER[2] := %%1_0000_0_0_1
  ' Set Recursion Available (1 bit), Reserved (3 bits), Response Code (4 bits)
  WRITEBUFFER[3] := %%0_000_0000
  ' Set Query Count
  WRITEBUFFER[4] := 0
  WRITEBUFFER[5] := 1
  ' Set Answer Count
  WRITEBUFFER[6] := 0
  WRITEBUFFER[7] := 0
  ' Set Name Server Resource Record Count
  WRITEBUFFER[8] := 0
  WRITEBUFFER[9] := 0
  'Set Number of Resource Records in the Additional Records Section
  WRITEBUFFER[10] := 0
  WRITEBUFFER[11] := 0
  ' Set question
  i := 12
  repeat until l == -1
    l := str.instr(hostname+i-12,dot)
    debug(zstr(hostname+i-12))
    debug(udec(l))
    if l <> -1
      WRITEBUFFER[i] := l
      str.mid(@WRITEBUFFER+i+1, hostname, i-12,l)
      i := i + l + 1

  WRITEBUFFER[i] := strsize(hostname) - str.last(hostname, ".") - 1
  str.mid(@WRITEBUFFER+i+1, hostname, i-12,WRITEBUFFER[i])
  i := i + WRITEBUFFER[i] + 2
  ' Set Query Type
  WRITEBUFFER[i] := 0
  WRITEBUFFER[i+1] := 1   ' $0001 is for A records
  ' Set Query Class
  WRITEBUFFER[i+2] := 0
  WRITEBUFFER[i+3] := 1   ' $0001 is IN for Internet

  'Send Query
  W6100.SendData(W6100.IDM_BSR_Socket0_Register,@WRITEBUFFER,i+4)

  'clearing readbuffer
  BYTEFILL(@READBUFFER,$00,1024)

  W6100.readreg(W6100.REG_Sn_IR,W6100.IDM_BSR_Socket0_Register,1,@READBUFFER)
  debug("Checking Sn_IR Socket Status: ", uhex_(READBUFFER[0]))

  repeat until READBUFFER[8] == RequestID[0] && READBUFFER[9] == RequestID[1]
     ' Set timeout to 5 seconds
     l := GETSEC() + 5
     repeat until W6100.ReceiveData(W6100.IDM_BSR_Socket0_Register,1) == 0
      if GETSEC() >= l
         debug("DNS Server timed out.")
         return -1

     psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket0_Register,@READBUFFER)

     debug("Received XID is: ", uhex_(READBUFFER[8]),":",uhex_(READBUFFER[9]))
  if READBUFFER[10] == $81 && READBUFFER[11] == $80
     i := 20
     debug("Name Resolved")
     repeat until READBUFFER[i] == 0
        debug("Question length ", uhex_(READBUFFER[i]))
        i := i + READBUFFER[i] + 1
     'Jump ahead to Answer Type
     i := i + 7
     debug("Answer Type", uhex_(READBUFFER[i]),uhex_(READBUFFER[i+1]))
     debug("Resolves as ", udec_(READBUFFER[psize-4]),".",udec_(READBUFFER[psize-3]),".",udec_(READBUFFER[psize-2]),".",udec_(READBUFFER[psize-1]))
     SERVERIP[0] := READBUFFER[psize-4]
     SERVERIP[1] := READBUFFER[psize-3]
     SERVERIP[2] := READBUFFER[psize-2]
     SERVERIP[3] := READBUFFER[psize-1]
     return @SERVERIP
  else
     debug("Name did not resolve")
     return -1
pub upgradejs()| dns_ptr, gur
    ' Zero out buffers
    webbuff[0] := 0

    ' send header
    str.append_str(@webbuff,resp_ptr)
    str.append_str(@webbuff, string($0D, $0A, "var div = document.getElementById('main');"))

    gur := getURL(string("/firmware/Blitzen24/upgrade.txt"),upgradeserver_ptr)

    if gur == -2
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Cant resolve "))
        str.append_str(@webbuff,@servername)
        str.append_str(@webbuff, string("';"))
        rdsize := strsize(@webbuff)
        return

   if gur == -1
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Cant connect to "))
        str.append_str(@webbuff,@servername)
        str.append_str(@webbuff, string("';"))
        rdsize := strsize(@webbuff)
        return

   if gur == -4
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Unexpected response from  "))
        str.append_str(@webbuff,@servername)
        str.append_str(@webbuff, string("';"))
        rdsize := strsize(@webbuff)
        return

   if gur == -5
        str.append_str(@webbuff, string($0D, $0A, "div.textContent = 'Not an HTTP response from  "))
        str.append_str(@webbuff,@servername)
        str.append_str(@webbuff, string("';"))
        rdsize := strsize(@webbuff)
        return
   str.append_str(@webbuff, string("str = `<font size=+1>Manifest file contents</font><br><br><pre>"))
   str.append_str(@webbuff,@READBUFFER + 4 + str.instr(@READBUFFER,string($0D, $0A, $0D, $0A)))
   str.append_str(@webbuff, string("</pre>`;"))
   str.append_str(@webbuff, string($0D, $0A, "div.insertAdjacentHTML('afterbegin', str);"))

   rdsize := strsize(@webbuff)
   W6100.Disconnect(W6100.IDM_BSR_Socket6_Register)
pub getURL(path,svr) : rt | dns_ptr
{
Return codes
-1 : Can't connect
-2 : Does not resolve
-3 : Timed Out
-4 : Unexpected response upon connect
-5 : Not an HTTP reponse

Otherwise, return HTTP Status code.

}
    servername[0] := 0
    str.append_str(@servername,svr)
    dns_ptr := dnsresolver(@servername)
    if dns_ptr == -1
      return(-2)
    W6100.Open(80,W6100.PM_TCP4,W6100.IDM_BSR_Socket6_Register)

   ' Set Destination IP
    WRITEBUFFER[0] := SERVERIP[0]
    WRITEBUFFER[1] := SERVERIP[1]
    WRITEBUFFER[2] := SERVERIP[2]
    WRITEBUFFER[3] := SERVERIP[3]

    W6100.writereg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@WRITEBUFFER)

    ' Set Destination port
    WRITEBUFFER[0] := 00
    WRITEBUFFER[1] := 80
    W6100.writereg(W6100.REG_Sn_DPORTR,W6100.IDM_BSR_Socket6_Register,2,@WRITEBUFFER)


    W6100.ConnectTCP(W6100.IDM_BSR_Socket6_Register)

    if (W6100.EstablishTCP(W6100.IDM_BSR_Socket6_Register) <> W6100.Sn_IR_TIMEOUT)
        W6100.readreg(W6100.REG_Sn_DIPR,W6100.IDM_BSR_Socket6_Register,4,@READBUFFER)
        debug("Connection Established to ", udec_(READBUFFER[0]),".",udec_(READBUFFER[1]),".",udec_(READBUFFER[2]),".",udec_(READBUFFER[3]))
    else
        return(-1)

    debug("Checking Sn_RX_RSR Socket Status/number of bytes in buffer: ")

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,10000) <> W6100.Sn_IR_TIMEOUT)
        psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
        READBUFFER[psize] := 0
        debug("Unexpected response of ",udec_(psize)," Bytes.")
        debug("Received: ",zstr_(@READBUFFER))
        return(-4)

    WRITEBUFFER[0] := 0
    str.append_str(@WRITEBUFFER,string("GET "))
    str.append_str(@WRITEBUFFER,path)
    debug("Path: ",zstr_(path))
    str.append_str(@WRITEBUFFER,string(" HTTP/1.1", $0D, $0A, "Host: "))
    str.append_str(@WRITEBUFFER,@servername)
    str.append_str(@WRITEBUFFER,string($0D, $0A, $0D, $0A))
    W6100.SendData(W6100.IDM_BSR_Socket6_Register,@WRITEBUFFER,strsize(@WRITEBUFFER))

    If ( W6100.ReceiveData(W6100.IDM_BSR_Socket6_Register,10000) <> W6100.Sn_IR_TIMEOUT)
 '     W6100.ReceiveData(socket,100000)
        psize := W6100.ReceiveProcess(W6100.IDM_BSR_Socket6_Register,@READBUFFER)
        READBUFFER[psize] := 0
        debug("Received: ",zstr_(@READBUFFER))
    else
        return(-3)