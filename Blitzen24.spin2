  ' Clear residual interrupts on all HTTP sockets from previous boot
  WRITEBUFFER[0] := $FF
  W6100.writereg(W6100.REG_Sn_IRCLR,W6100.IDM_BSR_Socket1_Register,1,@WRITEBUFFER)
  W6100.writereg(W6100.REG_Sn_IRCLR,W6100.IDM_BSR_Socket2_Register,1,@WRITEBUFFER)
  W6100.writereg(W6100.REG_Sn_IRCLR,W6100.IDM_BSR_Socket4_Register,1,@WRITEBUFFER)
  W6100.writereg(W6100.REG_Sn_IRCLR,W6100.IDM_BSR_Socket5_Register,1,@WRITEBUFFER)
  W6100.writereg(W6100.REG_Sn_IRCLR,W6100.IDM_BSR_Socket7_Register,1,@WRITEBUFFER)

