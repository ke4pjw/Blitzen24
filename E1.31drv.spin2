CON


VAR
  long E131stack[128]
  long E131cog
  byte PACKETBUFFER[2048]
  word psize
OBJ
        W6100: "W6100drv"

pub start(sendptr) : result
  send("Starting E131cog")
 ' stop()
  E131cog := cogspin(NEWCOG, mymain(5568,W6100.PM_UDP4,W6100.IDM_BSR_Socket3_Register,sendptr), @E131stack) + 1
  return E131cog

pub stop()

  if (E131cog)                                            ' return lock to pool
    cogstop(E131cog-1)
    E131cog := 0


pub mymain(port,protocol,socket,sendptr)
    send("Listening for E1.31 packets on port 5568")
    W6100.Open(port,protocol,socket)
    send := sendptr

    repeat
      receive(@PACKETBUFFER,socket)


PUB receive(bufferptr,socket) | i , lpsize
    repeat until W6100.ReceiveData(socket,1) == 0
    lpsize := W6100.ReceiveProcess(socket,bufferptr)
'    hex(PACKETBUFFER[132],2)
'    i := 52
'    repeat until i > 64+52 || PACKETBUFFER[i] == 0
'       send(PACKETBUFFER[i])
'       i++
    'Send( $0D, $0A, "Universe: ")
    'hex(PACKETBUFFER[121],2)
    'hex(PACKETBUFFER[122],2)
     if PACKETBUFFER[122] == 4
        Send("Got it!")
   ' hex(PACKETBUFFER[135],2)
   ' hex(PACKETBUFFER[136],2)

'    send( $0D, $0A,"-----end-----", $0D, $0A)
    'send("Received E1.31 packet")


PUB hex(value, digits)
' Print a hexadecimal number
  value <<= (8 - digits) << 2
  repeat digits
    value ROL= 4
    send(lookupz(value & $F : "0".."9", "A".."F"))

DAT
name    byte  "string_data",0
